---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import settings from '../data/settings.json';
import { VAT_NOTE, QUOTE_VALID_DAYS, ROUND1_RATIO, types, options, included, terms } from '../data/pricing-data';

// Partner discount by region — applied to the whole quote total.
// Chiang Mai partners: 20% off · Bangkok partners: 10% off.
const PARTNER_DISCOUNTS = { cm: 0.20, bkk: 0.10 };
---
<BaseLayout
  title="ใบเสนอราคาพันธมิตร (ภายใน) | WHAT THE HOUSE"
  description="เครื่องมือออกใบเสนอราคาราคาพันธมิตรสำหรับพาร์ทเนอร์ WHAT THE HOUSE"
  noindex={true}
>
  <Header />
  <main>

    <!-- ============ PAGE HERO ============ -->
    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/">หน้าแรก</a> / <span class="lang-th">ราคาพันธมิตร</span><span class="lang-en">Partner</span></p>
        <span class="eyebrow"><span class="lang-th">สำหรับพันธมิตรเท่านั้น</span><span class="lang-en">Partners only</span></span>
        <h1><span class="lang-th">ใบเสนอราคาพันธมิตร</span><span class="lang-en">Partner Quotation</span></h1>
        <p><span class="lang-th">คำนวณราคาพันธมิตร (ลดจากราคาปกติตามพื้นที่) และดาวน์โหลดใบเสนอราคา PDF ได้ทันที</span><span class="lang-en block">Calculate partner pricing (discounted from the standard rate by region) and download a PDF quotation instantly.</span></p>
      </div>
    </section>

    <!-- ============ CALCULATOR ============ -->
    <section class="section">
      <div class="container">
        <div class="calc-wrap">
          <div class="calc-box">
            <div class="partner-banner">
              <b><span class="lang-th">โหมดพันธมิตร (Partner)</span><span class="lang-en">Partner mode</span></b>
              <span class="lang-th">ราคาบนหน้านี้เป็นราคาพันธมิตร ลดจากราคาปกติตามพื้นที่ · หน้านี้เป็นลิงก์ภายใน ไม่เผยแพร่ทั่วไป</span>
              <span class="lang-en block">Prices here are partner rates, discounted by region · this is a private internal link, not listed publicly.</span>
            </div>

            <h2 class="calc-title"><span class="lang-th">คำนวณราคาและออกใบเสนอราคา</span><span class="lang-en">Calculate & get a quotation</span></h2>
            <p class="calc-sub"><span class="lang-th">เลือกประเภททรัพย์ กรอกพื้นที่ใช้สอย เลือกเงื่อนไข แล้วเลือกพื้นที่พันธมิตร</span><span class="lang-en block">Pick the property type, enter the area, tick any conditions, then choose the partner region.</span></p>

            <!-- 1. type -->
            <div class="calc-step">
              <label class="calc-label"><span class="lang-th">1. ประเภททรัพย์สิน</span><span class="lang-en">1. Property type</span></label>
              <div class="type-btns">
                {types.map((t) => (
                  <button type="button" class="type-btn" data-type={t.id}>
                    <span set:html={t.icon} />
                    <span class="lang-th">{t.th}</span><span class="lang-en">{t.en}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- 2. package -->
            <div class="calc-step">
              <label class="calc-label"><span class="lang-th">2. แพ็กเกจการตรวจ</span><span class="lang-en">2. Inspection package</span></label>
              <div class="area-btns">
                <label class="area-radio pkg-radio">
                  <input type="radio" name="pkg" value="two" checked />
                  <span>
                    <b><span class="lang-th">ตรวจ 2 รอบ</span><span class="lang-en">2 rounds</span></b>
                    <span class="pkg-tag"><span class="lang-th">แนะนำ</span><span class="lang-en">Recommended</span></span>
                    <span class="pkg-desc"><small class="lang-th">ตรวจครั้งแรก + กลับมาตรวจรอบแก้ไขอีก 1 ครั้ง</small><small class="lang-en">First inspection + one follow-up re-inspection</small></span>
                  </span>
                </label>
                <label class="area-radio pkg-radio">
                  <input type="radio" name="pkg" value="one" />
                  <span>
                    <b><span class="lang-th">ตรวจรอบเดียว</span><span class="lang-en">Single round</span></b>
                    <span class="pkg-desc"><small class="lang-th">ตรวจครั้งเดียวพร้อมรายงาน เหมาะกับงบจำกัด บ้านมือสอง หรือต้องการความเห็นครั้งเดียว</small><small class="lang-en">One inspection with report — for tighter budgets, second-hand homes, or a one-off opinion</small></span>
                  </span>
                </label>
              </div>
            </div>

            <!-- 3. area -->
            <div class="calc-step">
              <label class="calc-label" for="calcArea"><span class="lang-th">3. พื้นที่ใช้สอย (ตร.ม.)</span><span class="lang-en">3. Usable area (sq.m.)</span></label>
              <div class="area-input-wrap">
                <input type="number" id="calcArea" class="area-input" placeholder="เช่น 120" min="1" max="3000" />
                <span class="area-unit">ตร.ม. / sq.m.</span>
              </div>
            </div>

            <!-- 4. options — hidden until a property type is chosen -->
            <div class="calc-step" id="optStep" hidden>
              <label class="calc-label"><span class="lang-th">4. เงื่อนไขเพิ่มเติม (ถ้ามี)</span><span class="lang-en">4. Additional conditions (if any)</span></label>
              <div class="opt-list" id="optList">
                {options.map((o) => (
                  <label class="opt" data-opt={o.id} data-for={o.for.join(',')} hidden>
                    <input type="checkbox" value={o.id} />
                    <span class="opt-txt"><span class="lang-th">{o.th}</span><span class="lang-en">{o.en}</span></span>
                    <span class="opt-price">
                      {o.quote ? <span><span class="lang-th">ประเมินราคา</span><span class="lang-en">Quote</span></span>
                        : o.pct ? `+${Math.round(o.pct * 100)}%`
                        : `+${o.add?.toLocaleString()} ฿`}
                    </span>
                  </label>
                ))}
              </div>
            </div>

            <!-- 5. partner region → discount -->
            <div class="calc-step">
              <label class="calc-label"><span class="lang-th">5. พื้นที่พันธมิตร</span><span class="lang-en">5. Partner region</span></label>
              <div class="area-btns">
                <label class="area-radio">
                  <input type="radio" name="location" value="cm" checked />
                  <span>
                    <span class="lang-th">เชียงใหม่</span><span class="lang-en">Chiang Mai</span>
                    <small class="lang-th"> (ส่วนลดพันธมิตร 20%)</small><small class="lang-en"> (20% partner discount)</small>
                  </span>
                </label>
                <label class="area-radio">
                  <input type="radio" name="location" value="bkk" />
                  <span>
                    <span class="lang-th">กรุงเทพฯ</span><span class="lang-en">Bangkok</span>
                    <small class="lang-th"> (ส่วนลดพันธมิตร 10%)</small><small class="lang-en"> (10% partner discount)</small>
                  </span>
                </label>
              </div>
            </div>

            <!-- result -->
            <div class="calc-result">
              <div class="result-inner">
                <div class="result-label"><span class="lang-th">ราคาพันธมิตร (สุทธิ)</span><span class="lang-en">Partner price (net)</span></div>
                <div class="result-price" id="resultPrice">—</div>
                <div class="result-note" id="resultNote"></div>
              </div>
            </div>
            <ul class="bd-list" id="breakdown"></ul>

            <!-- quotation details -->
            <div class="quote-form" id="quoteForm">
              <p class="qf-title"><span class="lang-th">ออกใบเสนอราคาพันธมิตร</span><span class="lang-en">Issue a partner quotation</span></p>
              <p class="qf-note"><span class="lang-th">กรุณากรอกชื่อลูกค้า/พันธมิตร และโครงการ · ข้อมูลติดต่อกลับไม่บังคับ กรอกเฉพาะเมื่อต้องการให้เราติดต่อกลับ</span><span class="lang-en block">Please provide the customer/partner name and project · contact detail is optional — fill it in only if you'd like us to follow up.</span></p>
              <div class="form-row">
                <div class="field">
                  <label for="qName"><span class="lang-th">ชื่อลูกค้า / พันธมิตร</span><span class="lang-en">Customer / partner name</span> <i class="req">*</i></label>
                  <input type="text" id="qName" placeholder="ชื่อ-นามสกุล / บริษัท" />
                </div>
                <div class="field">
                  <label for="qPhone"><span class="lang-th">ข้อมูลติดต่อกลับ (ไม่บังคับ)</span><span class="lang-en">Contact detail (optional)</span></label>
                  <input type="text" id="qPhone" placeholder="เบอร์โทร / LINE ID / อีเมล" />
                </div>
              </div>
              <div class="field">
                <label for="qProject"><span class="lang-th">โครงการ / ที่อยู่ทรัพย์สิน</span><span class="lang-en">Project / property address</span> <i class="req">*</i></label>
                <input type="text" id="qProject" placeholder="ชื่อโครงการ บ้านเลขที่ หรือเลขห้อง" />
              </div>
              <p class="qf-error" id="qfError" hidden><span class="lang-th">กรุณาเลือกประเภททรัพย์ กรอกพื้นที่ ชื่อลูกค้า/พันธมิตร และโครงการ ก่อนออกใบเสนอราคา</span><span class="lang-en block">Please choose a property type, enter the area, and fill in the customer/partner name and project before issuing a quotation.</span></p>
              <div class="qf-actions">
                <button type="button" class="btn btn-primary btn-lg" id="btnQuote">
                  <svg viewBox="0 0 24 24" width="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                  <span class="lang-th">ดาวน์โหลดใบเสนอราคาพันธมิตร (PDF)</span><span class="lang-en">Download partner quotation (PDF)</span>
                </button>
              </div>
              <p class="qf-hint"><span class="lang-th">ระบบจะเปิดหน้าต่างพิมพ์ — เลือก "บันทึกเป็น PDF" เพื่อดาวน์โหลดใบเสนอราคา</span><span class="lang-en block">A print dialog opens — choose "Save as PDF" to download the quotation.</span></p>
            </div>
          </div>

          <!-- notes side -->
          <aside class="calc-notes">
            <h3><span class="lang-th">ราคานี้รวมอะไรบ้าง</span><span class="lang-en">What's included</span></h3>
            <ul class="note-list">
              {included.th.map((t, i) => (
                <li><span class="nc">✓</span><span><span class="lang-th">{t}</span><span class="lang-en block">{included.en[i]}</span></span></li>
              ))}
            </ul>
            <div class="btu-tip">
              <a href="/sample-report"><span class="lang-th">ดูตัวอย่างรายงาน →</span><span class="lang-en">See a sample report →</span></a>
            </div>
          </aside>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <!-- ============ QUOTATION DOCUMENT (print only) ============ -->
  <div id="quoteDoc" class="quote-doc" data-lang="th" aria-hidden="true">
    <div class="qd-printbar">
      <span class="qd-pb-title" id="qdPrintedTitle"></span>
      <span class="qd-pb-time" id="qdPrinted"></span>
    </div>
    <div class="qd-top">
      <div class="qd-brand">
        <img src="/assets/img/wth-shield.png" alt="" width="44" height="47" />
        <div><b>WHAT THE HOUSE</b><span>HOME INSPECTIONS</span><span class="qd-slogan">BETTER HOMES • BETTER LIVING</span></div>
      </div>
      <div class="qd-meta">
        <div class="qd-title">ใบเสนอราคา / QUOTATION</div>
        <div class="qd-partner-badge"><span class="qd-th">ราคาพันธมิตร</span><span class="qd-en">PARTNER RATE</span></div>
        <div>เลขที่ / No.: <b id="qdNo"></b></div>
        <div>วันที่ / Date: <b id="qdDate"></b></div>
        <div>ยืนราคาถึง / Valid until: <b id="qdValid"></b></div>
      </div>
    </div>

    <div class="qd-parties">
      <div>
        <h4>ผู้เสนอราคา / From</h4>
        <p>WHAT THE HOUSE – Home Inspections<br />
          โทร. {settings.phoneDisplay}<br />
          {settings.email}</p>
      </div>
      <div>
        <h4>เสนอต่อ / To</h4>
        <p><b id="qdCustomer">—</b><br />
          <span id="qdPhone"></span><br />
          <span id="qdProject"></span></p>
      </div>
    </div>

    <table class="qd-table">
      <thead>
        <tr><th>รายการ / Description</th><th class="qd-right">จำนวนเงิน / Amount</th></tr>
      </thead>
      <tbody id="qdItems"></tbody>
      <tfoot>
        <tr><td class="qd-total-label">ราคาสุทธิพันธมิตร / Partner net total</td><td class="qd-right qd-total" id="qdTotal">—</td></tr>
      </tfoot>
    </table>

    <p class="qd-vat" id="qdVat"></p>

    <div class="qd-cols">
      <div>
        <h4>ขอบเขตที่รวมในราคา / Included</h4>
        <ul class="qd-th">{included.th.map((t) => <li>{t}</li>)}</ul>
        <ul class="qd-en">{included.en.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div>
        <h4>เงื่อนไข / Terms</h4>
        <ol class="qd-th">{terms.th.map((t) => <li>{t}</li>)}</ol>
        <ol class="qd-en">{terms.en.map((t) => <li>{t}</li>)}</ol>
      </div>
    </div>

    <div class="qd-sign">
      <span class="qd-signline"></span>
      <div class="qd-sign-caps">
        <span>ผู้เสนอราคา / Authorised signature</span>
        <span>ผู้อนุมัติ / Customer acceptance</span>
      </div>
    </div>

    <div class="qd-contact">
      <img src="/assets/img/line-qr.png" alt="LINE QR" width="72" height="72" />
      <div>
        <b class="qd-th">ติดต่อ / นัดหมายทาง LINE</b><b class="qd-en">Contact / book via LINE</b>
        <span class="qd-th">สแกน QR เพื่อแอดไลน์ WHAT THE HOUSE</span><span class="qd-en">Scan the QR to add WHAT THE HOUSE on LINE</span>
      </div>
    </div>
    <p class="qd-foot qd-th">เอกสารนี้เป็นการประเมินราคาเบื้องต้นจากข้อมูลที่ให้ไว้ · ราคาพันธมิตรสำหรับพาร์ทเนอร์เท่านั้น · whatthehouse.net</p>
    <p class="qd-foot qd-en">This is a preliminary estimate based on the information provided · partner rate for partners only · whatthehouse.net</p>
  </div>
</BaseLayout>

<style>
[hidden] { display: none !important; }

/* partner banner */
.partner-banner { background: var(--green-soft); border: 1px solid rgba(47,224,124,.35); border-radius: var(--radius-sm); padding: 14px 16px; margin-bottom: 24px; font-size: .86rem; line-height: 1.55; color: var(--body); }
.partner-banner b { display: block; color: var(--green-bright); margin-bottom: 3px; }

/* ── type buttons ── */
.type-btns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.type-btn {
  display: flex; flex-direction: column; align-items: center; gap: 7px;
  padding: 15px 8px; border: 2px solid var(--line); border-radius: var(--radius-sm);
  background: var(--panel-2); cursor: pointer; font-size: .84rem; font-family: inherit;
  font-weight: 500; color: var(--grey); transition: .2s; text-align: center; line-height: 1.3;
}
.type-btn :global(svg) { color: var(--grey); transition: .2s; }
.type-btn:hover { border-color: var(--green); color: var(--green-bright); }
.type-btn:hover :global(svg) { color: var(--green-bright); }
.type-btn.active { border-color: var(--green); background: var(--green-soft); color: var(--green-bright); font-weight: 600; }
.type-btn.active :global(svg) { color: var(--green-bright); }

/* ── options ── */
.opt-list { display: flex; flex-direction: column; gap: 8px; }
.opt {
  display: flex; align-items: center; gap: 11px; cursor: pointer;
  border: 1.5px solid var(--line-2); border-radius: var(--radius-sm);
  padding: 11px 14px; background: var(--panel-2); transition: .15s; font-size: .9rem;
}
.opt:hover { border-color: var(--green); }
.opt:has(input:checked) { border-color: var(--green); background: var(--green-soft); }
.opt input { accent-color: var(--green); margin: 0; flex: none; }
.opt-txt { flex: 1; color: var(--body); }
.opt-price { font-family: var(--mono); font-size: .82rem; color: var(--green-bright); white-space: nowrap; }

/* ── location / region radios ── */
.area-btns { display: flex; flex-direction: column; gap: 10px; }
.area-radio {
  display: flex; align-items: flex-start; gap: 10px; cursor: pointer;
  padding: 12px 14px; border: 2px solid var(--line); border-radius: var(--radius-sm);
  background: var(--panel-2); transition: .15s; font-size: .92rem;
}
.area-radio:has(input:checked) { border-color: var(--green); background: var(--green-soft); }
.area-radio input { margin-top: 3px; accent-color: var(--green); }
.area-radio small { color: var(--grey); font-size: .82rem; }

/* ── breakdown ── */
.bd-list { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 7px; }
.bd-list li { display: flex; justify-content: space-between; gap: 14px; font-size: .89rem; color: var(--grey); border-bottom: 1px dashed var(--line); padding-bottom: 7px; }
.bd-list li b { color: var(--heading); font-family: var(--mono); white-space: nowrap; }
.bd-list li.bd-discount b { color: var(--green-bright); }
.bd-list li.bd-net { border-bottom: 0; }
.bd-list li.bd-net span, .bd-list li.bd-net b { color: var(--heading); font-weight: 700; font-size: .98rem; }

/* package radios */
.pkg-radio b { color: var(--heading); font-weight: 700; }
.pkg-tag { display: inline-block; margin-left: 8px; font-family: var(--mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: var(--green-bright); border: 1px solid rgba(47,224,124,.35); border-radius: 50px; padding: 2px 8px; vertical-align: middle; }
.pkg-desc { display: block; margin-top: 3px; }

/* ── quote form ── */
.quote-form { margin-top: 26px; border-top: 1px solid var(--line); padding-top: 22px; }
.qf-title { font-weight: 700; color: var(--heading); margin: 0 0 6px; font-size: .95rem; }
.qf-note { color: var(--grey); font-size: .82rem; line-height: 1.55; margin: 0 0 14px; }
.quote-form .field label { font-family: var(--font); font-size: .85rem; letter-spacing: 0; text-transform: none; font-weight: 500; color: var(--heading); }
.qf-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
.qf-actions .btn { flex: 1; justify-content: center; min-width: 200px; }
.qf-hint { color: var(--faint); font-size: .8rem; margin: 12px 0 0; }
.qf-error { margin: 14px 0 0; padding: 11px 14px; border-radius: var(--radius-sm); background: rgba(229,72,77,.08); border: 1px solid rgba(229,72,77,.35); color: #E5484D; font-size: .86rem; line-height: 1.6; }
.quote-form .req { color: #E5484D; font-style: normal; }
.field.invalid input { border-color: #E5484D; }

@media (max-width: 980px) {
  .calc-wrap { grid-template-columns: 1fr; }
  .calc-notes { order: -1; }
}
@media (max-width: 720px) {
  .type-btns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .calc-box { padding: 24px 18px; }
  .qf-actions .btn { min-width: 0; }
}

/* ── quotation document: hidden on screen, shown when printing ── */
.quote-doc { display: none; }
</style>

<style is:global>
  /* The quotation is a light A4 document — only rendered for print. */
  @media print {
    body > *:not(#quoteDoc) { display: none !important; }
    #quoteDoc { display: block !important; padding: 14mm; }
    @page { size: A4; margin: 0; }
    html, body { background: #fff !important; }
  }
  #quoteDoc {
    background: #fff; color: #16181a; font-size: 11.5px; line-height: 1.55;
  }
  #quoteDoc .qd-printbar { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; font-size: 8.5px; color: #8a908a; margin-bottom: 10px; }
  #quoteDoc .qd-pb-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #quoteDoc .qd-pb-time { flex-shrink: 0; }
  #quoteDoc h4 { font-size: 11.5px; margin: 0 0 5px; color: #16181a; }
  #quoteDoc p { margin: 0; }
  #quoteDoc .qd-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; border-bottom: 2px solid #16181a; padding-bottom: 12px; }
  #quoteDoc .qd-brand { display: flex; align-items: center; gap: 10px; }
  #quoteDoc .qd-brand img { display: block; }
  #quoteDoc .qd-brand b { display: block; font-size: 15px; letter-spacing: .01em; }
  #quoteDoc .qd-brand span { display: block; font-size: 8.5px; letter-spacing: .18em; color: #5a625c; }
  #quoteDoc .qd-slogan { margin-top: 2px; letter-spacing: .1em !important; color: #157a42 !important; font-weight: 600; }
  #quoteDoc .qd-meta { text-align: right; }
  #quoteDoc .qd-title { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
  #quoteDoc .qd-partner-badge { display: inline-block; margin-bottom: 6px; font-size: 9px; font-weight: 700; letter-spacing: .08em; color: #157a42; border: 1px solid #157a42; border-radius: 4px; padding: 1px 7px; }
  #quoteDoc .qd-parties { display: flex; gap: 26px; margin: 14px 0 16px; }
  #quoteDoc .qd-parties > div { flex: 1; }
  #quoteDoc .qd-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
  #quoteDoc .qd-table th { text-align: left; background: #f1f4f0; border: 1px solid #d8ded8; padding: 7px 9px; font-size: 11px; }
  #quoteDoc .qd-table td { border: 1px solid #d8ded8; padding: 7px 9px; }
  #quoteDoc .qd-right { text-align: right; }
  #quoteDoc .qd-subtotal td { color: #5a625c; }
  #quoteDoc .qd-normal { text-decoration: line-through; color: #8a908a; }
  #quoteDoc .qd-discount td { color: #157a42; font-weight: 600; }
  #quoteDoc .qd-total-label { font-weight: 700; text-align: right; }
  #quoteDoc .qd-total { font-weight: 700; font-size: 13.5px; }
  #quoteDoc .qd-vat { font-size: 10.5px; color: #5a625c; margin-bottom: 14px; }
  #quoteDoc .qd-cols { display: flex; gap: 26px; }
  #quoteDoc .qd-cols > div { flex: 1; }
  #quoteDoc .qd-cols ul, #quoteDoc .qd-cols ol { margin: 0; padding-left: 1.1em; font-size: 10px; color: #3a403b; }
  #quoteDoc .qd-cols li { margin-bottom: 3px; }
  #quoteDoc .qd-sign { margin-top: 40px; font-size: 10px; color: #5a625c; }
  #quoteDoc .qd-signline { display: block; border-top: 1px solid #c2c7c2; height: 46px; }
  #quoteDoc .qd-sign-caps { display: flex; gap: 40px; }
  #quoteDoc .qd-sign-caps > span { flex: 1; text-align: center; }
  #quoteDoc .qd-contact { display: flex; align-items: center; justify-content: flex-start; gap: 12px; margin-top: 40px; }
  #quoteDoc .qd-contact img { display: block; border: 1px solid #d8ded8; }
  #quoteDoc .qd-contact b { display: block; font-size: 10.5px; color: #16181a; }
  #quoteDoc .qd-contact span { display: block; font-size: 9px; color: #5a625c; }
  #quoteDoc .qd-foot { margin-top: 16px; border-top: 1px solid #d8ded8; padding-top: 7px; font-size: 9px; color: #5a625c; text-align: center; }
  #quoteDoc[data-lang="en"] .qd-th { display: none !important; }
  #quoteDoc[data-lang="th"] .qd-en { display: none !important; }
</style>

<script define:vars={{ types, options, VAT_NOTE, QUOTE_VALID_DAYS, ROUND1_RATIO, PARTNER_DISCOUNTS }}>
  (function () {
    const areaInput   = document.getElementById('calcArea');
    const resultPrice = document.getElementById('resultPrice');
    const resultNote  = document.getElementById('resultNote');
    const breakdown   = document.getElementById('breakdown');
    const typeBtns    = document.querySelectorAll('.type-btn');
    const optLabels   = Array.from(document.querySelectorAll('.opt'));
    const locRadios   = document.querySelectorAll('input[name="location"]');
    const pkgRadios   = document.querySelectorAll('input[name="pkg"]');

    const optStep = document.getElementById('optStep');
    let propType = null;
    let location = 'cm';   // partner region: 'cm' (20%) or 'bkk' (10%)
    let pkg = 'two';
    let current = null;

    const isEn = () => document.body.classList.contains('en');
    const baht = (n) => n.toLocaleString('en-US');
    const roundUp500 = (n) => Math.ceil(n / 500) * 500;
    const regionName = (loc, en) => loc === 'bkk' ? (en ? 'Bangkok' : 'กรุงเทพฯ') : (en ? 'Chiang Mai' : 'เชียงใหม่');

    function syncOptions() {
      optStep.hidden = !propType;
      optLabels.forEach((el) => {
        const applies = !!propType && (el.dataset.for || '').split(',').includes(propType);
        el.hidden = !applies;
        if (!applies) el.querySelector('input').checked = false;
      });
    }

    function compute() {
      const sqm = parseFloat(areaInput.value);
      const type = types.find((t) => t.id === propType);
      if (!type || !sqm || sqm <= 0) return null;

      const tier = type.tiers.find((r) => r.max !== null && sqm <= r.max) || type.tiers[type.tiers.length - 1];
      const checked = optLabels
        .filter((el) => !el.hidden && el.querySelector('input').checked)
        .map((el) => options.find((o) => o.id === el.dataset.opt));

      if (!tier || tier.price === null || checked.some((o) => o.quote)) {
        return { quote: true, type, tier, checked, sqm };
      }

      const twoRound = tier.price;
      const base = pkg === 'one' ? roundUp500(twoRound * ROUND1_RATIO) : twoRound;
      const pkgTh = pkg === 'one' ? 'ตรวจรอบเดียว' : 'ตรวจ 2 รอบ';
      const pkgEn = pkg === 'one' ? 'single round' : '2 rounds';
      const lines = [{
        label: { th: `ตรวจ${type.th} · ${tier.th} · ${pkgTh}`, en: `${type.en} · ${tier.en} · ${pkgEn}` },
        amount: base,
      }];
      let total = base;

      checked.forEach((o) => {
        let amount = 0;
        if (o.pct) {
          amount = Math.round(base * o.pct);
          if (o.minCondo && propType === 'condo') amount = Math.max(amount, o.minCondo);
        } else if (o.add) {
          amount = o.add;
        }
        if (amount > 0) {
          lines.push({ label: { th: o.th, en: o.en }, amount });
          total += amount;
        }
      });

      // partner discount off the whole total
      const discountRate = PARTNER_DISCOUNTS[location] || 0;
      const discount = Math.round(total * discountRate);
      const net = total - discount;

      return { quote: false, type, tier, checked, sqm, lines, total, discount, discountRate, net, pkg };
    }

    function render() {
      current = compute();
      breakdown.innerHTML = '';

      if (!current) {
        resultPrice.textContent = '—';
        resultNote.textContent = !propType
          ? (isEn() ? 'Select a property type to begin' : 'เลือกประเภททรัพย์สินเพื่อเริ่มคำนวณ')
          : (isEn() ? 'Enter the usable area' : 'กรอกพื้นที่ใช้สอยเพื่อดูราคา');
        return;
      }

      if (current.quote) {
        resultPrice.textContent = isEn() ? 'Custom quote' : 'ประเมินราคา';
        resultNote.textContent = isEn()
          ? 'This property needs an individual quote — contact us'
          : 'ทรัพย์สินลักษณะนี้ต้องประเมินราคาเป็นรายกรณี กรุณาติดต่อเรา';
        return;
      }

      const en = isEn();
      const pct = Math.round(current.discountRate * 100);
      resultPrice.textContent = baht(current.net) + ' ฿';
      resultNote.textContent = en
        ? `Standard ${baht(current.total)} ฿ · partner ${pct}% off (−${baht(current.discount)} ฿)`
        : `ราคาปกติ ${baht(current.total)} ฿ · ส่วนลดพันธมิตร ${pct}% (−${baht(current.discount)} ฿)`;

      current.lines.forEach((l) => {
        const li = document.createElement('li');
        li.innerHTML = `<span>${en ? l.label.en : l.label.th}</span><b>${baht(l.amount)} ฿</b>`;
        breakdown.appendChild(li);
      });
      // discount line
      const dLi = document.createElement('li');
      dLi.className = 'bd-discount';
      dLi.innerHTML = `<span>${en ? `Partner discount (${regionName(location, true)} ${pct}%)` : `ส่วนลดพันธมิตร (${regionName(location, false)} ${pct}%)`}</span><b>−${baht(current.discount)} ฿</b>`;
      breakdown.appendChild(dLi);
      // net line
      const nLi = document.createElement('li');
      nLi.className = 'bd-net';
      nLi.innerHTML = `<span>${en ? 'Partner net total' : 'ราคาสุทธิพันธมิตร'}</span><b>${baht(current.net)} ฿</b>`;
      breakdown.appendChild(nLi);
    }

    // ── quotation ──
    function fillQuote() {
      if (!current || current.quote) return false;
      const en = isEn();
      const doc = document.getElementById('quoteDoc');
      doc.setAttribute('data-lang', en ? 'en' : 'th');
      const cur = en ? 'THB' : 'บาท';
      const money = (n) => `${baht(n)} ${cur}`;
      const pct = Math.round(current.discountRate * 100);

      const now = new Date();
      const valid = new Date(now.getTime() + QUOTE_VALID_DAYS * 864e5);
      const fmt = (d) => en
        ? d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
        : d.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
      const pad = (n) => String(n).padStart(2, '0');

      document.getElementById('qdNo').textContent =
        `WTH-P${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}`;
      document.getElementById('qdDate').textContent = fmt(now);
      document.getElementById('qdValid').textContent = fmt(valid);
      document.getElementById('qdPrintedTitle').textContent = document.title;
      document.getElementById('qdPrinted').textContent = now.toLocaleString(en ? 'en-GB' : 'th-TH');
      document.getElementById('qdCustomer').textContent = document.getElementById('qName').value.trim() || '—';
      document.getElementById('qdPhone').textContent = document.getElementById('qPhone').value.trim();
      document.getElementById('qdProject').textContent = document.getElementById('qProject').value.trim();

      const body = document.getElementById('qdItems');
      body.innerHTML = '';
      current.lines.forEach((l) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td>${en ? l.label.en : l.label.th}</td><td class="qd-right">${money(l.amount)}</td>`;
        body.appendChild(tr);
      });
      const areaRow = document.createElement('tr');
      const areaTxt = en
        ? `Stated usable area: ${current.sqm} sq.m.`
        : `พื้นที่ใช้สอยที่แจ้ง: ${current.sqm} ตร.ม.`;
      areaRow.innerHTML = `<td colspan="2" style="border:0;padding:6px 0 0;font-size:10px;color:#5a625c">${areaTxt}</td>`;
      body.appendChild(areaRow);
      // subtotal (normal) — struck through
      const subRow = document.createElement('tr');
      subRow.className = 'qd-subtotal';
      subRow.innerHTML = `<td>${en ? 'Subtotal (standard rate)' : 'ราคาปกติรวม'}</td><td class="qd-right qd-normal">${money(current.total)}</td>`;
      body.appendChild(subRow);
      // partner discount
      const disRow = document.createElement('tr');
      disRow.className = 'qd-discount';
      disRow.innerHTML = `<td>${en ? `Partner discount (${regionName(location, true)} ${pct}%)` : `ส่วนลดพันธมิตร (${regionName(location, false)} ${pct}%)`}</td><td class="qd-right">−${money(current.discount)}</td>`;
      body.appendChild(disRow);

      document.getElementById('qdTotal').textContent = money(current.net);

      const notes = [];
      notes.push(en
        ? `Special partner rate — ${pct}% off the standard price (${regionName(location, true)})`
        : `ราคาพิเศษสำหรับพันธมิตร — ลด ${pct}% จากราคาปกติ (พื้นที่${regionName(location, false)})`);
      if (VAT_NOTE) notes.push(en ? VAT_NOTE.en : VAT_NOTE.th);
      if (current.pkg === 'one') {
        notes.push(en
          ? 'Single-round package (re-inspection not included)'
          : 'แพ็กเกจตรวจรอบเดียว (ไม่รวมรอบแก้ไข)');
      } else {
        notes.push(en
          ? 'Includes one follow-up re-inspection (to be booked within 60 days of the first inspection)'
          : 'รวมตรวจรอบแก้ไขอีก 1 ครั้ง (นัดภายใน 60 วันหลังการตรวจครั้งแรก)');
      }
      document.getElementById('qdVat').textContent = notes.join(' · ');
      fitQuoteToPage();
      return true;
    }

    // Guarantee the quotation prints on a single A4 page: measure the document at
    // real A4 print dimensions and, only if it would overflow, zoom it down to fit.
    function fitQuoteToPage() {
      const doc = document.getElementById('quoteDoc');
      const saved = doc.getAttribute('style') || '';
      Object.assign(doc.style, { display: 'block', visibility: 'hidden', position: 'fixed', left: '-9999px', top: '0', width: '210mm', padding: '14mm', boxSizing: 'border-box', background: '#fff', zoom: '1' });
      const contentH = doc.offsetHeight;
      const probe = document.createElement('div');
      probe.style.cssText = 'position:fixed;left:-9999px;top:0;height:297mm';
      document.body.appendChild(probe);
      const pageH = probe.offsetHeight;
      probe.remove();
      doc.setAttribute('style', saved);   // back to its normal (print-hidden) state
      // leave a 4px safety margin so rounding never spills onto a 2nd page
      const z = contentH > pageH - 4 ? Math.max(0.6, (pageH - 4) / contentH) : 1;
      doc.style.zoom = String(z);          // 1 = untouched; <1 only when needed
    }

    const qfError = document.getElementById('qfError');
    // name + project are required; the contact detail stays optional
    const reqFields = ['qName', 'qProject'].map((id) => document.getElementById(id));
    reqFields.forEach((f) => f.addEventListener('input', () => {
      if (f.value.trim()) f.closest('.field').classList.remove('invalid');
    }));

    document.getElementById('btnQuote').addEventListener('click', () => {
      const priceable = !!current && !current.quote;
      let allFilled = true;
      reqFields.forEach((f) => {
        const ok = !!f.value.trim();
        f.closest('.field').classList.toggle('invalid', !ok);
        if (!ok) allFilled = false;
      });
      if (!priceable || !allFilled) {
        qfError.hidden = false;
        const firstEmpty = reqFields.find((f) => !f.value.trim());
        if (priceable && firstEmpty) firstEmpty.focus();
        qfError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }
      qfError.hidden = true;
      if (!fillQuote()) return;
      window.print();
    });

    typeBtns.forEach((btn) => btn.addEventListener('click', () => {
      typeBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      propType = btn.dataset.type;
      syncOptions();
      render();
    }));
    optLabels.forEach((el) => el.querySelector('input').addEventListener('change', render));
    areaInput.addEventListener('input', render);
    locRadios.forEach((r) => r.addEventListener('change', () => { location = r.value; render(); }));
    pkgRadios.forEach((r) => r.addEventListener('change', () => { pkg = r.value; render(); }));
    document.addEventListener('click', (e) => {
      if (e.target.closest('[data-lang-btn]')) setTimeout(render, 50);
    });

    syncOptions();
    render();
  })();
</script>
