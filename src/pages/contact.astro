<script>
  // Service-area map: 15 km radius around San Dek Junction (แยกศาลเด็ก).
  // Coordinates from OpenStreetMap: "ทางลอดแยกศาลเด็ก", Faham, Mueang Chiang Mai.
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  (function () {
    const el = document.getElementById('ctMap');
    if (!el) return;

    const CENTER: [number, number] = [18.8037866, 99.0182146];
    const RADIUS_M = 15000;

    // Only build the map once it's actually near the viewport — it's below the fold.
    const build = () => {
      // setView must come first: Leaflet throws when layers are added to a map
      // that has no centre/zoom yet. fitBounds below picks the real framing.
      const map = L.map(el, { scrollWheelZoom: false, zoomControl: true, attributionControl: true })
        .setView(CENTER, 11);

      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 19,
      }).addTo(map);

      const circle = L.circle(CENTER, {
        radius: RADIUS_M,
        color: '#2FE07C',
        weight: 2,
        fillColor: '#2FE07C',
        fillOpacity: 0.12,
      }).addTo(map);

      L.marker(CENTER, {
        icon: L.divIcon({
          className: '',
          html: '<span class="ct-pin"><img src="/assets/img/logo-mark.png" alt="" /></span>',
          iconSize: [38, 38],
          iconAnchor: [19, 19],
        }),
        keyboard: false,
      })
        .addTo(map)
        .bindPopup('แยกศาลเด็ก — จุดศูนย์กลางพื้นที่ให้บริการ<br>San Dek Junction — centre of our service area');

      // Frame the whole circle, then keep that as the minimum zoom.
      map.fitBounds(circle.getBounds(), { padding: [12, 12] });
      map.setMinZoom(map.getZoom());

      // The card is flex-sized; recalculate once the layout has settled.
      requestAnimationFrame(() => map.invalidateSize());
      new ResizeObserver(() => map.invalidateSize()).observe(el);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) { obs.disconnect(); build(); }
      }, { rootMargin: '300px' });
      io.observe(el);
      // Safety net: some environments never fire IO — build anyway after a beat.
      setTimeout(() => { if (!el.classList.contains('leaflet-container')) { io.disconnect(); build(); } }, 2500);
    } else {
      build();
    }
  })();
</script>

<script>
  // Contact form: success message + honeypot guard
  (function () {
    if (window.location.search.includes('success=1')) {
      const ok = document.getElementById('formOk');
      const form = document.getElementById('contactForm');
      if (ok) ok.style.display = 'flex';
      if (form) (form as HTMLFormElement).style.display = 'none';
    }

    const form = document.getElementById('contactForm') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', function (e) {
      const hp = form.querySelector('input[name="company"]') as HTMLInputElement;
      if (hp && hp.value) { e.preventDefault(); return; }
    });
  })();
</script>
