---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import settings from '../data/settings.json';

const perks = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-1.6-.2L3 21l1.3-4.4A8.4 8.4 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z"/></svg>`,
    top: { th: "ตอบกลับไว", en: "Fast reply" },
    bottom: { th: "ภายใน 24 ชม.", en: "within 24 hours" },
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 2h6a1 1 0 0 1 1 1v2H8V3a1 1 0 0 1 1-1z"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 12h6M9 16h4"/></svg>`,
    top: { th: "ประเมินราคา", en: "Price estimate" },
    bottom: { th: "เบื้องต้นฟรี", en: "free of charge" },
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M9 15l2 2 4-4"/></svg>`,
    top: { th: "ตรวจสอบคิวว่าง", en: "Check availability" },
    bottom: { th: "ให้คุณทันที", en: "right away" },
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M8 12l2.5 2.5L16 9"/></svg>`,
    top: { th: "แนะนำแพ็กเกจ", en: "Package advice" },
    bottom: { th: "ที่เหมาะสมที่สุด", en: "that fits you best" },
  },
];

const bandItems = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L12 16.4 6.7 19.2l1.1-5.9L3.5 9.2l5.9-.8z"/></svg>`,
    top: { th: "รายงานละเอียด", en: "Detailed report" },
    bottom: { th: "พร้อมภาพทุกจุด", en: "with photos of every point" },
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="3.5"/><path d="M22 20v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.6a4 4 0 0 1 0 7"/></svg>`,
    top: { th: "ลูกค้าไว้วางใจ", en: "Trusted by clients" },
    bottom: { th: "ทั่วภาคเหนือ", en: "across the North" },
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>`,
    top: { th: "มาตรฐานมืออาชีพ", en: "Professional standard" },
    bottom: { th: "ตรวจครบทุกระบบ", en: "every system covered" },
  },
];

const faqs = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>`,
    q: { th: "ใช้เวลาตรวจนานแค่ไหน ?", en: "How long does an inspection take?" },
    a: { th: "โดยเฉลี่ย 2–4 ชั่วโมง ขึ้นอยู่กับขนาดและประเภทของบ้านหรือคอนโด", en: "Typically 2–4 hours, depending on the size and type of the home or condo." },
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`,
    q: { th: "ต้องจองล่วงหน้ากี่วัน ?", en: "How far in advance should I book?" },
    a: { th: "แนะนำจองล่วงหน้า 1–3 วัน เพื่อให้เราจัดคิวตรวจให้คุณได้สะดวกที่สุด", en: "We recommend 1–3 days ahead so we can schedule the slot that suits you best." },
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9z"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>`,
    q: { th: "ตรวจวันเสาร์-อาทิตย์ หรือวันหยุดนักขัตฤกษ์ได้ไหม ?", en: "Do you inspect on weekends or public holidays?" },
    a: { th: "เราให้บริการทุกวัน ไม่มีวันหยุด (ตามคิวที่ว่าง)", en: "We work every day of the week, holidays included — subject to availability." },
  },
];

const provinces = ["เชียงใหม่", "ลำพูน", "ลำปาง", "เชียงราย"];

const serviceOptions = [
  { v: "handover", th: "ตรวจรับบ้านและคอนโด", en: "Home & Condo Handover Inspection" },
  { v: "supervision", th: "ควบคุมงานสร้างบ้าน", en: "Home Construction Supervision" },
  { v: "planning", th: "วางแผนก่อนสร้างบ้าน", en: "Pre-Construction Planning" },
  { v: "renovation", th: "ที่ปรึกษางานต่อเติม", en: "Renovation & Extension Advisory" },
  { v: "diagnosis", th: "ตรวจหาสาเหตุปัญหาบ้าน", en: "Home Problem Diagnosis" },
  { v: "contractor", th: "ตรวจคุณภาพงานผู้รับเหมา", en: "Contractor Work Quality Check" },
  { v: "other", th: "อื่น ๆ / ยังไม่แน่ใจ", en: "Other / not sure yet" },
];
---
<BaseLayout
  title="ติดต่อเรา / จองคิวตรวจบ้าน | WHAT THE HOUSE – Home Inspection Chiang Mai"
  description="ติดต่อ WHAT THE HOUSE เพื่อขอใบเสนอราคาและจองคิวตรวจบ้านตรวจคอนโดในเชียงใหม่ ลำพูน ลำปาง เชียงราย ตอบกลับภายใน 24 ชั่วโมง | Contact us to book a home inspection in Chiang Mai"
>
  <Header />
  <main>

    <!-- ============ HERO ============ -->
    <section class="hero hero-bleed ct-hero">
      <img class="hero-bg" src="/assets/img/contact/contact-hero.webp"
           alt="ที่ปรึกษา WHAT THE HOUSE กำลังอธิบายรายงานตรวจบ้านบนแท็บเล็ตให้ลูกค้าคู่หนึ่งฟัง — WHAT THE HOUSE consultant walking a couple through an inspection report"
           fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="container">
        <div class="hero-content">
          <span class="eyebrow ct-eyebrow"><span class="lang-th">ติดต่อ WHAT THE HOUSE</span><span class="lang-en">Contact WHAT THE HOUSE</span></span>
          <h1>
            <span class="lang-th">ยินดีให้คำปรึกษา<br>เรื่องบ้านและการตรวจบ้าน</span>
            <span class="lang-en block">Happy to advise you<br>on your home and its inspection</span>
          </h1>
          <p class="lead">
            <span class="lang-th">พร้อมดูแลคุณในทุกขั้นตอน เพื่อให้คุณมั่นใจก่อนตัดสินใจซื้อบ้านหรือคอนโด</span>
            <span class="lang-en block">With you at every step, so you can be confident before you commit to a home or condo.</span>
          </p>

          <div class="ct-perks">
            {perks.map((p) => (
              <div class="ct-perk">
                <span class="ct-perk-ic" set:html={p.icon} />
                <b><span class="lang-th">{p.top.th}</span><span class="lang-en">{p.top.en}</span></b>
                <span class="ct-perk-sub"><span class="lang-th">{p.bottom.th}</span><span class="lang-en">{p.bottom.en}</span></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROOF BAND ============ -->
    <section class="ct-band-wrap">
      <div class="container">
        <div class="ct-band">
          <div class="ct-band-stat">
            <span class="lang-th">ตรวจบ้านมาแล้วมากกว่า</span>
            <span class="lang-en block">Homes inspected so far</span>
            <b>1,000+ <span class="lang-th">หลัง</span><span class="lang-en">homes</span></b>
          </div>
          <div class="ct-band-items">
            {bandItems.map((b) => (
              <div class="ct-band-item">
                <span class="ct-band-ic" set:html={b.icon} />
                <div>
                  <b><span class="lang-th">{b.top.th}</span><span class="lang-en">{b.top.en}</span></b>
                  <span><span class="lang-th">{b.bottom.th}</span><span class="lang-en">{b.bottom.en}</span></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CHANNELS + FORM ============ -->
    <section class="section ct-main">
      <div class="container">
        <div class="ct-grid">

          <!-- Left: channels -->
          <aside class="ct-side">
            <div class="ct-panel">
              <h2 class="ct-side-title"><span class="lang-th">ช่องทางติดต่อเรา</span><span class="lang-en">Ways to reach us</span></h2>
              <p class="ct-side-sub"><span class="lang-th">สะดวกช่องทางไหน ติดต่อเราได้เลย</span><span class="lang-en block">Use whichever channel suits you.</span></p>

              <div class="ct-channels">
                <div class="ct-ch">
                  <span class="ct-ch-ic" style="background:#06c755">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.01 2 11c0 3.53 2.1 6.6 5.24 8.29-.07.63-.48 2.4-.55 2.76-.09.48.18.47.37.34.15-.1 2.4-1.59 3.37-2.24.51.07 1.03.11 1.57.11 5.52 0 10-4.01 10-9S17.52 2 12 2z"/></svg>
                  </span>
                  <div class="ct-ch-txt">
                    <b>LINE Official</b>
                    <span>{settings.lineId}</span>
                  </div>
                  <a class="ct-ch-btn" href={settings.lineUrl} target="_blank" rel="noopener">
                    <span class="lang-th">แชทกับเรา</span><span class="lang-en">Chat</span>
                  </a>
                </div>

                <div class="ct-ch">
                  <span class="ct-ch-ic" style="background:var(--green)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2H7a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9z"/></svg>
                  </span>
                  <div class="ct-ch-txt">
                    <b><span class="lang-th">โทรศัพท์</span><span class="lang-en">Phone</span></b>
                    <span>{settings.phoneDisplay}</span>
                  </div>
                  <a class="ct-ch-btn" href={`tel:${settings.phone}`}>
                    <span class="lang-th">โทรเลย</span><span class="lang-en">Call</span>
                  </a>
                </div>

                <div class="ct-ch">
                  <span class="ct-ch-ic" style="background:#1877f2">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  </span>
                  <div class="ct-ch-txt">
                    <b>Facebook</b>
                    <span>{settings.facebookDisplay}</span>
                  </div>
                  <a class="ct-ch-btn" href={settings.facebookUrl} target="_blank" rel="noopener">
                    <span class="lang-th">ส่งข้อความ</span><span class="lang-en">Message</span>
                  </a>
                </div>

                <div class="ct-ch">
                  <span class="ct-ch-ic" style="background:var(--panel-3);color:var(--green-bright)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22,6 12,13 2,6"/></svg>
                  </span>
                  <div class="ct-ch-txt">
                    <b><span class="lang-th">อีเมล</span><span class="lang-en">Email</span></b>
                    <span>{settings.email}</span>
                  </div>
                  <a class="ct-ch-btn" href={`mailto:${settings.email}`}>
                    <span class="lang-th">ส่งอีเมล</span><span class="lang-en">Email</span>
                  </a>
                </div>
              </div>

              <div class="ct-qr">
                <img src="/assets/img/line-qr.png" alt="LINE QR Code — What the House" width="104" height="104" loading="lazy" onerror="this.closest('.ct-qr').remove()" />
                <div>
                  <b><span class="lang-th">สแกนเพื่อแอด LINE</span><span class="lang-en">Scan to add us on LINE</span></b>
                  <p><span class="lang-th">เปิดกล้องมือถือหรือแอป LINE แล้วสแกน QR Code นี้ ทักหาเราได้ทันที</span><span class="lang-en block">Open your phone camera or the LINE app and scan to chat with us right away.</span></p>
                </div>
              </div>

              <div class="ct-hours">
                <span class="ct-hours-ic">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                </span>
                <div>
                  <b><span class="lang-th">เวลาทำการ</span><span class="lang-en">Opening hours</span></b>
                  <span class="ct-hours-line"><span class="lang-th">ทุกวัน 08:00 - 20:00 น.</span><span class="lang-en">Every day, 08:00 - 20:00</span></span>
                  <span class="ct-hours-line"><span class="lang-th">ตอบกลับภายใน 24 ชั่วโมง</span><span class="lang-en">We reply within 24 hours</span></span>
                </div>
              </div>
            </div>

            <div class="ct-quote">
              <img src="/assets/img/about/about-client.webp" alt="" loading="lazy" onerror="this.remove()" />
              <div class="ct-quote-txt">
                <b><span class="lang-th">บ้านดี คือบ้านที่แก้ไข<br>ก่อนเข้าอยู่</span><span class="lang-en block">A good home is one that's fixed<br>before you move in</span></b>
                <span><span class="lang-th">ไม่ใช่เข้าไปแล้วค่อยซ่อม</span><span class="lang-en">not repaired after you're already living in it</span></span>
                <i class="ct-quote-rule"></i>
              </div>
            </div>
          </aside>

          <!-- Right: form -->
          <div class="ct-form-card">
            <h2 class="ct-form-title"><span class="lang-th">ขอใบเสนอราคา / จองคิวตรวจบ้าน</span><span class="lang-en">Get a quote / book an inspection</span></h2>
            <p class="ct-form-sub"><span class="lang-th">กรอกข้อมูลของคุณ เราจะติดต่อกลับเพื่อให้คำแนะนำและประเมินราคาเบื้องต้น</span><span class="lang-en block">Send us your details and we'll get back with advice and an initial price estimate.</span></p>

            <!-- Success message (shown after Netlify redirect) -->
            <div id="formOk" class="form-ok" style="display:none">
              <svg viewBox="0 0 24 24" width="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/><path d="M22 4 12 14.01l-3-3"/></svg>
              <div>
                <b><span class="lang-th">ส่งข้อมูลเรียบร้อยแล้ว!</span><span class="lang-en">Message sent!</span></b>
                <p><span class="lang-th">เราจะติดต่อกลับภายใน 24 ชั่วโมง</span><span class="lang-en block">We'll get back to you within 24 hours.</span></p>
              </div>
            </div>

            <form
              id="contactForm"
              name="contact"
              method="POST"
              data-netlify="true"
              netlify-honeypot="company"
              action="/contact?success=1"
            >
              <input type="hidden" name="form-name" value="contact" />
              <div class="honey" aria-hidden="true">
                <label>Company (leave blank): <input name="company" tabindex="-1" autocomplete="off" /></label>
              </div>

              <div class="form-row">
                <div class="field">
                  <label for="fname"><span class="lang-th">ชื่อ-นามสกุล</span><span class="lang-en">Full name</span> <i class="req">*</i></label>
                  <input type="text" id="fname" name="name" required placeholder="กรอกชื่อ-นามสกุล" />
                </div>
                <div class="field">
                  <label for="fphone"><span class="lang-th">เบอร์โทรศัพท์</span><span class="lang-en">Phone</span> <i class="req">*</i></label>
                  <input type="tel" id="fphone" name="phone" required placeholder="กรอกเบอร์โทรศัพท์" />
                </div>
              </div>

              <div class="form-row">
                <div class="field">
                  <label for="femail"><span class="lang-th">อีเมล</span><span class="lang-en">Email</span></label>
                  <input type="email" id="femail" name="email" placeholder="กรอกอีเมล" />
                </div>
                <div class="field">
                  <label for="fservice"><span class="lang-th">ประเภทบริการที่สนใจ</span><span class="lang-en">Service you're interested in</span> <i class="req">*</i></label>
                  <select id="fservice" name="service" required>
                    <option value="" disabled selected>เลือกบริการ</option>
                    {serviceOptions.map((o) => (
                      <option value={o.v}>{o.th} / {o.en}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div class="field">
                <label for="fproject"><span class="lang-th">ที่อยู่โครงการ / หมู่บ้าน / คอนโด</span><span class="lang-en">Project / village / condo address</span> <i class="req">*</i></label>
                <input type="text" id="fproject" name="project" required placeholder="ชื่อโครงการ / หมู่บ้าน / คอนโด" />
              </div>

              <div class="form-row ct-row-3">
                <div class="field">
                  <label for="fprovince"><span class="lang-th">จังหวัด</span><span class="lang-en">Province</span> <i class="req">*</i></label>
                  <select id="fprovince" name="province" required>
                    <option value="" disabled selected>เลือกจังหวัด</option>
                    {provinces.map((p) => <option value={p}>{p}</option>)}
                    <option value="other">อื่น ๆ / Other</option>
                  </select>
                </div>
                <div class="field">
                  <label for="fsize"><span class="lang-th">ขนาดพื้นที่ (ตร.ม.)</span><span class="lang-en">Floor area (sq.m.)</span></label>
                  <input type="number" id="fsize" name="area_sqm" min="1" step="1" placeholder="เช่น 120" />
                </div>
                <div class="field">
                  <label for="fdate"><span class="lang-th">วันที่ต้องการตรวจ (โดยประมาณ)</span><span class="lang-en">Preferred date (approx.)</span></label>
                  <input type="date" id="fdate" name="preferred_date" placeholder="เลือกวันที่" />
                </div>
              </div>

              <div class="field">
                <label for="fmsg"><span class="lang-th">รายละเอียดเพิ่มเติม</span><span class="lang-en">Additional details</span></label>
                <textarea id="fmsg" name="message" placeholder="ระบุรายละเอียดเพิ่มเติม (ถ้ามี)"></textarea>
              </div>

              <div class="ct-submit-row">
                <p class="ct-privacy">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  <span>
                    <span class="lang-th">ข้อมูลของคุณจะถูกเก็บเป็นความลับ<br>ไม่มีการส่งต่อให้บุคคลภายนอก</span>
                    <span class="lang-en block">Your details stay confidential and are never shared with third parties.</span>
                  </span>
                </p>
                <button type="submit" class="btn btn-primary btn-lg ct-submit">
                  <span class="lang-th">ส่งข้อมูล</span>
                  <span class="lang-en">Send</span>
                  <svg viewBox="0 0 24 24" width="17" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 2 11 13"/><path d="M22 2 15 22 11 13 2 9l20-7z"/></svg>
                </button>
              </div>
            </form>
          </div>

        </div>
      </div>
    </section>

    <!-- ============ FAQ + MAP ============ -->
    <section class="section ct-faq-sec">
      <div class="container">
        <div class="ct-fm-grid">
          <div class="ct-panel">
            <h2 class="ct-side-title"><span class="lang-th">คำถามที่พบบ่อย (FAQ)</span><span class="lang-en">Frequently asked questions</span></h2>
            <div class="ct-faqs">
