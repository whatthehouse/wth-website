---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const gallery = [
  { img: "/assets/img/blog/roof-leak.webp",                 th: "ตรวจหลังคา",          en: "Roof inspection" },
  { img: "/assets/img/equipment/thermal-camera.webp",       th: "กล้องความร้อน",        en: "Thermal imaging" },
  { img: "/assets/img/blog/electrical-system.webp",         th: "ตรวจระบบไฟฟ้า",        en: "Electrical checks" },
  { img: "/assets/img/uploads/s__31154264_0.jpg",           th: "ทดสอบรอยรั่วซึม",      en: "Leak testing" },
  { img: "/assets/img/blog/plumbing-system.webp",           th: "ตรวจระบบประปา",        en: "Plumbing checks" },
  { img: "/assets/img/uploads/hero-inspector.webp",         th: "อธิบายรายงานกับลูกค้า", en: "Report walk-through" },
];
---
<BaseLayout
  title="เกี่ยวกับเรา | WHAT THE HOUSE – Home Inspection Chiang Mai"
  description="WHAT THE HOUSE ทีมตรวจบ้านมืออาชีพเชียงใหม่ ประสบการณ์ 10+ ปี ตรวจแล้วกว่า 1,000 หลัง เป็นกลาง โปร่งใส เชื่อถือได้"
>
  <Header />
  <main>

    <!-- ============ HERO (full-bleed) ============ -->
    <section class="hero hero-bleed about-hero">
      <img class="hero-bg" src="/assets/img/blog/thermal-camera-inspection.webp"
           alt="ช่างตรวจบ้าน WHAT THE HOUSE ใช้กล้องถ่ายภาพความร้อนตรวจภายในบ้าน"
           fetchpriority="high" onerror="this.src='/assets/img/uploads/hero-inspector.webp'" />
      <div class="hero-overlay"></div>
      <div class="container">
        <div class="hero-content">
          <span class="eyebrow"><span class="lang-th">เกี่ยวกับเรา</span><span class="lang-en">About Us</span></span>
          <h1>
            <span class="lang-th">ผู้เชี่ยวชาญด้าน<br><span class="accent">การตรวจบ้าน</span></span>
            <span class="lang-en block">Home inspection<br><span class="accent">specialists</span></span>
          </h1>
          <p class="about-hero-sub"><span class="lang-th">ที่เข้าใจทั้งงานก่อสร้างและมุมของเจ้าของบ้าน</span><span class="lang-en block">who understand both construction and the homeowner's side</span></p>
          <p class="lead"><span class="lang-th">จากประสบการณ์ด้านวิศวกรรมและงานก่อสร้างกว่า 10 ปี สู่การตรวจบ้านและคอนโดมากกว่า 1,000 หลัง</span><span class="lang-en block">From over 10 years in engineering and construction to more than 1,000 home and condo inspections.</span></p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-lg" href="/contact">
              <svg viewBox="0 0 24 24" width="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              <span class="lang-th">จองคิวตรวจบ้าน</span><span class="lang-en">Book an Inspection</span>
            </a>
            <a class="btn btn-glass btn-lg" href="/services"><span class="lang-th">ดูบริการของเรา</span><span class="lang-en">Our Services</span> →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ TRUST STAT BAR ============ -->
    <section class="about-statbar">
      <div class="container">
        <div class="hero-trust">
          <div class="t">
            <span class="t-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 21v-6h6v6"/></svg></span>
            <div><b>1,000+</b><span class="lang-th">หลังที่ตรวจแล้ว</span><span class="lang-en">homes inspected</span></div>
          </div>
          <div class="t">
            <span class="t-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <div><b>10+ ปี</b><span class="lang-th">ประสบการณ์</span><span class="lang-en">years experience</span></div>
          </div>
          <div class="t">
            <span class="t-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <div><b>4 จังหวัด</b><span class="lang-th">พื้นที่ให้บริการ</span><span class="lang-en">service areas</span></div>
          </div>
          <div class="t">
            <span class="t-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/></svg></span>
            <div><b>TH / EN</b><span class="lang-th">รายงานสองภาษา</span><span class="lang-en">bilingual reports</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ OUR STORY ============ -->
    <section class="section">
      <div class="container">
        <div class="story-grid-wrap">
          <div class="story-copy">
            <span class="eyebrow"><span class="lang-th">เรื่องราวของเรา</span><span class="lang-en">Our Story</span></span>
            <h2 class="section-title"><span class="lang-th">เกิดจากประสบการณ์จริง<br>เพื่อให้เจ้าของบ้าน<span class="accent">มั่นใจในทุกการตัดสินใจ</span></span><span class="lang-en block">Born from real experience — so homeowners can <span class="accent">decide with confidence</span></span></h2>
            <p><span class="lang-th">WHAT THE HOUSE ก่อตั้งจากประสบการณ์ด้านวิศวกรรม งานก่อสร้าง และการตรวจบ้านจริง เราเข้าใจทั้งวิธีการก่อสร้าง ลำดับงาน จุดเสี่ยงของแต่ละระบบ รวมถึงผลกระทบที่ปัญหาเหล่านั้นอาจมีต่อเจ้าของบ้านในระยะยาว</span><span class="lang-en block">WHAT THE HOUSE was built on real experience in engineering, construction and home inspection. We understand how homes are built, the sequence of work, the weak points of each system — and the long-term impact those problems can have on an owner.</span></p>
            <p><span class="lang-th">เราจึงไม่ได้เพียงระบุว่า "พบข้อบกพร่องตรงไหน" แต่ให้ความสำคัญกับการอธิบายสาเหตุ ระดับความสำคัญ และแนวทางแก้ไข เพื่อให้เจ้าของบ้านใช้ข้อมูลประกอบการตัดสินใจได้อย่างมั่นใจ</span><span class="lang-en block">So we don't just point out "where the defect is." We explain the cause, the severity, and the way to fix it — giving homeowners the information to decide with confidence.</span></p>
          </div>

          <div class="story-grid">
            {gallery.map((g) => (
              <figure class="story-shot">
                <img src={g.img} alt={g.th} loading="lazy" />
                <figcaption><span class="lang-th">{g.th}</span><span class="lang-en">{g.en}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PHILOSOPHY / PRINCIPLES (kept) ============ -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">ปรัชญาการทำงาน</span><span class="lang-en">Our Philosophy</span></span>
          <h2 class="section-title"><span class="lang-th">หลักการที่เราทำงานด้วย</span><span class="lang-en">The principles we work by</span></h2>
        </div>
        <div class="grid grid-3">

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h4><span class="lang-th">ซื่อสัตย์และเป็นกลาง</span><span class="lang-en">Honest &amp; Unbiased</span></h4>
            <p><span class="lang-th">เราไม่มีผลประโยชน์ทับซ้อนกับโครงการหรือผู้รับเหมาใด บอกความจริงตามที่พบ ไม่บิดเบือน ไม่ปิดบัง</span><span class="lang-en block">We have no conflicts of interest with any developer or contractor. We report what we find — nothing more, nothing less.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </div>
            <h4><span class="lang-th">ละเอียดและครอบคลุม</span><span class="lang-en">Thorough &amp; Comprehensive</span></h4>
            <p><span class="lang-th">ตรวจทุกจุด ทุกระบบ ไม่ข้ามขั้นตอน ใช้อุปกรณ์เฉพาะทางเพื่อตรวจพบปัญหาที่สายตาอาจมองไม่เห็น</span><span class="lang-en block">We inspect every point and every system — no shortcuts. Specialized tools catch what the naked eye can miss.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h4><span class="lang-th">อธิบายให้เข้าใจง่าย</span><span class="lang-en">Clear Communication</span></h4>
            <p><span class="lang-th">รายงานเขียนภาษาเข้าใจง่าย ไม่เต็มไปด้วยศัพท์เทคนิค มีรูปภาพและคำอธิบาย เหมาะกับทุกคน ไม่ว่าจะเป็นสายช่างหรือไม่</span><span class="lang-en block">Reports are written in plain language with photos and clear descriptions — suitable for everyone, technical or not.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h4><span class="lang-th">ยืนหยัดเพื่อลูกค้า</span><span class="lang-en">Client-First</span></h4>
            <p><span class="lang-th">เราทำงานเพื่อผลประโยชน์ของคุณเพียงอย่างเดียว ไม่ใช่เพื่อโครงการหรือผู้รับเหมา คุณคือคนที่เราต้องปกป้อง</span><span class="lang-en block">We work solely for your benefit — not the developer's, not the contractor's. You are who we protect.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/></svg>
            </div>
            <h4><span class="lang-th">รายงานที่ใช้งานได้จริง</span><span class="lang-en">Actionable Reports</span></h4>
            <p><span class="lang-th">รายงานของเราไม่ใช่แค่รายการปัญหา แต่มีแนวทางแก้ไขที่ชัดเจน ช่วยให้คุณนำไปเจรจากับโครงการหรือช่างได้ทันที</span><span class="lang-en block">Our reports don't just list problems — they include clear recommendations so you can take action with your developer or contractor right away.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg>
            </div>
            <h4><span class="lang-th">บริการ 2 ภาษา</span><span class="lang-en">Bilingual Service</span></h4>
            <p><span class="lang-th">รายงานและการสื่อสารทุกอย่างรองรับทั้งภาษาไทยและอังกฤษ เหมาะสำหรับลูกค้าชาวต่างชาติที่ซื้ออสังหาริมทรัพย์ในเชียงใหม่</span><span class="lang-en block">All reports and communications in Thai and English — ideal for foreign buyers investing in Chiang Mai property.</span></p>
          </div>

        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section">
      <div class="container">
        <div class="cta-band">
          <h2><span class="lang-th">ไว้วางใจให้เราตรวจบ้านของคุณ</span><span class="lang-en">Trust us with your home inspection</span></h2>
          <p><span class="lang-th">ทีมงานมืออาชีพ เป็นกลาง และโปร่งใส พร้อมให้บริการในเชียงใหม่และภาคเหนือ</span><span class="lang-en block">Professional, independent and transparent — serving Chiang Mai and Northern Thailand.</span></p>
          <div class="btns">
            <a class="btn btn-primary btn-lg" href="/contact"><span class="lang-th">จองคิวตรวจบ้าน</span><span class="lang-en">Book an Inspection</span></a>
            <a class="btn btn-ghost btn-lg" href="/services"><span class="lang-th">ดูบริการทั้งหมด</span><span class="lang-en">Our Services</span></a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* about hero (shorter than homepage) */
.about-hero > .container { min-height: 62vh; padding-bottom: 64px; }
.about-hero-sub { font-size: clamp(1.15rem, 2.4vw, 1.5rem); color: #fff; font-weight: 600; letter-spacing: -.01em; margin: 0 0 18px; max-width: 26ch; }
.about-hero .lead { margin: 0 0 30px; }

/* trust stat bar */
.about-statbar { background: var(--ink-2); border-bottom: 1px solid var(--line); padding: 26px 0; }
.about-statbar .hero-trust { justify-content: space-between; gap: 22px 30px; }

/* our story */
.story-grid-wrap { display: grid; grid-template-columns: 1fr 1.05fr; gap: 52px; align-items: center; }
.story-copy .section-title { margin-bottom: .6em; }
.story-copy p { color: var(--grey); margin: 0 0 16px; line-height: 1.8; }
.story-copy p:last-child { margin-bottom: 0; }
.story-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.story-shot { position: relative; margin: 0; border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--line); aspect-ratio: 3/4; }
.story-shot img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
.story-shot:hover img { transform: scale(1.06); }
.story-shot figcaption {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 12px 10px;
  font-size: .78rem; font-weight: 500; color: #fff; text-align: center;
  background: linear-gradient(180deg, transparent, rgba(10,11,12,.85));
}
@media (max-width: 900px) {
  .story-grid-wrap { grid-template-columns: 1fr; gap: 34px; }
  .about-statbar .hero-trust { justify-content: flex-start; }
}
@media (max-width: 520px) {
  .story-grid { grid-template-columns: 1fr 1fr; }
}

/* value cards (kept) */
.value-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; transition: .2s; }
.value-card:hover { box-shadow: var(--shadow); transform: translateY(-3px); border-color: var(--line-2); }
.vc-icon { width: 52px; height: 52px; border-radius: 14px; background: var(--green-soft); color: var(--green-bright); border: 1px solid rgba(47,224,124,.18); display: grid; place-items: center; margin-bottom: 14px; }
.value-card h4 { font-size: 1rem; margin-bottom: .3em; }
.value-card p { color: var(--grey); font-size: .9rem; margin: 0; line-height: 1.65; }
</style>
