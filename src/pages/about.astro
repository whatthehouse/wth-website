---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import settings from '../data/settings.json';
---
<BaseLayout
  title="เกี่ยวกับเรา | WHAT THE HOUSE – Home Inspection Chiang Mai"
  description="WHAT THE HOUSE ทีมตรวจบ้านมืออาชีพเชียงใหม่ ประสบการณ์ 10+ ปี ตรวจแล้วกว่า 800 หลัง เป็นกลาง โปร่งใส เชื่อถือได้"
>
  <Header />
  <main>

    <!-- ============ PAGE HERO ============ -->
    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/">หน้าแรก</a> / <span class="lang-th">เกี่ยวกับเรา</span><span class="lang-en">About</span></p>
        <span class="eyebrow"><span class="lang-th">เกี่ยวกับเรา</span><span class="lang-en">About Us</span></span>
        <h1><span class="lang-th">ทำไมเราถึงชื่อ<br>WHAT THE HOUSE</span><span class="lang-en">Why we're called<br>WHAT THE HOUSE</span></h1>
        <p><span class="lang-th">เพราะเราเชื่อว่าทุกคนควรรู้ว่า "บ้านของตัวเองมีปัญหาอะไร" ก่อนที่จะสายเกินไป</span><span class="lang-en block">Because we believe everyone deserves to know exactly what's wrong with their home — before it's too late.</span></p>
      </div>
    </section>

    <!-- ============ BRAND STORY ============ -->
    <section class="section">
      <div class="container">
        <div class="about-grid">
          <div>
            <span class="eyebrow"><span class="lang-th">จุดเริ่มต้น</span><span class="lang-en">Our Story</span></span>
            <h2 class="section-title"><span class="lang-th">เกิดจากประสบการณ์จริง</span><span class="lang-en">Born from real experience</span></h2>
            <p><span class="lang-th">WHAT THE HOUSE เกิดขึ้นจากความเชื่อที่ว่าการซื้อบ้านหรือคอนโดคือการลงทุนครั้งใหญ่ที่สุดในชีวิตของหลายคน แต่ผู้ซื้อส่วนใหญ่กลับไม่รู้ว่าทรัพย์สินที่ตัวเองจะรับมอบนั้นมีปัญหาหรือไม่</span><span class="lang-en block">WHAT THE HOUSE was founded on the belief that buying a home or condo is one of the biggest investments in a person's life — yet most buyers have no idea whether the property they're about to accept actually has problems.</span></p>
            <p><span class="lang-th">ทีมงานของเรามีพื้นฐานจากงานวิศวกรรมและก่อสร้าง สั่งสมประสบการณ์มากกว่า 10 ปี ผ่านการตรวจบ้านและคอนโดมาแล้วกว่า 800 หลังทั่วภาคเหนือ เราพบว่าบ้านที่ "ดูดี" จากภายนอก มักซ่อนปัญหาไว้มากกว่าที่เจ้าของรู้</span><span class="lang-en block">Our team comes from an engineering and construction background, with over 10 years of accumulated experience and more than 800 inspections across Northern Thailand. We've found time and again that homes that "look fine" often hide more problems than the owner realizes.</span></p>
            <p><span class="lang-th">เราจึงตั้ง WHAT THE HOUSE ขึ้นเพื่อเป็นเสียงของผู้ซื้อ ให้ข้อมูลที่ตรงไปตรงมา เป็นกลาง และเชื่อถือได้ เพื่อให้คุณตัดสินใจได้อย่างมั่นใจ</span><span class="lang-en block">So we built WHAT THE HOUSE to be the buyer's voice — providing honest, unbiased, trustworthy information so you can make decisions with confidence.</span></p>

            <ul class="value-list">
              <li>
                <span class="ic">✓</span>
                <span><span class="lang-th"><b>เป็นกลาง 100%</b> — ไม่มีความสัมพันธ์กับโครงการหรือผู้รับเหมาใด</span><span class="lang-en block"><b>100% independent</b> — no ties to any developer or contractor</span></span>
              </li>
              <li>
                <span class="ic">✓</span>
                <span><span class="lang-th"><b>โปร่งใสทุกขั้นตอน</b> — รายงานชัดเจน อ่านเข้าใจง่าย ไม่ปิดบัง</span><span class="lang-en block"><b>Fully transparent</b> — clear reports that are easy to understand, nothing hidden</span></span>
              </li>
              <li>
                <span class="ic">✓</span>
                <span><span class="lang-th"><b>มืออาชีพ</b> — ทีมงานมีความรู้ด้านวิศวกรรมและก่อสร้างจริง</span><span class="lang-en block"><b>Truly professional</b> — team with real engineering and construction knowledge</span></span>
              </li>
            </ul>
          </div>

          <!-- Story image -->
          <div class="about-img-wrap">
            {settings.aboutImage ? (
              <img class="about-img" src={settings.aboutImage} alt="WHAT THE HOUSE" width="600" height="450" />
            ) : (
              <div class="about-img-placeholder">
                <svg viewBox="0 0 80 80" width="64" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 50L40 20l30 30"/><path d="M20 45v20h40V45"/><path d="M32 65V50h16v15"/><rect x="34" y="28" width="12" height="10" rx="1"/></svg>
                <span><span class="lang-th">รูปทีมงาน / หน้างาน</span><span class="lang-en">Team / on-site photo</span></span>
              </div>
            )}
            <div class="about-badge-wrap">
              <div class="about-badge">
                <b>800+</b>
                <span><span class="lang-th">หลังที่ตรวจแล้ว</span><span class="lang-en">inspections done</span></span>
              </div>
              <div class="about-badge">
                <b>10+</b>
                <span><span class="lang-th">ปีประสบการณ์</span><span class="lang-en">years experience</span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ STATS ============ -->
    <section class="section tight navy">
      <div class="container">
        <div class="stats">
          <div class="s"><b>800+</b><span class="lang-th">หลังที่ตรวจแล้ว</span><span class="lang-en">homes inspected</span></div>
          <div class="s"><b>10+</b><span class="lang-th">ปีประสบการณ์</span><span class="lang-en">years experience</span></div>
          <div class="s"><b>4</b><span class="lang-th">จังหวัดให้บริการ</span><span class="lang-en">provinces served</span></div>
          <div class="s"><b>100%</b><span class="lang-th">เป็นกลาง เชื่อถือได้</span><span class="lang-en">independent & trusted</span></div>
        </div>
      </div>
    </section>

    <!-- ============ VALUES ============ -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">ปรัชญาการทำงาน</span><span class="lang-en">Our Philosophy</span></span>
          <h2 class="section-title"><span class="lang-th">หลักการที่เราทำงานด้วย</span><span class="lang-en">The principles we work by</span></h2>
        </div>
        <div class="grid grid-3">

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h4><span class="lang-th">ซื่อสัตย์และเป็นกลาง</span><span class="lang-en">Honest & Unbiased</span></h4>
            <p><span class="lang-th">เราไม่มีผลประโยชน์ทับซ้อนกับโครงการหรือผู้รับเหมาใด บอกความจริงตามที่พบ ไม่บิดเบือน ไม่ปิดบัง</span><span class="lang-en block">We have no conflicts of interest with any developer or contractor. We report what we find — nothing more, nothing less.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </div>
            <h4><span class="lang-th">ละเอียดและครอบคลุม</span><span class="lang-en">Thorough & Comprehensive</span></h4>
            <p><span class="lang-th">ตรวจทุกจุด ทุกระบบ ไม่ข้ามขั้นตอน ใช้อุปกรณ์เฉพาะทางเพื่อตรวจพบปัญหาที่สายตาอาจมองไม่เห็น</span><span class="lang-en block">We inspect every point and every system — no shortcuts. Specialized tools catch what the naked eye can miss.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h4><span class="lang-th">อธิบายให้เข้าใจง่าย</span><span class="lang-en">Clear Communication</span></h4>
            <p><span class="lang-th">รายงานเขียนภาษาเข้าใจง่าย ไม่เต็มไปด้วยศัพท์เทคนิค มีรูปภาพและคำอธิบาย เหมาะกับทุกคน ไม่ว่าจะเป็นสายช่างหรือไม่</span><span class="lang-en block">Reports are written in plain language with photos and clear descriptions — suitable for everyone, technical or not.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h4><span class="lang-th">ยืนหยัดเพื่อลูกค้า</span><span class="lang-en">Client-First</span></h4>
            <p><span class="lang-th">เราทำงานเพื่อผลประโยชน์ของคุณเพียงอย่างเดียว ไม่ใช่เพื่อโครงการหรือผู้รับเหมา คุณคือคนที่เราต้องปกป้อง</span><span class="lang-en block">We work solely for your benefit — not the developer's, not the contractor's. You are who we protect.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/></svg>
            </div>
            <h4><span class="lang-th">รายงานที่ใช้งานได้จริง</span><span class="lang-en">Actionable Reports</span></h4>
            <p><span class="lang-th">รายงานของเราไม่ใช่แค่รายการปัญหา แต่มีแนวทางแก้ไขที่ชัดเจน ช่วยให้คุณนำไปเจรจากับโครงการหรือช่างได้ทันที</span><span class="lang-en block">Our reports don't just list problems — they include clear recommendations so you can take action with your developer or contractor right away.</span></p>
          </div>

          <div class="value-card">
            <div class="vc-icon">
              <svg viewBox="0 0 24 24" width="26" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg>
            </div>
            <h4><span class="lang-th">บริการ 2 ภาษา</span><span class="lang-en">Bilingual Service</span></h4>
            <p><span class="lang-th">รายงานและการสื่อสารทุกอย่างรองรับทั้งภาษาไทยและอังกฤษ เหมาะสำหรับลูกค้าชาวต่างชาติที่ซื้ออสังหาริมทรัพย์ในเชียงใหม่</span><span class="lang-en block">All reports and communications in Thai and English — ideal for foreign buyers investing in Chiang Mai property.</span></p>
          </div>

        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section soft">
      <div class="container">
        <div class="cta-band">
          <h2><span class="lang-th">ไว้วางใจให้เราตรวจบ้านของคุณ</span><span class="lang-en">Trust us with your home inspection</span></h2>
          <p><span class="lang-th">ทีมงานมืออาชีพ เป็นกลาง และโปร่งใส พร้อมให้บริการในเชียงใหม่และภาคเหนือ</span><span class="lang-en block">Professional, independent and transparent — serving Chiang Mai and Northern Thailand.</span></p>
          <div class="btns">
            <a class="btn btn-primary btn-lg" href="/contact"><span class="lang-th">จองคิวตรวจบ้าน</span><span class="lang-en">Book an Inspection</span></a>
            <a class="btn btn-ghost btn-lg" href="/services"><span class="lang-th">ดูบริการทั้งหมด</span><span class="lang-en">Our Services</span></a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* about image placeholder */
.about-img-wrap { position: relative; }
.about-img-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  background: linear-gradient(150deg, #12201a, #0b1310);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--green-bright);
  font-size: .88rem;
  border: 1px solid var(--line);
}
.about-img-placeholder svg { opacity: .5; }
.about-img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  border-radius: var(--radius);
  border: 1px solid var(--line);
}
.about-badge-wrap {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}
.about-badge {
  flex: 1;
  background: var(--panel-2);
  border: 1px solid var(--line);
  color: #fff;
  border-radius: var(--radius-sm);
  padding: 16px;
  text-align: center;
}
.about-badge b { display: block; font-family: var(--mono); font-size: 1.8rem; color: var(--green-bright); line-height: 1; font-weight: 600; }
.about-badge span { font-size: .8rem; color: var(--grey); margin-top: 4px; display: block; }

/* value cards */
.value-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 26px;
  transition: .2s;
}
.value-card:hover { box-shadow: var(--shadow); transform: translateY(-3px); border-color: var(--line-2); }
.vc-icon {
  width: 52px; height: 52px;
  border-radius: 14px;
  background: var(--green-soft);
  color: var(--green-bright);
  border: 1px solid rgba(47,224,124,.18);
  display: grid; place-items: center;
  margin-bottom: 14px;
}
.value-card h4 { font-size: 1rem; margin-bottom: .3em; }
.value-card p { color: var(--grey); font-size: .9rem; margin: 0; line-height: 1.65; }

@media (max-width: 720px) {
  .about-badge-wrap { flex-direction: row; }
}
</style>
