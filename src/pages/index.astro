---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="ตรวจบ้านเชียงใหม่ ตรวจคอนโด | WHAT THE HOUSE – Home Inspection Chiang Mai"
  description="WHAT THE HOUSE บริการตรวจบ้านและตรวจคอนโดก่อนรับมอบในเชียงใหม่ ลำพูน ลำปาง เชียงราย ตรวจละเอียดทุกระบบ รายงาน PDF ไทย-อังกฤษ ประสบการณ์ 800+ หลัง | Home Inspection Chiang Mai"
>
  <Header />
  <main>

    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">Chiang Mai • Lamphun • Lampang • Chiang Rai</span>
          <h1>
            <span class="lang-th">ตรวจบ้านและคอนโด<br>ก่อนรับมอบ อย่างมั่นใจ</span>
            <span class="lang-en block">Inspect your home &amp; condo<br>before you accept it</span>
          </h1>
          <p class="lead">
            <span class="lang-th">ทีมตรวจบ้านมืออาชีพ ตรวจละเอียดทุกระบบ พร้อมรายงาน PDF ภาษาไทยและอังกฤษ ช่วยให้คุณรับมอบบ้านหรือคอนโดได้อย่างสบายใจ</span>
            <span class="lang-en block">A professional inspection team that checks every system in detail and delivers a clear Thai–English PDF report — so you can accept your new home with confidence.</span>
          </p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-lg" href="/contact">
              <span class="lang-th">จองคิวตรวจบ้าน</span>
              <span class="lang-en">Book an Inspection</span>
            </a>
            <a class="btn btn-outline btn-lg" href="/services">
              <span class="lang-th">ดูบริการทั้งหมด</span>
              <span class="lang-en">Our Services</span>
            </a>
          </div>
          <div class="hero-trust">
            <div class="t"><b>800+</b><span class="lang-th">หลังที่ตรวจแล้ว</span><span class="lang-en">homes inspected</span></div>
            <div class="t"><b>10+</b><span class="lang-th">ปีประสบการณ์</span><span class="lang-en">years experience</span></div>
            <div class="t"><b>1–3</b><span class="lang-th">วัน ได้รายงาน</span><span class="lang-en">days to report</span></div>
            <div class="t"><b>TH/EN</b><span class="lang-th">รายงาน 2 ภาษา</span><span class="lang-en">bilingual report</span></div>
          </div>
        </div>

        <div class="hero-art">
          <span class="badge">
            <span class="lang-th">ตรวจ 2 รอบ</span>
            <span class="lang-en">2 inspection rounds</span>
          </span>
          <ul class="checklist">
            <li>
              <span class="ic">✓</span>
              <span>
                <span class="lang-th">ตรวจโครงสร้าง สถาปัตยกรรม และงานระบบครบทุกจุด</span>
                <span class="lang-en block">Structure, architecture and all building systems</span>
              </span>
            </li>
            <li>
              <span class="ic">✓</span>
              <span>
                <span class="lang-th">ใช้อุปกรณ์ตรวจสอบเฉพาะทาง เช่น กล้องระบบ ตรวจไฟฟ้า</span>
                <span class="lang-en block">Specialized inspection equipment &amp; tools</span>
              </span>
            </li>
            <li>
              <span class="ic">✓</span>
              <span>
                <span class="lang-th">ตรวจน้ำรั่ว น้ำซึม จำลองฝน หลังคา ระบบประปา</span>
                <span class="lang-en block">Leak &amp; water testing, roof and plumbing checks</span>
              </span>
            </li>
            <li>
              <span class="ic">✓</span>
              <span>
                <span class="lang-th">รายงานพร้อมรูปภาพและคำอธิบายชัดเจน</span>
                <span class="lang-en block">Full photo report with clear explanations</span>
              </span>
            </li>
            <li>
              <span class="ic">✓</span>
              <span>
                <span class="lang-th">ตรวจรอบแก้ไขซ้ำ ก่อนคุณเซ็นรับมอบ</span>
                <span class="lang-en block">Free re-inspection round before you sign off</span>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ SERVICES (6 cards) ============ -->
    <section class="section" id="services">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">บริการของเรา</span><span class="lang-en">Our Services</span></span>
          <h2 class="section-title"><span class="lang-th">เราไม่ได้มีแค่ตรวจบ้าน</span><span class="lang-en">More than just home inspection</span></h2>
          <p><span class="lang-th">บริการครบ ตั้งแต่ก่อนสร้าง ระหว่างก่อสร้าง ไปจนถึงตรวจรับมอบและแก้ปัญหาบ้าน</span><span class="lang-en block">From planning and construction supervision to final hand-over inspection and defect diagnosis.</span></p>
        </div>
        <div class="grid grid-3">

          <a class="card" href="/services#s1">
            <div class="svc-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 21v-6h6v6"/></svg>
            </div>
            <h3><span class="lang-th">ตรวจบ้าน / คอนโดก่อนรับมอบ</span><span class="lang-en">Home &amp; Condo Inspection</span></h3>
            <p><span class="lang-th">บริการหลักของแบรนด์ ตรวจก่อนรับมอบและก่อนโอน ครบทุกระบบ</span><span class="lang-en block">Our core service — full pre-handover inspection of every system.</span></p>
            <span class="more"><span class="lang-th">ดูเพิ่มเติม</span><span class="lang-en">Learn more</span> →</span>
          </a>

          <a class="card" href="/services#s2">
            <div class="svc-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 20h20"/><path d="M4 20V8l8-5 8 5v12"/><path d="M9 20v-6h6v6"/></svg>
            </div>
            <h3><span class="lang-th">ควบคุมงานก่อสร้าง</span><span class="lang-en">Construction Supervision</span></h3>
            <p><span class="lang-th">ตรวจความคืบหน้าและคุณภาพงานตามงวด ก่อนจ่ายเงินผู้รับเหมา</span><span class="lang-en block">Monitor progress and quality each phase, before paying the contractor.</span></p>
            <span class="more"><span class="lang-th">ดูเพิ่มเติม</span><span class="lang-en">Learn more</span> →</span>
          </a>

          <a class="card" href="/services#s3">
            <div class="svc-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2h6c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/></svg>
            </div>
            <h3><span class="lang-th">ที่ปรึกษาก่อนสร้างบ้าน</span><span class="lang-en">Pre-Construction Consulting</span></h3>
            <p><span class="lang-th">รีวิวแบบแปลน ฟังก์ชัน วัสดุ และ BOQ ก่อนเซ็นสัญญาผู้รับเหมา</span><span class="lang-en block">Review plans, materials and BOQ before signing with a contractor.</span></p>
            <span class="more"><span class="lang-th">ดูเพิ่มเติม</span><span class="lang-en">Learn more</span> →</span>
          </a>

          <a class="card" href="/services#s4">
            <div class="svc-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2l6 6"/><path d="M3 17l11-11 4 4L7 21H3z"/></svg>
            </div>
            <h3><span class="lang-th">ที่ปรึกษางานต่อเติม</span><span class="lang-en">Renovation &amp; Extension</span></h3>
            <p><span class="lang-th">ประเมินความเป็นไปได้ ควบคุมและตรวจคุณภาพงานต่อเติม</span><span class="lang-en block">Feasibility checks plus supervision and QC for extension work.</span></p>
            <span class="more"><span class="lang-th">ดูเพิ่มเติม</span><span class="lang-en">Learn more</span> →</span>
          </a>

          <a class="card" href="/services#s5">
            <div class="svc-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </div>
            <h3><span class="lang-th">ตรวจปัญหาบ้าน</span><span class="lang-en">Defect &amp; Problem Diagnosis</span></h3>
            <p><span class="lang-th">หาสาเหตุน้ำรั่ว น้ำซึม ผนังแตกร้าว พื้นทรุด ไฟฟ้า พร้อมแนวทางแก้ไข</span><span class="lang-en block">Find the cause of leaks, cracks, settling and electrical issues.</span></p>
            <span class="more"><span class="lang-th">ดูเพิ่มเติม</span><span class="lang-en">Learn more</span> →</span>
          </a>

          <a class="card" href="/services#s6">
            <div class="svc-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <h3><span class="lang-th">ตรวจรับงานผู้รับเหมา</span><span class="lang-en">Contractor Work Inspection</span></h3>
            <p><span class="lang-th">คนกลางตรวจคุณภาพงานก่อสร้าง รีโนเวท ต่อเติม ซ่อมแซม ก่อนจ่ายเงิน</span><span class="lang-en block">Independent QC for build, renovation and repair work before payment.</span></p>
            <span class="more"><span class="lang-th">ดูเพิ่มเติม</span><span class="lang-en">Learn more</span> →</span>
          </a>

        </div>
      </div>
    </section>

    <!-- ============ STATS (navy band) ============ -->
    <section class="section tight navy">
      <div class="container">
        <div class="stats">
          <div class="s"><b>800+</b><span class="lang-th">บ้าน/คอนโดที่ตรวจแล้ว</span><span class="lang-en">homes &amp; condos inspected</span></div>
          <div class="s"><b>10+</b><span class="lang-th">ปีงานตรวจและก่อสร้าง</span><span class="lang-en">years in inspection &amp; construction</span></div>
          <div class="s"><b>2</b><span class="lang-th">รอบตรวจ ก่อน-หลังแก้ไข</span><span class="lang-en">rounds: initial &amp; re-inspection</span></div>
          <div class="s"><b>100%</b><span class="lang-th">เป็นกลาง ไม่เข้าข้างผู้รับเหมา</span><span class="lang-en">independent &amp; unbiased</span></div>
        </div>
      </div>
    </section>

    <!-- ============ WHY US ============ -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">จุดเด่นของเรา</span><span class="lang-en">Why choose us</span></span>
          <h2 class="section-title"><span class="lang-th">ทำไมต้อง WHAT THE HOUSE</span><span class="lang-en">Why WHAT THE HOUSE</span></h2>
        </div>
        <div class="grid grid-3">
          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <div>
              <h4><span class="lang-th">ตรวจละเอียดทุกระบบ</span><span class="lang-en">Detailed, system by system</span></h4>
              <p><span class="lang-th">โครงสร้าง สถาปัตย์ ไฟฟ้า ประปา หลังคา รั่วซึม ครบทุกจุด</span><span class="lang-en block">Structure, electrics, plumbing, roof and leak testing — nothing skipped.</span></p>
            </div>
          </div>

          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/></svg></div>
            <div>
              <h4><span class="lang-th">รายงาน PDF ไทย–อังกฤษ</span><span class="lang-en">Thai–English PDF report</span></h4>
              <p><span class="lang-th">พร้อมรูปภาพและคำอธิบายชัดเจน ส่งภายใน 1–3 วัน</span><span class="lang-en block">With photos and clear notes, delivered within 1–3 days.</span></p>
            </div>
          </div>

          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4-9 4z"/><path d="M3 7v6l9 4 9-4V7"/></svg></div>
            <div>
              <h4><span class="lang-th">ใช้อุปกรณ์เฉพาะทาง</span><span class="lang-en">Specialized equipment</span></h4>
              <p><span class="lang-th">เครื่องมือมาตรฐานช่วยให้ตรวจพบปัญหาที่มองด้วยตาไม่เห็น</span><span class="lang-en block">Professional tools reveal issues the eye can't catch.</span></p>
            </div>
          </div>

          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.2-8.6"/><path d="M21 4l-9 9-3-3"/></svg></div>
            <div>
              <h4><span class="lang-th">ตรวจ 2 รอบ</span><span class="lang-en">Two inspection rounds</span></h4>
              <p><span class="lang-th">รอบก่อนรับมอบ และรอบหลังแก้ไข เพื่อให้แน่ใจก่อนเซ็นรับ</span><span class="lang-en block">Initial check and a re-inspection after fixes, before you sign.</span></p>
            </div>
          </div>

          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg></div>
            <div>
              <h4><span class="lang-th">เป็นกลาง 100%</span><span class="lang-en">Fully independent</span></h4>
              <p><span class="lang-th">เราดูแลผลประโยชน์ของเจ้าของบ้าน ไม่โจมตีและไม่เข้าข้างใคร</span><span class="lang-en block">We protect the homeowner's interests — never taking sides.</span></p>
            </div>
          </div>

          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
            <div>
              <h4><span class="lang-th">อธิบายให้เข้าใจง่าย</span><span class="lang-en">Easy to understand</span></h4>
              <p><span class="lang-th">ไม่ใช้ศัพท์เทคนิคมากเกินไป เหมาะกับลูกค้าที่ไม่ใช่สายช่าง</span><span class="lang-en block">No heavy jargon — perfect for non-technical buyers.</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">ขั้นตอนการทำงาน</span><span class="lang-en">How it works</span></span>
          <h2 class="section-title"><span class="lang-th">ตรวจบ้านกับเรา ง่ายใน 4 ขั้นตอน</span><span class="lang-en">Four simple steps</span></h2>
        </div>
        <div class="steps">
          <div class="step">
            <div class="n">1</div>
            <h4><span class="lang-th">ติดต่อ &amp; จองคิว</span><span class="lang-en">Contact &amp; book</span></h4>
            <p><span class="lang-th">แจ้งประเภททรัพย์ ขนาดพื้นที่ และวันที่ต้องการตรวจ</span><span class="lang-en block">Tell us the property type, size and preferred date.</span></p>
          </div>
          <div class="step">
            <div class="n">2</div>
            <h4><span class="lang-th">ลงตรวจหน้างาน</span><span class="lang-en">On-site inspection</span></h4>
            <p><span class="lang-th">ทีมเข้าตรวจละเอียดทุกระบบ พร้อมถ่ายรูปทุกจุด</span><span class="lang-en block">Our team inspects every system and photographs each issue.</span></p>
          </div>
          <div class="step">
            <div class="n">3</div>
            <h4><span class="lang-th">รับรายงาน PDF</span><span class="lang-en">Receive PDF report</span></h4>
            <p><span class="lang-th">สรุปปัญหาและแนวทางแก้ไข ไทย–อังกฤษ ภายใน 1–3 วัน</span><span class="lang-en block">A bilingual report with fixes within 1–3 days.</span></p>
          </div>
          <div class="step">
            <div class="n">4</div>
            <h4><span class="lang-th">ตรวจรอบแก้ไข</span><span class="lang-en">Re-inspection</span></h4>
            <p><span class="lang-th">กลับมาตรวจซ้ำหลังผู้รับเหมาแก้ไข ก่อนคุณเซ็นรับมอบ</span><span class="lang-en block">We re-check after repairs, before you accept the home.</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ REVIEWS ============ -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">เสียงจากลูกค้า</span><span class="lang-en">Reviews</span></span>
          <h2 class="section-title"><span class="lang-th">ลูกค้าที่ไว้ใจให้เราตรวจ</span><span class="lang-en">Trusted by our clients</span></h2>
        </div>
        <div class="grid grid-3">
          <div class="review">
            <div class="stars">★★★★★</div>
            <p><span class="lang-th">"ตรวจละเอียดมาก เจอจุดที่เราไม่เคยสังเกต รายงานอ่านง่าย มีรูปครบ คุ้มมากครับ"</span><span class="lang-en block">"Incredibly thorough — they found issues we'd never have spotted. The report was clear and full of photos."</span></p>
            <div class="who">
              <div class="av">K</div>
              <div>
                <b>คุณกฤต</b>
                <span><span class="lang-th">ตรวจบ้านก่อนโอน เชียงใหม่</span><span class="lang-en">Pre-transfer inspection, Chiang Mai</span></span>
              </div>
            </div>
          </div>
          <div class="review">
            <div class="stars">★★★★★</div>
            <p><span class="lang-th">"จองคิวง่าย ทีมงานมืออาชีพ อธิบายให้ฟังเข้าใจ ไม่ใช้ศัพท์ยาก แนะนำเลย"</span><span class="lang-en block">"Easy to book, very professional, and they explained everything in plain language. Highly recommend."</span></p>
            <div class="who">
              <div class="av">N</div>
              <div>
                <b>คุณนภา</b>
                <span><span class="lang-th">ตรวจคอนโดก่อนรับมอบ</span><span class="lang-en">Condo handover inspection</span></span>
              </div>
            </div>
          </div>
          <div class="review">
            <div class="stars">★★★★★</div>
            <p>"Bilingual report was perfect for us as foreign buyers. Professional and fair — exactly what we needed."</p>
            <div class="who">
              <div class="av">J</div>
              <div>
                <b>James W.</b>
                <span><span class="lang-th">ชาวต่างชาติ ซื้อคอนโดเชียงใหม่</span><span class="lang-en">Foreign buyer, Chiang Mai condo</span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ AREAS ============ -->
    <section class="section tight">
      <div class="container">
        <div class="section-head" style="margin-bottom:28px">
          <h2 class="section-title"><span class="lang-th">พื้นที่ให้บริการ</span><span class="lang-en">Service areas</span></h2>
          <p><span class="lang-th">พื้นที่อื่น ๆ สอบถามเพิ่มเติมได้</span><span class="lang-en block">Other areas — just ask us.</span></p>
        </div>
        <div class="areas">
