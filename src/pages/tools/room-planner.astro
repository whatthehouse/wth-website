---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Furniture catalogue — real Thai-market sizes in centimetres.
// w = width, d = depth, as seen with the item's FRONT facing down the screen.
// `clear` = the free space a person needs in front of / beside the item to use it:
//   s    = sides that need the space (front / back / left / right)
//   d    = how deep that space must be (cm)
//   any  = only ONE of the listed sides needs to be free (e.g. getting into bed)
//   from = side zones start this far along the item (0 = back edge), so a
//          nightstand at the bed head does not count as blocking access
// `tall` = full-height furniture that should not stand in front of a window.
const CATALOG = {
  bed6:      { th: 'เตียง 6 ฟุต',        en: 'King bed (6 ft)',     w: 180, d: 200, clear: [
               { s: ['front'], d: 60, th: 'ปลายเตียงควรเว้นทางเดินอย่างน้อย 60 ซม.', en: 'leave at least 60 cm to walk past the foot of the bed' },
               { s: ['left', 'right'], d: 50, any: true, from: 0.35, th: 'ควรมีทางขึ้น-ลงเตียงอย่างน้อย 1 ด้าน กว้าง 50 ซม.', en: 'needs at least one 50 cm side to get in and out' } ] },
  bed5:      { th: 'เตียง 5 ฟุต',        en: 'Queen bed (5 ft)',    w: 150, d: 200, clear: [
               { s: ['front'], d: 60, th: 'ปลายเตียงควรเว้นทางเดินอย่างน้อย 60 ซม.', en: 'leave at least 60 cm to walk past the foot of the bed' },
               { s: ['left', 'right'], d: 50, any: true, from: 0.35, th: 'ควรมีทางขึ้น-ลงเตียงอย่างน้อย 1 ด้าน กว้าง 50 ซม.', en: 'needs at least one 50 cm side to get in and out' } ] },
  bed35:     { th: 'เตียง 3.5 ฟุต',      en: 'Single bed (3.5 ft)', w: 105, d: 200, clear: [
               { s: ['left', 'right'], d: 50, any: true, from: 0.35, th: 'ควรมีทางขึ้น-ลงเตียงอย่างน้อย 1 ด้าน กว้าง 50 ซม.', en: 'needs at least one 50 cm side to get in and out' } ] },
  nightstand:{ th: 'โต๊ะข้างเตียง',      en: 'Nightstand',          w: 45,  d: 40,  clear: [] },
  wardrobe:  { th: 'ตู้เสื้อผ้า',         en: 'Wardrobe',            w: 120, d: 60,  tall: true, clear: [
               { s: ['front'], d: 60, th: 'หน้าตู้ควรเว้นอย่างน้อย 60 ซม. เพื่อเปิดบานตู้ได้สุด', en: 'leave 60 cm in front so the doors open fully' } ] },
  dresser:   { th: 'โต๊ะเครื่องแป้ง',     en: 'Dressing table',      w: 100, d: 45,  clear: [
               { s: ['front'], d: 60, th: 'หน้าโต๊ะควรเว้น 60 ซม. สำหรับนั่ง', en: 'leave 60 cm in front to sit down' } ] },
  desk:      { th: 'โต๊ะทำงาน',          en: 'Desk',                w: 120, d: 60,  clear: [
               { s: ['front'], d: 70, th: 'หน้าโต๊ะควรเว้น 70 ซม. สำหรับเลื่อนเก้าอี้', en: 'leave 70 cm in front to pull the chair out' } ] },
  sofa3:     { th: 'โซฟา 3 ที่นั่ง',      en: '3-seat sofa',         w: 200, d: 85,  clear: [
               { s: ['front'], d: 40, th: 'หน้าโซฟาควรเว้น 40 ซม. สำหรับวางขาและเดินผ่าน', en: 'leave 40 cm in front for legs and passing' } ] },
  sofa2:     { th: 'โซฟา 2 ที่นั่ง',      en: '2-seat sofa',         w: 150, d: 85,  clear: [
               { s: ['front'], d: 40, th: 'หน้าโซฟาควรเว้น 40 ซม. สำหรับวางขาและเดินผ่าน', en: 'leave 40 cm in front for legs and passing' } ] },
  coffee:    { th: 'โต๊ะกลาง',           en: 'Coffee table',        w: 100, d: 50,  clear: [] },
  tv:        { th: 'ชั้นวางทีวี',         en: 'TV cabinet',          w: 160, d: 40,  clear: [] },
  dining4:   { th: 'โต๊ะอาหาร 4 ที่',     en: 'Dining table (4)',    w: 120, d: 75,  clear: [
               { s: ['front'], d: 60, th: 'ด้านเก้าอี้ควรเว้น 60 ซม. สำหรับเลื่อนเก้าอี้', en: 'leave 60 cm on the chair side to pull chairs out' },
               { s: ['back'],  d: 60, th: 'ด้านเก้าอี้ควรเว้น 60 ซม. สำหรับเลื่อนเก้าอี้', en: 'leave 60 cm on the chair side to pull chairs out' } ] },
  fridge:    { th: 'ตู้เย็น',             en: 'Fridge',              w: 70,  d: 70,  tall: true, clear: [
               { s: ['front'], d: 70, th: 'หน้าตู้เย็นควรเว้น 70 ซม. เพื่อเปิดประตูได้สุด', en: 'leave 70 cm in front so the door opens fully' } ] },
  washer:    { th: 'เครื่องซักผ้า',       en: 'Washing machine',     w: 60,  d: 60,  clear: [
               { s: ['front'], d: 60, th: 'หน้าเครื่องควรเว้น 60 ซม. สำหรับเปิดฝาและหยิบผ้า', en: 'leave 60 cm in front to open it and load laundry' } ] },
};
const OPENINGS = {
  door:   { th: 'ประตู',     en: 'Door',   w: 80 },
  window: { th: 'หน้าต่าง',  en: 'Window', w: 120 },
};

// Ready-made rooms for step 1 (size measured wall-centre to wall-centre, cm).
const ROOM_PRESETS = [
  { th: 'ห้องนอน',     en: 'Bedroom',     w: 310, h: 360 },
  { th: 'ห้องนั่งเล่น', en: 'Living room', w: 400, h: 420 },
  { th: 'ห้องครัว',    en: 'Kitchen',     w: 250, h: 300 },
  { th: 'ห้องน้ำ',     en: 'Bathroom',    w: 160, h: 210 },
  { th: 'ระเบียง',     en: 'Balcony',     w: 150, h: 300 },
];
const ROOM_NAMES = ['ห้องนอน', 'ห้องนอนใหญ่', 'ห้องนั่งเล่น', 'ห้องครัว', 'ห้องทานข้าว', 'ห้องน้ำ', 'ห้องทำงาน', 'ห้องเก็บของ', 'ห้องซักล้าง', 'ระเบียง', 'ทางเดิน',
  'Bedroom', 'Living room', 'Kitchen', 'Dining room', 'Bathroom', 'Study', 'Storage', 'Laundry', 'Balcony', 'Hallway'];

// Sample plans. Rooms are rectangles on wall centre-lines (walls are 10 cm thick,
// so the usable floor is 5 cm in from each line). Openings sit on one room's wall
// at `pos` cm along it. Furniture is { t, cx, cy, rot }: centre point in cm and
// rotation in degrees clockwise (0 = the front faces down the screen).
const TEMPLATES = {
  condo1: { th: 'คอนโด 1 ห้องนอน', en: '1-bedroom condo',
    rooms: [
      { key: 'living', th: 'ห้องนั่งเล่น + ครัว', en: 'Living & kitchen', x: 0,   y: 0,   w: 400, h: 530 },
      { key: 'bed',    th: 'ห้องนอน',           en: 'Bedroom',          x: 400, y: 0,   w: 350, h: 350 },
      { key: 'bath',   th: 'ห้องน้ำ',            en: 'Bathroom',         x: 400, y: 350, w: 200, h: 180 },
    ],
    open: [
      { t: 'door',   room: 'living', wall: 'bottom', pos: 80,  w: 90 },
      { t: 'window', room: 'living', wall: 'left',   pos: 220, w: 200 },
      { t: 'door',   room: 'bed',    wall: 'left',   pos: 280, w: 80 },
      { t: 'window', room: 'bed',    wall: 'top',    pos: 175, w: 180 },
      { t: 'door',   room: 'bath',   wall: 'top',    pos: 150, w: 70 },
    ],
    items: [
      { t: 'sofa3', cx: 47.5, cy: 200, rot: 270 },
      { t: 'coffee', cx: 160, cy: 200, rot: 90 },
      { t: 'tv', cx: 375, cy: 150, rot: 90 },
      { t: 'dining4', cx: 250, cy: 410, rot: 0 },
      { t: 'fridge', cx: 360, cy: 490, rot: 90 },
      { t: 'bed5', cx: 575, cy: 105, rot: 0 },
      { t: 'nightstand', cx: 477.5, cy: 25, rot: 0 },
      { t: 'nightstand', cx: 672.5, cy: 25, rot: 0 },
      { t: 'wardrobe', cx: 715, cy: 280, rot: 90 },
    ] },
  bedroom: { th: 'ห้องนอนเดี่ยว', en: 'Single bedroom',
    rooms: [ { key: 'bed', th: 'ห้องนอน', en: 'Bedroom', x: 0, y: 0, w: 310, h: 360 } ],
    open: [
      { t: 'window', room: 'bed', wall: 'top',    pos: 155, w: 150 },
      { t: 'door',   room: 'bed', wall: 'bottom', pos: 245, w: 80 },
    ],
    items: [
      { t: 'bed5', cx: 155, cy: 105, rot: 0 },
      { t: 'nightstand', cx: 57.5, cy: 25, rot: 0 },
      { t: 'nightstand', cx: 252.5, cy: 25, rot: 0 },
      { t: 'wardrobe', cx: 35, cy: 275, rot: 270 },
    ] },
};
---
<BaseLayout
  title="วาดแปลนห้องและจัดวางเฟอร์นิเจอร์ออนไลน์ ฟรี | WHAT THE HOUSE"
  description="วาดแปลนบ้านหรือคอนโดง่าย ๆ แล้วลองจัดวางเฟอร์นิเจอร์ขนาดจริงด้วยตัวเอง ฟรี ไม่ต้องสมัคร พร้อมเตือนเมื่อทางเดินแคบ ประตูเปิดชน หรือเปิดตู้ไม่สุด บันทึกเป็นรูปภาพได้ | Free floor plan & furniture layout planner"
>
  <Header />
  <main>

    <!-- PAGE HERO -->
    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/">หน้าแรก</a> / <a href="/tools"><span class="lang-th">เครื่องมือ</span><span class="lang-en">Tools</span></a> / <span class="lang-th">วาดแปลน &amp; จัดเฟอร์นิเจอร์</span><span class="lang-en">Room Planner</span></p>
        <span class="eyebrow"><span class="lang-th">เครื่องมือ · ต้นแบบ</span><span class="lang-en">Free Tool · Beta</span></span>
        <h1><span class="lang-th">วาดแปลนห้อง<br>แล้วลองจัดเฟอร์นิเจอร์</span><span class="lang-en">Sketch your floor plan, then plan the furniture</span></h1>
        <p><span class="lang-th">วาดแปลนคร่าว ๆ ของบ้านหรือคอนโด แล้วลากวางเฟอร์นิเจอร์ขนาดจริง ระบบช่วยเช็กว่าวางแล้ว<b>ใช้ชีวิตได้จริง</b> — ทางเดินพอไหม ประตูเปิดชนไหม ตู้เปิดสุดไหม</span><span class="lang-en block">Sketch a rough plan of your home, then drag in real-size furniture — we check it actually <b>works day to day</b>: enough walkway, doors that open, wardrobes that swing fully.</span></p>
      </div>
    </section>

    <section class="section rp-section">
      <div class="container">
        <div class="rp" id="rp">

          <!-- top bar: steps + samples + undo -->
          <div class="rp-top">
            <div class="rp-steps" role="tablist">
              <button type="button" class="rp-step on" id="rpStepPlan" role="tab">
                <i>1</i><span><span class="lang-th">วาดแปลน</span><span class="lang-en">Draw the plan</span></span>
              </button>
              <span class="rp-step-line"></span>
              <button type="button" class="rp-step" id="rpStepFurn" role="tab">
                <i>2</i><span><span class="lang-th">จัดเฟอร์นิเจอร์</span><span class="lang-en">Add furniture</span></span>
              </button>
            </div>
            <div class="rp-top-right">
              <span class="rp-cap rp-cap-inline"><span class="lang-th">แปลนตัวอย่าง</span><span class="lang-en">Samples</span></span>
              {Object.entries(TEMPLATES).map(([id, t]) => (
                <button type="button" class="rp-chip" data-tpl={id}><span class="lang-th">{t.th}</span><span class="lang-en">{t.en}</span></button>
              ))}
              <button type="button" class="rp-chip rp-undo" id="rpUndo" disabled title="Ctrl/⌘ + Z">↶ <span class="lang-th">ย้อนกลับ</span><span class="lang-en">Undo</span></button>
            </div>
          </div>

          <div class="rp-body">
            <!-- palette: step 1 -->
            <div class="rp-palette" id="rpPalPlan">
              <span class="rp-cap"><span class="lang-th">ห้องสำเร็จรูป</span><span class="lang-en">Quick rooms</span></span>
              <div class="rp-pal-list">
                {ROOM_PRESETS.map((r, i) => (
                  <button type="button" class="rp-add" data-preset={i}>
                    <b><span class="lang-th">{r.th}</span><span class="lang-en">{r.en}</span></b>
                    <small>{(r.w / 100).toFixed(1)}×{(r.h / 100).toFixed(1)} m</small>
                  </button>
                ))}
              </div>
              <span class="rp-cap rp-cap-gap"><span class="lang-th">ประตู &amp; หน้าต่าง</span><span class="lang-en">Doors &amp; windows</span></span>
              <div class="rp-pal-list">
                {Object.entries(OPENINGS).map(([id, c]) => (
                  <button type="button" class="rp-add rp-add-open" data-add={id}>
                    <b><span class="lang-th">{c.th}</span><span class="lang-en">{c.en}</span></b>
                    <small>{c.w} cm</small>
                  </button>
                ))}
              </div>
            </div>

            <!-- palette: step 2 -->
            <div class="rp-palette" id="rpPalFurn" hidden>
              <span class="rp-cap"><span class="lang-th">แตะเพื่อเพิ่ม</span><span class="lang-en">Tap to add</span></span>
              <div class="rp-pal-list rp-pal-scroll">
                {Object.entries(CATALOG).map(([id, c]) => (
                  <button type="button" class="rp-add" data-add={id}>
                    <b><span class="lang-th">{c.th}</span><span class="lang-en">{c.en}</span></b>
                    <small>{c.w}×{c.d}</small>
                  </button>
                ))}
              </div>
            </div>

            <!-- drawing -->
            <div class="rp-main">
              <div class="rp-stage">
                <svg id="rpSvg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Floor plan"></svg>
              </div>

              <div class="rp-selbar" id="rpSel" hidden>
                <div class="rp-sel-info"><b id="rpSelName"></b> <small id="rpSelSize"></small></div>
                <div class="rp-sel-btns">
                  <button type="button" class="rp-btn" data-act="rotate">⟳ <span class="lang-th">หมุน</span><span class="lang-en">Rotate</span></button>
                  <button type="button" class="rp-btn" data-act="dup">⧉ <span class="lang-th">ทำซ้ำ</span><span class="lang-en">Duplicate</span></button>
                  <button type="button" class="rp-btn rp-btn-del" data-act="del">✕ <span class="lang-th">ลบ</span><span class="lang-en">Delete</span></button>
                </div>
              </div>
              <p class="rp-hint" id="rpHintPlan"><span class="lang-th">ลากบนตารางว่างเพื่อวาดห้อง · ลากตัวห้องเพื่อย้าย (วางชิดกันผนังจะต่อกันเอง) · ลากปุ่มสีเขียวที่ขอบเพื่อปรับขนาด · ลากประตู/หน้าต่างไปวางบนผนังไหนก็ได้</span><span class="lang-en block">Drag on empty grid to draw a room · drag a room to move it (rooms snap wall-to-wall) · drag the green handles to resize · drag doors &amp; windows onto any wall</span></p>
              <p class="rp-hint" id="rpHintFurn" hidden><span class="lang-th">ลากเพื่อย้าย · คลิก/แตะสองครั้งเพื่อหมุน · คีย์บอร์ด: ลูกศรขยับ (Shift = ทีละ 25 ซม.), R หมุน, Delete ลบ</span><span class="lang-en block">Drag to move · double-click or double-tap to rotate · keyboard: arrows nudge (Shift = 25 cm), R rotates, Delete removes</span></p>
            </div>

            <!-- side: step 1 -->
            <aside class="rp-side" id="rpPlanSide">
              <div id="rpPlanHelp">
                <h3><span class="lang-th">ขั้นที่ 1: วาดแปลน</span><span class="lang-en">Step 1: draw the plan</span></h3>
                <ol class="rp-steps-help">
                  <li><span class="lang-th"><b>ลากบนตาราง</b>เพื่อวาดห้อง หรือกดเลือกห้องสำเร็จรูป</span><span class="lang-en block"><b>Drag on the grid</b> to draw a room, or tap a quick room.</span></li>
                  <li><span class="lang-th">วาดห้องถัดไป<b>ชิดห้องเดิม</b> ผนังจะต่อกันเป็นแปลนเดียว</span><span class="lang-en block">Draw the next room <b>against the first</b> — the walls join up into one plan.</span></li>
                  <li><span class="lang-th">แตะห้องเพื่อ<b>ตั้งชื่อและใส่ขนาดจริง</b></span><span class="lang-en block">Tap a room to <b>name it and type exact sizes</b>.</span></li>
                  <li><span class="lang-th">เพิ่ม<b>ประตูและหน้าต่าง</b> แล้วลากไปวางบนผนัง</span><span class="lang-en block">Add <b>doors and windows</b> and drag them onto walls.</span></li>
                </ol>
              </div>

              <div class="rp-edit" id="rpRoomEdit" hidden>
                <h3><span class="lang-th">ห้องที่เลือก</span><span class="lang-en">Selected room</span></h3>
                <label class="rp-field">
                  <span class="rp-cap"><span class="lang-th">ชื่อห้อง</span><span class="lang-en">Room name</span></span>
                  <input type="text" id="rpRoomName" list="rpRoomNames" maxlength="30" />
                  <datalist id="rpRoomNames">{ROOM_NAMES.map((n) => <option value={n} />)}</datalist>
                </label>
                <div class="rp-field-row">
                  <label class="rp-field">
                    <span class="rp-cap"><span class="lang-th">กว้าง (ม.)</span><span class="lang-en">Width (m)</span></span>
                    <input type="number" id="rpRoomW" min="1" max="30" step="0.05" inputmode="decimal" />
                  </label>
                  <label class="rp-field">
                    <span class="rp-cap"><span class="lang-th">ยาว (ม.)</span><span class="lang-en">Length (m)</span></span>
                    <input type="number" id="rpRoomL" min="1" max="30" step="0.05" inputmode="decimal" />
                  </label>
                </div>
                <p class="rp-mini"><span class="lang-th">ขนาดวัดจากกึ่งกลางผนัง</span><span class="lang-en">Measured wall-centre to wall-centre</span></p>
                <button type="button" class="rp-btn rp-btn-del" id="rpRoomDel">✕ <span class="lang-th">ลบห้องนี้</span><span class="lang-en">Delete room</span></button>
              </div>

              <div class="rp-edit" id="rpOpenEdit" hidden>
                <h3 id="rpOpenTitle"></h3>
                <label class="rp-field">
                  <span class="rp-cap"><span class="lang-th">ความกว้าง (ซม.)</span><span class="lang-en">Width (cm)</span></span>
                  <input type="number" id="rpOpenW" min="40" max="400" step="5" inputmode="numeric" />
                </label>
                <div class="rp-sel-btns">
                  <button type="button" class="rp-btn" id="rpOpenFlip">⇋ <span class="lang-th">สลับฝั่งบานพับ</span><span class="lang-en">Flip hinge</span></button>
                  <button type="button" class="rp-btn" id="rpOpenOut">⇅ <span class="lang-th">สลับทิศเปิด</span><span class="lang-en">Swing other way</span></button>
                  <button type="button" class="rp-btn rp-btn-del" id="rpOpenDel">✕ <span class="lang-th">ลบ</span><span class="lang-en">Delete</span></button>
                </div>
              </div>

              <div class="rp-summary">
                <span class="rp-cap"><span class="lang-th">ห้องในแปลน</span><span class="lang-en">Rooms in the plan</span></span>
                <ul class="rp-roomlist" id="rpRoomList"></ul>
                <ul class="rp-warns" id="rpPlanWarns"></ul>
              </div>

              <div class="rp-actions">
                <button type="button" class="btn btn-primary" id="rpToFurnish"><span class="lang-th">ถัดไป: จัดเฟอร์นิเจอร์ →</span><span class="lang-en">Next: add furniture →</span></button>
                <button type="button" class="btn btn-ghost" id="rpClearAll"><span class="lang-th">เริ่มวาดใหม่</span><span class="lang-en">Start over</span></button>
              </div>
            </aside>

            <!-- side: step 2 -->
            <aside class="rp-side" id="rpFurnSide" hidden>
              <h3><span class="lang-th">ตรวจความสะดวกในการใช้งาน</span><span class="lang-en">Livability check</span></h3>
              <div class="rp-status" id="rpStatus"></div>
              <ul class="rp-warns" id="rpWarns"></ul>

              <div class="rp-legend">
                <span><i class="lg-ok"></i><span class="lang-th">พื้นที่ใช้งานที่ต้องเว้นไว้</span><span class="lang-en">Space needed to use it</span></span>
                <span><i class="lg-bad"></i><span class="lang-th">ระยะไม่พอ</span><span class="lang-en">Not enough space</span></span>
              </div>

              <div class="rp-actions">
                <button type="button" class="btn btn-primary rp-export"><span class="lang-th">บันทึกเป็นรูปภาพ</span><span class="lang-en">Save as image</span></button>
                <button type="button" class="btn btn-ghost" id="rpToPlan"><span class="lang-th">← กลับไปแก้แปลน</span><span class="lang-en">← Edit the plan</span></button>
                <button type="button" class="btn btn-ghost" id="rpClear"><span class="lang-th">ล้างเฟอร์นิเจอร์</span><span class="lang-en">Clear furniture</span></button>
              </div>
              <p class="rp-note"><span class="lang-th">งานจะถูกเก็บไว้ในเครื่องของคุณอัตโนมัติ ไม่ต้องสมัครสมาชิก และไม่ส่งข้อมูลให้ใคร</span><span class="lang-en block">Your plan is saved on this device automatically — no sign-up, nothing sent anywhere.</span></p>

              <div class="rp-tip"><span class="lang-th">จัดห้องเสร็จแล้ว ก่อนย้ายเข้าให้เราตรวจบ้านให้ก่อน — รอยร้าว รั่วซึม ระบบไฟ เจอก่อนแก้ง่ายกว่า</span><span class="lang-en block">Layout sorted? Have us inspect the home before you move in — cracks, leaks and wiring are far easier to fix before the furniture arrives.</span> <a href="/services"><span class="lang-th">ดูบริการตรวจบ้าน →</span><span class="lang-en">See inspection services →</span></a></div>
            </aside>
          </div>
        </div>

        <p class="rp-disclaimer"><span class="lang-th">เครื่องมือนี้เป็นแบบร่างคร่าว ๆ สำหรับวางแผนจัดเฟอร์นิเจอร์เท่านั้น ไม่ใช่แบบก่อสร้าง ระยะที่แนะนำเป็นค่าทั่วไปเพื่อความสะดวกในการใช้งาน ควรวัดขนาดห้องและเฟอร์นิเจอร์จริงก่อนสั่งซื้อ</span><span class="lang-en block">This is a rough sketch for planning furniture only — not a construction drawing. Recommended clearances are general comfort guidelines; always measure the real room and furniture before buying.</span></p>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
