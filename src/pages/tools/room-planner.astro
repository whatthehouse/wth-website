@media (max-width: 1240px) {
  .rp { padding: 18px; }
  .rp-body { grid-template-columns: minmax(0, 1fr) 250px; gap: 14px 16px; }
  .rp-palette { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; overflow-x: auto; padding-bottom: 4px; -webkit-overflow-scrolling: touch; }
