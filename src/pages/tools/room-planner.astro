    if (!drag.moved && Math.hypot(e.clientX - drag.start.x, e.clientY - drag.start.y) < (drag.touch ? 7 : 3)) return;

    if (drag.kind === 'pan') {
      beginChange();
      const s = drag.cam0.w / stageRect().width;
      cam = { ...cam, x: drag.cam0.x - (e.clientX - drag.start.x) * s, y: drag.cam0.y - (e.clientY - drag.start.y) * s };
      render();
      return;
    }
    if (drag.kind === 'tap') return;
    const p = toWorldPt(e.clientX, e.clientY);

    if (drag.kind === 'draw') {
      beginChange();
      const x1 = snapRoomValue(p.x, roomLines('x')), y1 = snapRoomValue(p.y, roomLines('y'));
      if (x1 !== drag.x1 || y1 !== drag.y1 || !drag.drawn) { drag.x1 = x1; drag.y1 = y1; drag.drawn = true; render(); }
      return;
    }

    if (drag.kind === 'room') {
      const r = roomById(drag.id);
      const x = snapRoomStart(p.x + drag.dx, r.w, roomLines('x', r.id));
      const y = snapRoomStart(p.y + drag.dy, r.h, roomLines('y', r.id));
      if (x === r.x && y === r.y) return;
      beginChange();
      r.x = x; r.y = y;
      drag.carry.forEach((c) => { const it = itemById(c.id); if (it) { it.cx = c.cx + (x - drag.sx); it.cy = c.cy + (y - drag.sy); } });
      render();
      return;
    }

    if (drag.kind === 'resize') {
      const r = roomById(drag.id);
      const lx = roomLines('x', r.id), ly = roomLines('y', r.id);
      const next = { x: r.x, y: r.y, w: r.w, h: r.h };
      // never shrink past the corner cut
      const needW = Math.max(MIN_ROOM, r.cut ? r.cut.w + MIN_LEFT : 0), needH = Math.max(MIN_ROOM, r.cut ? r.cut.h + MIN_LEFT : 0);
      if (drag.edge === 'right') next.w = Math.max(snapRoomValue(p.x, lx), r.x + needW) - r.x;
      if (drag.edge === 'bottom') next.h = Math.max(snapRoomValue(p.y, ly), r.y + needH) - r.y;
      if (drag.edge === 'left') { const right = r.x + r.w; next.x = Math.min(snapRoomValue(p.x, lx), right - needW); next.w = right - next.x; }
      if (drag.edge === 'top') { const bottom = r.y + r.h; next.y = Math.min(snapRoomValue(p.y, ly), bottom - needH); next.h = bottom - next.y; }
