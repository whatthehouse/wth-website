      if (d.moved && r.w >= MIN_ROOM && r.h >= MIN_ROOM) {
        pushHistory();
        const room = { id: uid(), name: `${isEn() ? 'Room' : 'ห้อง'} ${S.rooms.length + 1}`, ...r, cut: null };
        S.rooms.push(room);
