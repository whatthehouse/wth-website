    if (!r || !(cm >= MIN_CUT && cm <= 3000)) return;
    once(); reshape(r, () => apply(r, cm)); commit();
  });
  sizeField('rpRoomW', (r, cm) => { r.w = Math.max(cm, MIN_ROOM, r.cut ? r.cut.w + MIN_LEFT : 0); });
  sizeField('rpRoomL', (r, cm) => { r.h = Math.max(cm, MIN_ROOM, r.cut ? r.cut.h + MIN_LEFT : 0); });
  sizeField('rpCutW', (r, cm) => { if (r.cut) r.cut.w = cm; });
  sizeField('rpCutH', (r, cm) => { if (r.cut) r.cut.h = cm; });
  document.querySelectorAll('#rpShape button').forEach((b) => b.addEventListener('click', () => {
