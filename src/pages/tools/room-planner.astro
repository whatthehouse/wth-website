    if (pointers.size === 2) { startPinch(); return; }
    if (pointers.size > 2 || pinch) return;

    const start = { x: e.clientX, y: e.clientY };
    if (spaceDown || e.button === 1) { drag = { kind: 'pan', start, cam0: { ...cam }, moved: false }; return; }

    const p = toWorldPt(e.clientX, e.clientY);
    const hit = hitTest(p);
    const prevSel = sel;
    drag = null;
    if (hit && hit.kind === 'handle') {
      drag = { kind: 'resize', id: sel, edge: hit.edge };
    } else if (hit && hit.kind === 'open') {
      sel = hit.id; drag = { kind: 'open', id: hit.id };
    } else if (hit && hit.kind === 'item') {
      const it = itemById(hit.id);
      sel = hit.id; drag = { kind: 'item', id: hit.id, dx: it.cx - p.x, dy: it.cy - p.y };
    } else if (hit && hit.kind === 'room') {
      const r = roomById(hit.id);
      if (sel === r.id) {
