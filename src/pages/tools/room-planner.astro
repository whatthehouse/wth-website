  $('rpZoomIn').addEventListener('click', () => zoomAt(1 / 1.3));
  $('rpZoomOut').addEventListener('click', () => zoomAt(1.3));
  $('rpZoomFit').addEventListener('click', () => { fitView(); render(); });

  // ── tap-to-type dimensions ───────────────────────────────────────────────
  const dimInput = $('rpDimInput');
  function dimValue(r, key) { return key === 'w' ? r.w : key === 'h' ? r.h : key === 'cw' ? r.cut.w : r.cut.h; }
  function openDimInput(d) {
    const r = roomById(d.room);
    if (!r || ((d.key === 'cw' || d.key === 'ch') && !r.cut)) return;
    dimEdit = { room: d.room, key: d.key, x: d.x, y: d.y };
