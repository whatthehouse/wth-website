---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Furniture catalogue — real Thai-market sizes in centimetres.
// w = width, d = depth, as seen with the item's FRONT facing down the screen.
// `clear` = the free space a person needs in front of / beside the item to use it:
//   s    = sides that need the space (front / back / left / right)
//   d    = how deep that space must be (cm)
//   any  = only ONE of the listed sides needs to be free (e.g. getting into bed)
//   from = side zones start this far along the item (0 = back edge), so a
//          nightstand at the bed head does not count as blocking access
// `tall` = full-height furniture that should not stand in front of a window.
// `high` = mounted up on a wall (air-con): ignored by floor checks, must touch a wall.
const CATALOG = {
  bed6:      { th: 'เตียง 6 ฟุต',        en: 'King bed (6 ft)',     w: 180, d: 200, clear: [
               { s: ['front'], d: 60, th: 'ปลายเตียงควรเว้นทางเดินอย่างน้อย 60 ซม.', en: 'leave at least 60 cm to walk past the foot of the bed' },
               { s: ['left', 'right'], d: 50, any: true, from: 0.35, th: 'ควรมีทางขึ้น-ลงเตียงอย่างน้อย 1 ด้าน กว้าง 50 ซม.', en: 'needs at least one 50 cm side to get in and out' } ] },
  bed5:      { th: 'เตียง 5 ฟุต',        en: 'Queen bed (5 ft)',    w: 150, d: 200, clear: [
               { s: ['front'], d: 60, th: 'ปลายเตียงควรเว้นทางเดินอย่างน้อย 60 ซม.', en: 'leave at least 60 cm to walk past the foot of the bed' },
               { s: ['left', 'right'], d: 50, any: true, from: 0.35, th: 'ควรมีทางขึ้น-ลงเตียงอย่างน้อย 1 ด้าน กว้าง 50 ซม.', en: 'needs at least one 50 cm side to get in and out' } ] },
  bed35:     { th: 'เตียง 3.5 ฟุต',      en: 'Single bed (3.5 ft)', w: 105, d: 200, clear: [
               { s: ['left', 'right'], d: 50, any: true, from: 0.35, th: 'ควรมีทางขึ้น-ลงเตียงอย่างน้อย 1 ด้าน กว้าง 50 ซม.', en: 'needs at least one 50 cm side to get in and out' } ] },
  nightstand:{ th: 'โต๊ะข้างเตียง',      en: 'Nightstand',          w: 45,  d: 40,  clear: [] },
  wardrobe:  { th: 'ตู้เสื้อผ้า',         en: 'Wardrobe',            w: 120, d: 60,  tall: true, clear: [
               { s: ['front'], d: 60, th: 'หน้าตู้ควรเว้นอย่างน้อย 60 ซม. เพื่อเปิดบานตู้ได้สุด', en: 'leave 60 cm in front so the doors open fully' } ] },
  dresser:   { th: 'โต๊ะเครื่องแป้ง',     en: 'Dressing table',      w: 100, d: 45,  clear: [
               { s: ['front'], d: 60, th: 'หน้าโต๊ะควรเว้น 60 ซม. สำหรับนั่ง', en: 'leave 60 cm in front to sit down' } ] },
  sofa3:     { th: 'โซฟา 3 ที่นั่ง',      en: '3-seat sofa',         w: 200, d: 85,  clear: [
               { s: ['front'], d: 40, th: 'หน้าโซฟาควรเว้น 40 ซม. สำหรับวางขาและเดินผ่าน', en: 'leave 40 cm in front for legs and passing' } ] },
  sofa2:     { th: 'โซฟา 2 ที่นั่ง',      en: '2-seat sofa',         w: 150, d: 85,  clear: [
               { s: ['front'], d: 40, th: 'หน้าโซฟาควรเว้น 40 ซม. สำหรับวางขาและเดินผ่าน', en: 'leave 40 cm in front for legs and passing' } ] },
  coffee:    { th: 'โต๊ะกลาง',           en: 'Coffee table',        w: 100, d: 50,  clear: [] },
  tv:        { th: 'ชั้นวางทีวี',         en: 'TV cabinet',          w: 160, d: 40,  clear: [] },
  dining4:   { th: 'โต๊ะอาหาร 4 ที่',     en: 'Dining table (4)',    w: 120, d: 75,  clear: [
               { s: ['front'], d: 60, th: 'ด้านเก้าอี้ควรเว้น 60 ซม. สำหรับเลื่อนเก้าอี้', en: 'leave 60 cm on the chair side to pull chairs out' },
               { s: ['back'],  d: 60, th: 'ด้านเก้าอี้ควรเว้น 60 ซม. สำหรับเลื่อนเก้าอี้', en: 'leave 60 cm on the chair side to pull chairs out' } ] },
  desk:      { th: 'โต๊ะทำงาน',          en: 'Desk',                w: 120, d: 60,  clear: [
               { s: ['front'], d: 70, th: 'หน้าโต๊ะควรเว้น 70 ซม. สำหรับเลื่อนเก้าอี้', en: 'leave 70 cm in front to pull the chair out' } ] },
  shoe:      { th: 'ชั้นวางรองเท้า',      en: 'Shoe cabinet',        w: 80,  d: 35,  clear: [
               { s: ['front'], d: 50, th: 'หน้าตู้ควรเว้น 50 ซม. สำหรับเปิดบานและนั่งใส่รองเท้า', en: 'leave 50 cm in front to open it and put shoes on' } ] },
  counter:   { th: 'เคาน์เตอร์ครัว',      en: 'Kitchen counter',     w: 180, d: 60,  clear: [
               { s: ['front'], d: 90, th: 'หน้าเคาน์เตอร์ควรเว้น 90 ซม. สำหรับยืนทำครัวและเปิดตู้ล่าง', en: 'leave 90 cm in front to cook and open the base cupboards' } ] },
  fridge:    { th: 'ตู้เย็น',             en: 'Fridge',              w: 70,  d: 70,  tall: true, clear: [
               { s: ['front'], d: 70, th: 'หน้าตู้เย็นควรเว้น 70 ซม. เพื่อเปิดประตูได้สุด', en: 'leave 70 cm in front so the door opens fully' } ] },
  washer:    { th: 'เครื่องซักผ้า',       en: 'Washing machine',     w: 60,  d: 60,  clear: [
               { s: ['front'], d: 60, th: 'หน้าเครื่องควรเว้น 60 ซม. สำหรับเปิดฝาและหยิบผ้า', en: 'leave 60 cm in front to open it and load laundry' } ] },
  toilet:    { th: 'โถส้วม',             en: 'Toilet',              w: 40,  d: 70,  clear: [
               { s: ['front'], d: 60, th: 'หน้าโถส้วมควรเว้นอย่างน้อย 60 ซม.', en: 'leave at least 60 cm in front' } ] },
  basin:     { th: 'อ่างล้างหน้า',        en: 'Washbasin',           w: 60,  d: 45,  clear: [
               { s: ['front'], d: 60, th: 'หน้าอ่างควรเว้น 60 ซม. สำหรับยืนใช้งาน', en: 'leave 60 cm in front to stand at it' } ] },
  shower:    { th: 'ที่อาบน้ำ',           en: 'Shower area',         w: 90,  d: 90,  clear: [
               { s: ['front'], d: 50, th: 'ทางเข้าที่อาบน้ำควรเว้น 50 ซม.', en: 'leave 50 cm to step in and out' } ] },
  aircon:    { th: 'แอร์ติดผนัง',         en: 'Wall air-con',        w: 90,  d: 25,  high: true, clear: [] },
};
const FURN_GROUPS = [
  { th: 'ห้องนอน',            en: 'Bedroom',            ids: ['bed6', 'bed5', 'bed35', 'nightstand', 'wardrobe', 'dresser'] },
  { th: 'นั่งเล่น & ทำงาน',     en: 'Living & work',      ids: ['sofa3', 'sofa2', 'coffee', 'tv', 'dining4', 'desk', 'shoe'] },
  { th: 'ครัว & ซักล้าง',      en: 'Kitchen & laundry',  ids: ['counter', 'fridge', 'washer'] },
  { th: 'ห้องน้ำ',             en: 'Bathroom',           ids: ['toilet', 'basin', 'shower'] },
  { th: 'ติดผนัง',             en: 'Wall-mounted',       ids: ['aircon'] },
];
const OPENINGS = {
  door:   { th: 'ประตู',     en: 'Door',   w: 80 },
  window: { th: 'หน้าต่าง',  en: 'Window', w: 120 },
};

// Ready-made rooms (size measured wall-centre to wall-centre, cm).
const ROOM_PRESETS = [
  { th: 'ห้องนอน',     en: 'Bedroom',     w: 310, h: 360 },
  { th: 'ห้องนั่งเล่น', en: 'Living room', w: 400, h: 420 },
  { th: 'ห้องครัว',    en: 'Kitchen',     w: 250, h: 300 },
  { th: 'ห้องน้ำ',     en: 'Bathroom',    w: 160, h: 210 },
  { th: 'ระเบียง',     en: 'Balcony',     w: 150, h: 300 },
];
const ROOM_NAMES = ['ห้องนอน', 'ห้องนอนใหญ่', 'ห้องนั่งเล่น', 'ห้องครัว', 'ห้องทานข้าว', 'ห้องน้ำ', 'ห้องทำงาน', 'ห้องเก็บของ', 'ห้องซักล้าง', 'ระเบียง', 'ทางเดิน',
  'Bedroom', 'Living room', 'Kitchen', 'Dining room', 'Bathroom', 'Study', 'Storage', 'Laundry', 'Balcony', 'Hallway'];

// Sample plans. Rooms are rectangles on wall centre-lines (walls are 10 cm thick) with
// an optional corner cut. Openings sit on edge N of a room's outline — edges run
// clockwise from the top-left, so a plain rectangle is 0 top, 1 right, 2 bottom, 3 left —
// at `pos` cm along it. Furniture is { t, cx, cy, rot }: centre point in cm and
// rotation in degrees clockwise (0 = the front faces down the screen).
const TEMPLATES = {
  condo1: { th: 'คอนโด 1 ห้องนอน', en: '1-bedroom condo',
    rooms: [
      { key: 'living', th: 'ห้องนั่งเล่น + ครัว', en: 'Living & kitchen', x: 0,   y: 0,   w: 400, h: 530 },
      { key: 'bed',    th: 'ห้องนอน',           en: 'Bedroom',          x: 400, y: 0,   w: 350, h: 350 },
      { key: 'bath',   th: 'ห้องน้ำ',            en: 'Bathroom',         x: 400, y: 350, w: 200, h: 180 },
    ],
    open: [
      { t: 'door',   room: 'living', edge: 2, pos: 320, w: 90, flip: true },
      { t: 'window', room: 'living', edge: 3, pos: 310, w: 200 },
      { t: 'door',   room: 'bed',    edge: 3, pos: 70,  w: 80, flip: true },
      { t: 'window', room: 'bed',    edge: 0, pos: 175, w: 180 },
      { t: 'door',   room: 'bath',   edge: 0, pos: 150, w: 70 },
    ],
    items: [
      { t: 'sofa3', cx: 47.5, cy: 200, rot: 270 },
      { t: 'coffee', cx: 160, cy: 200, rot: 90 },
      { t: 'tv', cx: 375, cy: 150, rot: 90 },
      { t: 'dining4', cx: 185, cy: 390, rot: 0 },
      { t: 'counter', cx: 365, cy: 340, rot: 90 },
      { t: 'fridge', cx: 360, cy: 490, rot: 90 },
      { t: 'bed5', cx: 575, cy: 105, rot: 0 },
      { t: 'nightstand', cx: 477.5, cy: 25, rot: 0 },
      { t: 'nightstand', cx: 672.5, cy: 25, rot: 0 },
      { t: 'wardrobe', cx: 715, cy: 280, rot: 90 },
      { t: 'aircon', cx: 732.5, cy: 105, rot: 90 },
      { t: 'toilet', cx: 440, cy: 490, rot: 180 },
      { t: 'basin', cx: 572.5, cy: 460, rot: 90 },
    ] },
  bedroom: { th: 'ห้องนอนเดี่ยว', en: 'Single bedroom',
    rooms: [ { key: 'bed', th: 'ห้องนอน', en: 'Bedroom', x: 0, y: 0, w: 310, h: 360 } ],
    open: [
      { t: 'window', room: 'bed', edge: 0, pos: 155, w: 150 },
      { t: 'door',   room: 'bed', edge: 2, pos: 65,  w: 80, flip: true },
    ],
    items: [
      { t: 'bed5', cx: 155, cy: 105, rot: 0 },
      { t: 'nightstand', cx: 57.5, cy: 25, rot: 0 },
      { t: 'nightstand', cx: 252.5, cy: 25, rot: 0 },
      { t: 'wardrobe', cx: 35, cy: 275, rot: 270 },
      { t: 'aircon', cx: 17.5, cy: 145, rot: 270 },
    ] },
};
---
<BaseLayout
  title="วาดแปลนห้องและจัดวางเฟอร์นิเจอร์ออนไลน์ ฟรี | WHAT THE HOUSE"
  description="วาดแปลนบ้านหรือคอนโดง่าย ๆ แล้วลองจัดวางเฟอร์นิเจอร์ขนาดจริงในหน้าเดียว ฟรี ไม่ต้องสมัคร พร้อมเตือนเมื่อทางเดินแคบ ประตูเปิดชน หรือเปิดตู้ไม่สุด บันทึกเป็นรูปภาพได้ | Free floor plan & furniture layout planner"
>
  <Header />
  <main>

    <!-- PAGE HERO -->
    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/">หน้าแรก</a> / <a href="/tools"><span class="lang-th">เครื่องมือ</span><span class="lang-en">Tools</span></a> / <span class="lang-th">วาดแปลน &amp; จัดเฟอร์นิเจอร์</span><span class="lang-en">Room Planner</span></p>
        <span class="eyebrow"><span class="lang-th">เครื่องมือ · ต้นแบบ</span><span class="lang-en">Free Tool · Beta</span></span>
        <h1><span class="lang-th">วาดแปลนห้อง<br>และจัดเฟอร์นิเจอร์ในหน้าเดียว</span><span class="lang-en">Sketch your floor plan and furniture in one place</span></h1>
        <p><span class="lang-th">วาดแปลนคร่าว ๆ ของบ้านหรือคอนโด ลากวางเฟอร์นิเจอร์ขนาดจริง แล้วให้ระบบช่วยเช็กว่า<b>ใช้ชีวิตได้จริง</b> — ทางเดินพอไหม ประตูเปิดชนไหม ตู้เปิดสุดไหม</span><span class="lang-en block">Sketch a rough plan of your home, drag in real-size furniture, and we check it actually <b>works day to day</b>: enough walkway, doors that open, wardrobes that swing fully.</span></p>
      </div>
    </section>

    <section class="section rp-section">
      <div class="container">
        <div class="rp" id="rp">

          <!-- top bar -->
          <div class="rp-top">
            <div class="rp-top-left">
              <span class="rp-cap rp-cap-inline"><span class="lang-th">แปลนตัวอย่าง</span><span class="lang-en">Samples</span></span>
              {Object.entries(TEMPLATES).map(([id, t]) => (
                <button type="button" class="rp-chip" data-tpl={id}><span class="lang-th">{t.th}</span><span class="lang-en">{t.en}</span></button>
              ))}
            </div>
            <button type="button" class="rp-chip rp-undo" id="rpUndo" disabled title="Ctrl/⌘ + Z">↶ <span class="lang-th">ย้อนกลับ</span><span class="lang-en">Undo</span></button>
          </div>

          <div class="rp-body">
            <!-- palette -->
            <div class="rp-palette">
              <div class="rp-pal-group">
                <span class="rp-cap"><span class="lang-th">ห้องสำเร็จรูป</span><span class="lang-en">Quick rooms</span></span>
                <div class="rp-pal-list">
                  {ROOM_PRESETS.map((r, i) => (
                    <button type="button" class="rp-add rp-add-room" data-preset={i}>
                      <b><span class="lang-th">{r.th}</span><span class="lang-en">{r.en}</span></b>
                      <small>{(r.w / 100).toFixed(1)}×{(r.h / 100).toFixed(1)} m</small>
                    </button>
                  ))}
                </div>
              </div>
              <div class="rp-pal-group">
                <span class="rp-cap"><span class="lang-th">ประตู &amp; หน้าต่าง</span><span class="lang-en">Doors &amp; windows</span></span>
                <div class="rp-pal-list">
                  {Object.entries(OPENINGS).map(([id, c]) => (
                    <button type="button" class="rp-add rp-add-open" data-add={id}>
                      <b><span class="lang-th">{c.th}</span><span class="lang-en">{c.en}</span></b>
                      <small>{c.w} cm</small>
                    </button>
                  ))}
                </div>
              </div>
              {FURN_GROUPS.map((g) => (
                <div class="rp-pal-group">
                  <span class="rp-cap"><span class="lang-th">{g.th}</span><span class="lang-en">{g.en}</span></span>
                  <div class="rp-pal-list">
                    {g.ids.map((id) => (
                      <button type="button" class="rp-add" data-add={id}>
                        <b><span class="lang-th">{CATALOG[id].th}</span><span class="lang-en">{CATALOG[id].en}</span></b>
                        <small>{CATALOG[id].w}×{CATALOG[id].d}</small>
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            <!-- drawing -->
            <div class="rp-main">
              <div class="rp-stage" id="rpStage">
                <svg id="rpSvg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Floor plan"></svg>
                <div class="rp-zoom">
                  <button type="button" id="rpZoomOut" aria-label="Zoom out">−</button>
                  <button type="button" id="rpZoomFit" aria-label="Fit plan"><span class="lang-th">พอดี</span><span class="lang-en">Fit</span></button>
                  <button type="button" id="rpZoomIn" aria-label="Zoom in">+</button>
                </div>
                <input type="number" id="rpDimInput" class="rp-dim-input" step="0.05" min="0.3" max="30" inputmode="decimal" enterkeyhint="done" hidden />
              </div>

              <div class="rp-selbar" id="rpSel" hidden>
                <div class="rp-sel-info"><b id="rpSelName"></b> <small id="rpSelSize"></small></div>
                <div class="rp-sel-btns">
                  <button type="button" class="rp-btn" data-act="rotate">⟳ <span class="lang-th">หมุน</span><span class="lang-en">Rotate</span></button>
                  <button type="button" class="rp-btn" data-act="dup">⧉ <span class="lang-th">ทำซ้ำ</span><span class="lang-en">Duplicate</span></button>
                  <button type="button" class="rp-btn rp-btn-del" data-act="del">✕ <span class="lang-th">ลบ</span><span class="lang-en">Delete</span></button>
                </div>
              </div>
              <p class="rp-hint"><span class="lang-th">ลากบนพื้นที่ว่างเพื่อวาดห้อง · แตะห้องเพื่อเลือก แล้วลากเพื่อย้ายหรือลากปุ่มเขียวเพื่อปรับขนาด · <b>แตะตัวเลขระยะเพื่อพิมพ์ขนาด</b> · ลากเฟอร์นิเจอร์ได้ทันที แตะสองครั้งเพื่อหมุน · iPad: <b>ใช้สองนิ้วซูมและเลื่อน</b> · คอมพิวเตอร์: Ctrl/⌘ + สกรอลล์เพื่อซูม, กด Space ค้างแล้วลากเพื่อเลื่อน</span><span class="lang-en block">Drag on empty space to draw a room · tap a room to select it, then drag to move or pull the green handles to resize · <b>tap a dimension to type a size</b> · drag furniture straight away, double-tap to rotate · iPad: <b>two fingers to zoom and pan</b> · computer: Ctrl/⌘ + scroll to zoom, hold Space and drag to pan</span></p>
            </div>

            <!-- side panel -->
            <aside class="rp-side">
              <div id="rpHelp">
                <h3><span class="lang-th">เริ่มต้นใช้งาน</span><span class="lang-en">How it works</span></h3>
                <ol class="rp-steps-help">
                  <li><span class="lang-th"><b>ลากบนพื้นที่ว่าง</b>เพื่อวาดห้อง หรือกดห้องสำเร็จรูป วาดห้องถัดไปชิดกันผนังจะต่อกันเอง</span><span class="lang-en block"><b>Drag on empty space</b> to draw a room, or tap a quick room. Rooms drawn side by side join up.</span></li>
                  <li><span class="lang-th">แตะห้องเพื่อ<b>ตั้งชื่อ ใส่ขนาด</b> หรือเปลี่ยนเป็น<b>ห้องตัว L / มุมเฉียง</b></span><span class="lang-en block">Tap a room to <b>name it, set sizes</b> or make it <b>L-shaped / angled</b>.</span></li>
                  <li><span class="lang-th">เพิ่ม<b>ประตูและหน้าต่าง</b> แล้วลากไปวางบนผนัง</span><span class="lang-en block">Add <b>doors and windows</b> and drag them onto walls.</span></li>
                  <li><span class="lang-th">เพิ่ม<b>เฟอร์นิเจอร์</b> แล้วดูผลตรวจความสะดวกด้านล่าง</span><span class="lang-en block">Add <b>furniture</b> and watch the livability check below.</span></li>
                </ol>
              </div>

              <div class="rp-edit" id="rpRoomEdit" hidden>
                <h3><span class="lang-th">ห้องที่เลือก</span><span class="lang-en">Selected room</span></h3>
                <label class="rp-field">
                  <span class="rp-cap"><span class="lang-th">ชื่อห้อง</span><span class="lang-en">Room name</span></span>
                  <input type="text" id="rpRoomName" list="rpRoomNames" maxlength="30" />
                  <datalist id="rpRoomNames">{ROOM_NAMES.map((n) => <option value={n} />)}</datalist>
                </label>
                <div class="rp-field-row">
                  <label class="rp-field">
                    <span class="rp-cap"><span class="lang-th">กว้าง (ม.)</span><span class="lang-en">Width (m)</span></span>
                    <input type="number" id="rpRoomW" min="1" max="30" step="0.05" inputmode="decimal" />
                  </label>
                  <label class="rp-field">
