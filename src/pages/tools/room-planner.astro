</style>

<script define:vars={{ CATALOG, OPENINGS, TEMPLATES, ROOM_PRESETS }}>
(function () {
  const $ = (id) => document.getElementById(id);
  const svg = $('rpSvg');
  if (!svg) return;

  const STORE_KEY = 'wth-room-planner-v2';
  const WALL = 10, HW = WALL / 2;          // walls are drawn centred on the room lines
  const GRID = 5, MAGNET = 8;              // furniture snapping (cm)
  const ROOM_GRID = 10, ROOM_MAGNET = 20;  // room snapping (cm) — generous so walls join up
  const MIN_ROOM = 100, PAD = 70;
  // same face as the site (Prompt); system fonts cover the exported image, where web fonts can't load
  const FONT = "Prompt, system-ui, 'Segoe UI', Tahoma, sans-serif";
  const C = {
    paper: '#ffffff', paperGrid: '#eff0ec', paperGrid2: '#dfe2dc',
    floor: '#fbfaf6', grid: '#ecebe4', grid2: '#d9d6cb', wall: '#2b302d', item: '#e4eee7', itemStroke: '#5b6a61',
    sel: '#12995a', bad: '#d9434a', badFill: '#fde6e6', zoneOk: 'rgba(18,153,90,.14)', zoneBad: 'rgba(217,67,74,.22)',
    roomSel: 'rgba(18,153,90,.08)', text: '#2b302d', dim: '#6b726d', glass: '#dcecf7', glassLine: '#6aa8d2',
  };

  const isEn = () => document.body.classList.contains('en');
  const uid = () => Math.random().toString(36).slice(2, 9);
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const f = (n) => Math.round(n * 10) / 10;
  const m2 = (cm) => (cm / 100).toFixed(2);

  // ── state ────────────────────────────────────────────────────────────────
  // S = { step:'plan'|'furnish', rooms:[{id,name,x,y,w,h}],
  //       open:[{id,t,room,wall,pos,w,flip,out}], items:[{id,t,cx,cy,rot}] }
  let S = null;
  let sel = null;        // selected room / opening / item id
  let drag = null;
  let frozenVB = null;   // the view is held still while dragging so the pointer never slips
  let pxPerCm = 0.6;
  const history = [];

  const blank = () => ({ step: 'plan', rooms: [], open: [], items: [] });
  function fromTemplate(key) {
    const t = TEMPLATES[key], en = isEn(), ids = {};
    const rooms = t.rooms.map((r) => { const id = uid(); ids[r.key] = id; return { id, name: en ? r.en : r.th, x: r.x, y: r.y, w: r.w, h: r.h }; });
    return {
      step: 'plan', rooms,
      open: t.open.map((o) => ({ id: uid(), t: o.t, room: ids[o.room], wall: o.wall, pos: o.pos, w: o.w, flip: !!o.flip, out: !!o.out })),
      items: t.items.map((i) => ({ id: uid(), ...i })),
    };
  }
  function load() {
    try {
      const d = JSON.parse(localStorage.getItem(STORE_KEY) || 'null');
      if (!d || !Array.isArray(d.rooms) || !Array.isArray(d.open) || !Array.isArray(d.items)) return null;
      d.rooms = d.rooms.filter((r) => [r.x, r.y, r.w, r.h].every((n) => typeof n === 'number') && r.w >= MIN_ROOM && r.h >= MIN_ROOM);
      d.open = d.open.filter((o) => OPENINGS[o.t] && d.rooms.some((r) => r.id === o.room) && ['top', 'bottom', 'left', 'right'].includes(o.wall));
      d.items = d.items.filter((i) => CATALOG[i.t] && [0, 90, 180, 270].includes(i.rot));
      d.step = d.step === 'furnish' && d.rooms.length ? 'furnish' : 'plan';
      return d;
    } catch (e) { return null; }
  }
  function save() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(S)); } catch (e) { /* private mode etc. — still works, just not remembered */ }
  }
  function pushHistory() {
    history.push(JSON.stringify(S));
    if (history.length > 80) history.shift();
  }
  function undo() {
    if (!history.length) return;
    S = JSON.parse(history.pop());
    sel = null; commit();
  }

  // ── geometry ─────────────────────────────────────────────────────────────
  const roomById = (id) => S.rooms.find((r) => r.id === id);
  const itemById = (id) => S.items.find((i) => i.id === id);
  const openById = (id) => S.open.find((o) => o.id === id);
  const nm = (o) => { const c = CATALOG[o.t] || OPENINGS[o.t]; return isEn() ? c.en : c.th; };
  const rectOf = (p, q) => ({ x: Math.min(p.x, q.x), y: Math.min(p.y, q.y), w: Math.abs(p.x - q.x), h: Math.abs(p.y - q.y) });
  const inter = (a, b) => a.x < b.x + b.w - 1 && b.x < a.x + a.w - 1 && a.y < b.y + b.h - 1 && b.y < a.y + a.h - 1;
  const within = (a, b) => a.x >= b.x - 1 && a.y >= b.y - 1 && a.x + a.w <= b.x + b.w + 1 && a.y + a.h <= b.y + b.h + 1;
  const containsPt = (r, x, y) => x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h;
  const interior = (r) => ({ x: r.x + HW, y: r.y + HW, w: r.w - WALL, h: r.h - WALL });
  const roomAt = (x, y) => S.rooms.find((r) => containsPt(interior(r), x, y));

  function planBox() {
    if (!S.rooms.length) return null;
    const x = Math.min(...S.rooms.map((r) => r.x)), y = Math.min(...S.rooms.map((r) => r.y));
    return { x, y, w: Math.max(...S.rooms.map((r) => r.x + r.w)) - x, h: Math.max(...S.rooms.map((r) => r.y + r.h)) - y };
  }

  function bbox(it) {
    const c = CATALOG[it.t];
    const sw = it.rot % 180 ? c.d : c.w, sh = it.rot % 180 ? c.w : c.d;
    return { x: it.cx - sw / 2, y: it.cy - sh / 2, w: sw, h: sh };
  }
  // item-local (u across the width, v back→front) → plan coordinates
  function toWorld(it, u, v) {
    let x, y;
    if (it.rot === 0) { x = u; y = v; }
    else if (it.rot === 90) { x = -v; y = u; }
    else if (it.rot === 180) { x = -u; y = -v; }
    else { x = v; y = -u; }
    return { x: it.cx + x, y: it.cy + y };
  }
  function zoneRect(it, side, D, from) {
    const { w, d } = CATALOG[it.t];
    const vf = -d / 2 + (from || 0) * d;
    let u0, u1, v0, v1;
    if (side === 'front') { u0 = -w / 2; u1 = w / 2; v0 = d / 2; v1 = d / 2 + D; }
    else if (side === 'back') { u0 = -w / 2; u1 = w / 2; v0 = -d / 2 - D; v1 = -d / 2; }
    else if (side === 'left') { u0 = -w / 2 - D; u1 = -w / 2; v0 = vf; v1 = d / 2; }
    else { u0 = w / 2; u1 = w / 2 + D; v0 = vf; v1 = d / 2; }
    return rectOf(toWorld(it, u0, v0), toWorld(it, u1, v1));
  }

  // room walls: `a` runs along the wall, `n` points into that room from the wall centre-line
  const wallLen = (r, wall) => (wall === 'top' || wall === 'bottom' ? r.w : r.h);
  function w2w(r, wall, a, n) {
    if (wall === 'top') return { x: r.x + a, y: r.y + n };
    if (wall === 'bottom') return { x: r.x + a, y: r.y + r.h - n };
    if (wall === 'left') return { x: r.x + n, y: r.y + a };
    return { x: r.x + r.w - n, y: r.y + a };
  }
  function doorZone(o) {
    const r = roomById(o.room);
    const n0 = o.out ? -HW - o.w : HW, n1 = o.out ? -HW : HW + o.w;
    return rectOf(w2w(r, o.wall, o.pos - o.w / 2, n0), w2w(r, o.wall, o.pos + o.w / 2, n1));
  }
  const windowZone = (o) => { const r = roomById(o.room); return rectOf(w2w(r, o.wall, o.pos - o.w / 2, HW), w2w(r, o.wall, o.pos + o.w / 2, HW + 20)); };

  function clampOpening(o) {
    const r = roomById(o.room);
    if (!r) return;
    const len = wallLen(r, o.wall);
    o.w = Math.max(40, Math.min(o.w, len - WALL * 2));
    o.pos = Math.min(Math.max(o.pos, o.w / 2 + HW), len - o.w / 2 - HW);
  }
  function clampItem(it) {
    const pb = planBox();
    if (!pb) return;
    const inr = interior(pb), b = bbox(it);
    const x = Math.min(Math.max(b.x, inr.x), Math.max(inr.x + inr.w - b.w, inr.x));
    const y = Math.min(Math.max(b.y, inr.y), Math.max(inr.y + inr.h - b.h, inr.y));
    it.cx = x + b.w / 2; it.cy = y + b.h / 2;
  }

  // ── snapping ─────────────────────────────────────────────────────────────
  function nearestDelta(starts, edges, limit) {
    let best = null;
    edges.forEach((e) => starts.forEach((s) => {
      const d = e - s;
      if (Math.abs(d) <= limit && (best === null || Math.abs(d) < Math.abs(best))) best = d;
    }));
    return best;
  }
  const roomEdges = (axis, exceptId) => S.rooms.filter((r) => r.id !== exceptId).flatMap((r) => (axis === 'x' ? [r.x, r.x + r.w] : [r.y, r.y + r.h]));
  function snapRoomValue(v, edges) {
    const d = nearestDelta([v], edges, ROOM_MAGNET);
    return d !== null ? v + d : Math.round(v / ROOM_GRID) * ROOM_GRID;
  }
  function snapRoomStart(start, size, edges) {
    const d = nearestDelta([start, start + size], edges, ROOM_MAGNET);
    return d !== null ? start + d : Math.round(start / ROOM_GRID) * ROOM_GRID;
  }
  function snapItemAxis(start, size, lo, hi, edges) {
    const d = nearestDelta([start, start + size], edges, MAGNET);
    const v = d !== null ? start + d : Math.round(start / GRID) * GRID;
    return Math.min(Math.max(v, lo), Math.max(hi - size, lo));
  }

  // ── checks ───────────────────────────────────────────────────────────────
  function analysePlan() {
    const out = [];
    S.rooms.forEach((a, i) => {
      for (let j = i + 1; j < S.rooms.length; j++) {
        const b = S.rooms[j];
        if (inter(interior(a), interior(b))) {
          out.push({ id: a.id, other: b.id, th: `<b>${esc(a.name)}</b> ซ้อนทับกับ ${esc(b.name)}`, en: `<b>${esc(a.name)}</b> overlaps ${esc(b.name)}` });
        }
      }
    });
    return out;
  }

  function analyseFurnish() {
    const warns = [], zones = {};
    const boxes = S.items.map(bbox);
    const doors = S.open.filter((o) => o.t === 'door').map(doorZone);
    const windows = S.open.filter((o) => o.t === 'window').map(windowZone);
    const add = (id, th, en) => { if (!warns.some((w) => w.id === id && w.th === th)) warns.push({ id, th, en }); };

    S.items.forEach((it, i) => {
      const c = CATALOG[it.t], b = boxes[i];
      const room = roomAt(it.cx, it.cy);
      const inr = room ? interior(room) : null;
      if (!room) add(it.id, `<b>${esc(c.th)}</b> อยู่นอกห้อง`, `<b>${esc(c.en)}</b> is outside the rooms`);
      else if (!within(b, inr)) add(it.id, `<b>${esc(c.th)}</b> ชนผนังหรือล้นออกนอก${esc(room.name)}`, `<b>${esc(c.en)}</b> runs into a wall of the ${esc(room.name)}`);
      for (let j = i + 1; j < S.items.length; j++) {
        if (inter(b, boxes[j])) {
          const o = CATALOG[S.items[j].t];
          add(it.id, `<b>${esc(c.th)}</b> วางทับกับ${esc(o.th)}`, `<b>${esc(c.en)}</b> overlaps the ${esc(o.en.toLowerCase())}`);
        }
      }
      if (doors.some((z) => inter(b, z))) add(it.id, `บานประตูเปิดชน<b>${esc(c.th)}</b>`, `A door swings into the <b>${esc(c.en.toLowerCase())}</b>`);
      if (c.tall && windows.some((z) => inter(b, z))) add(it.id, `<b>${esc(c.th)}</b> เป็นของสูง วางบังหน้าต่าง`, `<b>${esc(c.en)}</b> is tall and blocks a window`);

      const list = [];
      (c.clear || []).forEach((rule) => {
        const res = rule.s.map((side) => {
          const r = zoneRect(it, side, rule.d, rule.from);
          const bad = !inr || !within(r, inr) || boxes.some((ob, k) => k !== i && inter(r, ob));
          return { r, bad };
        });
        const fail = rule.any ? res.every((z) => z.bad) : res.some((z) => z.bad);
        res.forEach((z) => list.push({ r: z.r, bad: z.bad, fail }));
        if (fail) add(it.id, `<b>${esc(c.th)}</b>: ${esc(rule.th)}`, `<b>${esc(c.en)}</b>: ${esc(rule.en)}`);
      });
      zones[it.id] = list;
    });
    return { warns, zones };
  }

  // ── drawing ──────────────────────────────────────────────────────────────
  const rectSvg = (r, attrs) => `<rect x="${f(r.x)}" y="${f(r.y)}" width="${f(r.w)}" height="${f(r.h)}" ${attrs}/>`;
  const txt = (x, y, size, body, attrs) => `<text x="${f(x)}" y="${f(y)}" font-size="${f(size)}" font-family="${FONT}" text-anchor="middle" dominant-baseline="central" pointer-events="none" ${attrs || ''}>${body}</text>`;

  function furnitureDetail(it, sw) {
    const { w, d } = CATALOG[it.t];
    const st = `fill="none" stroke="${C.itemStroke}" stroke-width="${f(sw)}"`;
    const hw = w / 2, hd = d / 2;
    switch (it.t) {
      case 'bed6': case 'bed5':
        return `<rect x="${-hw + 12}" y="${-hd + 8}" width="${hw - 18}" height="26" rx="6" ${st}/><rect x="6" y="${-hd + 8}" width="${hw - 18}" height="26" rx="6" ${st}/><path d="M${-hw} ${-hd + 48}H${hw}" ${st}/>`;
      case 'bed35':
        return `<rect x="${-hw + 12}" y="${-hd + 8}" width="${w - 24}" height="26" rx="6" ${st}/><path d="M${-hw} ${-hd + 48}H${hw}" ${st}/>`;
      case 'sofa3': case 'sofa2':
        return `<path d="M${-hw} ${-hd + 20}H${hw}M${-hw + 16} ${-hd + 20}V${hd}M${hw - 16} ${-hd + 20}V${hd}" ${st}/>`;
      case 'wardrobe':
        return `<path d="M0 ${-hd}V${hd}M${-hw} ${hd - 5}H${hw}" ${st}/>`;
      case 'fridge':
        return `<path d="M${-hw} ${hd - 6}H${hw}M${-hw + 10} ${-hd + 12}V${hd - 14}" ${st}/>`;
      case 'washer':
        return `<circle cx="0" cy="3" r="${Math.min(w, d) / 3}" ${st}/>`;
      case 'tv':
        return `<path d="M${-hw + 15} ${hd - 6}H${hw - 15}" fill="none" stroke="${C.itemStroke}" stroke-width="3"/>`;
      case 'desk': case 'dresser':
        return `<rect x="-22" y="${hd + 4}" width="44" height="34" rx="8" ${st} stroke-dasharray="3 3"/>`;
      case 'dining4':
        return [-w / 4, w / 4].map((x) =>
          `<rect x="${x - 20}" y="${hd + 4}" width="40" height="34" rx="8" ${st} stroke-dasharray="3 3"/>` +
          `<rect x="${x - 20}" y="${-hd - 38}" width="40" height="34" rx="8" ${st} stroke-dasharray="3 3"/>`).join('');
      default:
        return '';
    }
  }

  function computeVB() {
    if (frozenVB) return frozenVB;
    const pb = planBox();
    if (S.step === 'furnish' && pb) return [pb.x - PAD, pb.y - PAD, pb.w + PAD * 2, pb.h + PAD * 2];
    // step 1: a drawing sheet of about 9 × 6.5 m that grows around the plan — kept
    // small so rooms are big enough on an iPad to draw and grab with a finger
    let x0 = -80, y0 = -80, x1 = 820, y1 = 570;
    if (pb) { x0 = Math.min(x0, pb.x - 80); y0 = Math.min(y0, pb.y - 80); x1 = Math.max(x1, pb.x + pb.w + 200); y1 = Math.max(y1, pb.y + pb.h + 180); }
    return [x0, y0, x1 - x0, y1 - y0];
  }

  // k = centimetres per screen pixel, so strokes, handles and captions keep a steady on-screen size
  function build(vb, k, exporting) {
    const plan = S.step === 'plan' && !exporting;
    const px = (n) => n * k;
    const an = S.step === 'furnish' && !exporting ? analyseFurnish() : { warns: [], zones: {} };
    const badIds = new Set(an.warns.map((w) => w.id));
    const badRooms = new Set();
    if (plan) analysePlan().forEach((w) => { badRooms.add(w.id); badRooms.add(w.other); });
    const [vx, vy, vw, vh] = vb;
    let out = '';

    out += `<defs>
      <pattern id="rpPaper1" width="50" height="50" patternUnits="userSpaceOnUse"><path d="M50 0H0V50" fill="none" stroke="${C.paperGrid}" stroke-width="${f(px(1))}"/></pattern>
      <pattern id="rpPaper2" width="100" height="100" patternUnits="userSpaceOnUse"><rect width="100" height="100" fill="url(#rpPaper1)"/><path d="M100 0H0V100" fill="none" stroke="${C.paperGrid2}" stroke-width="${f(px(1))}"/></pattern>
      <pattern id="rpFloor1" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" fill="none" stroke="${C.grid}" stroke-width="${f(px(1))}"/></pattern>
      <pattern id="rpFloor2" width="100" height="100" patternUnits="userSpaceOnUse"><rect width="100" height="100" fill="url(#rpFloor1)"/><path d="M100 0H0V100" fill="none" stroke="${C.grid2}" stroke-width="${f(px(1.2))}"/></pattern>
    </defs>`;
    out += `<rect x="${f(vx)}" y="${f(vy)}" width="${f(vw)}" height="${f(vh)}" fill="${C.paper}"/>`;
    if (plan) out += `<rect x="${f(vx)}" y="${f(vy)}" width="${f(vw)}" height="${f(vh)}" fill="url(#rpPaper2)"/>`;

    // walls, then floors on top — shared walls come out a single 10 cm thick
    S.rooms.forEach((r) => { out += `<rect x="${f(r.x - HW)}" y="${f(r.y - HW)}" width="${f(r.w + WALL)}" height="${f(r.h + WALL)}" fill="${C.wall}"/>`; });
    S.rooms.forEach((r) => {
      const i = interior(r);
      out += rectSvg(i, `fill="${C.floor}"`);
      out += rectSvg(i, `fill="url(#rpFloor2)"${plan ? ` data-room="${r.id}" style="cursor:move"` : ''}`);
      if (plan && r.id === sel) out += rectSvg(i, `fill="${C.roomSel}" stroke="${C.sel}" stroke-width="${f(px(2.5))}" pointer-events="none"`);
      if (plan && badRooms.has(r.id)) out += rectSvg(i, `fill="none" stroke="${C.bad}" stroke-width="${f(px(2))}" stroke-dasharray="${f(px(7))} ${f(px(5))}" pointer-events="none"`);
    });

    // doors & windows
    S.open.forEach((o) => {
      const r = roomById(o.room);
      if (!r) return;
      const a0 = o.pos - o.w / 2, a1 = o.pos + o.w / 2;
      const isSel = plan && o.id === sel;
      let g = plan ? `<g data-id="${o.id}" style="cursor:grab">` : '<g pointer-events="none">';
      if (plan) g += rectSvg(rectOf(w2w(r, o.wall, a0, -px(18)), w2w(r, o.wall, a1, px(18))), 'fill="rgba(0,0,0,0)"');
      g += rectSvg(rectOf(w2w(r, o.wall, a0, -HW - 0.5), w2w(r, o.wall, a1, HW + 0.5)), `fill="${C.floor}"`);
      if (o.t === 'window') {
        g += rectSvg(rectOf(w2w(r, o.wall, a0, -HW), w2w(r, o.wall, a1, HW)), `fill="${C.glass}" stroke="${isSel ? C.sel : C.glassLine}" stroke-width="${f(px(isSel ? 2.5 : 1.3))}"`);
        const m0 = w2w(r, o.wall, a0, 0), m1 = w2w(r, o.wall, a1, 0);
        g += `<path d="M${f(m0.x)} ${f(m0.y)}L${f(m1.x)} ${f(m1.y)}" stroke="${C.glassLine}" stroke-width="${f(px(1))}"/>`;
      } else {
        const face = o.out ? -HW : HW, dir = o.out ? -1 : 1;
        const ah = o.flip ? a1 : a0, s = o.flip ? -1 : 1;
        const h = w2w(r, o.wall, ah, face), leaf = w2w(r, o.wall, ah, face + dir * o.w);
        const pts = [];
        for (let q = 0; q <= 12; q++) {
          const th = (Math.PI / 2) * (q / 12);
          const p = w2w(r, o.wall, ah + s * o.w * Math.cos(th), face + dir * o.w * Math.sin(th));
          pts.push(`${f(p.x)},${f(p.y)}`);
        }
        g += `<polyline points="${pts.join(' ')}" fill="none" stroke="${isSel ? C.sel : C.dim}" stroke-width="${f(px(1.2))}" stroke-dasharray="${f(px(5))} ${f(px(4))}"/>`;
        g += `<path d="M${f(h.x)} ${f(h.y)}L${f(leaf.x)} ${f(leaf.y)}" stroke="${isSel ? C.sel : C.wall}" stroke-width="${f(px(isSel ? 4 : 3))}" stroke-linecap="round"/>`;
      }
      out += g + '</g>';
    });

    // clearance zones (all zones of the selected item; failing zones of every item)
    if (S.step === 'furnish' && !exporting) {
      S.items.forEach((it) => {
        (an.zones[it.id] || []).forEach((z) => {
          if (!(it.id === sel || (z.bad && z.fail))) return;
          const bad = z.bad && (z.fail || it.id === sel);
          out += rectSvg(z.r, `fill="${bad ? C.zoneBad : C.zoneOk}" stroke="${bad ? C.bad : C.sel}" stroke-width="${f(px(1))}" stroke-dasharray="${f(px(4))} ${f(px(3))}" pointer-events="none"`);
        });
      });
    }

    // furniture — faded and untouchable while drawing the plan
    S.items.forEach((it) => {
      const c = CATALOG[it.t];
      const isSel = !plan && !exporting && it.id === sel;
      const isBad = !plan && !exporting && badIds.has(it.id);
      const stroke = isSel ? C.sel : isBad ? C.bad : C.itemStroke;
      const attrs = plan ? 'opacity=".35" pointer-events="none"' : `data-id="${it.id}" style="cursor:move"`;
      out += `<g ${attrs} transform="translate(${f(it.cx)} ${f(it.cy)}) rotate(${it.rot})">` +
        `<rect x="${-c.w / 2}" y="${-c.d / 2}" width="${c.w}" height="${c.d}" rx="3" fill="${isBad ? C.badFill : C.item}" stroke="${stroke}" stroke-width="${f(px(isSel ? 3 : 1.4))}"/>` +
        furnitureDetail(it, px(1.1)) + '</g>';
    });
    if (!plan) {
      // labels stay readable whatever the rotation — narrow, tall items get a label along their long side
      S.items.forEach((it) => {
        const b = bbox(it), label = nm(it), chars = label.length * 0.56;
        const fsH = Math.min(px(14), Math.min(b.w, b.h) / 3.2, (b.w - 6) / chars);
        const fsV = b.h > b.w ? Math.min(px(14), (b.w - 6) * 0.7, (b.h - 6) / chars) : 0;
        const vertical = fsV > fsH * 1.15;
        const fs = Math.max(px(7), vertical ? fsV : fsH);
        const showSize = !exporting && it.id === sel && !vertical;
        if (vertical) {
          out += `<text transform="translate(${f(it.cx)} ${f(it.cy)}) rotate(-90)" font-size="${f(fs)}" font-family="${FONT}" font-weight="600" fill="${C.text}" text-anchor="middle" dominant-baseline="central" pointer-events="none">${esc(label)}</text>`;
        } else {
          out += txt(it.cx, it.cy - (showSize ? fs * 0.45 : 0), fs, esc(label), `font-weight="600" fill="${C.text}"`);
          if (showSize) out += txt(it.cx, it.cy + fs * 0.75, fs * 0.78, `${CATALOG[it.t].w}×${CATALOG[it.t].d}`, `fill="${C.dim}"`);
        }
      });
    }

    // room captions: big and centred while planning; small in the bottom corner once furnished
    const centred = plan || (exporting && !S.items.length);
    const en = isEn();
    const unitM = en ? 'm' : 'ม.';
    const halo = `stroke="${C.floor}" stroke-width="${f(px(3.5))}" paint-order="stroke"`;
    S.rooms.forEach((r) => {
      const i = interior(r);
      const area = `${((r.w * r.h) / 10000).toFixed(1)} ${en ? 'sq.m.' : 'ตร.ม.'}`;
      if (centred) {
        const fs = Math.max(px(9), Math.min(px(16), (i.w - px(10)) / (Math.max(r.name.length, 3) * 0.6)));
        out += txt(r.x + r.w / 2, r.y + r.h / 2 - fs * 0.55, fs, esc(r.name), `font-weight="700" fill="${C.text}" ${halo}`);
        out += txt(r.x + r.w / 2, r.y + r.h / 2 + fs * 0.75, Math.min(px(12), fs * 0.8), area, `fill="${C.dim}" ${halo}`);
      } else {
        out += `<text x="${f(i.x + px(22))}" y="${f(i.y + i.h - px(9))}" font-size="${f(px(11))}" font-family="${FONT}" font-weight="600" fill="${C.dim}" ${halo} pointer-events="none">${esc(r.name)} · ${area}</text>`;
      }

      // dimension lines just inside the walls: width along the top, length down the left side
      const dimCol = plan && r.id === sel ? C.sel : C.dim;
      const off = px(15), tick = px(5), fsD = px(11.5);
      const line = `stroke="${dimCol}" stroke-width="${f(px(1))}"`;
      const label = (cm) => `${m2(cm)} ${unitM}`;
      if (i.w > px(56)) {
        const y = i.y + off, x0 = i.x + px(3), x1 = i.x + i.w - px(3);
        out += `<path d="M${f(x0)} ${f(y)}H${f(x1)}M${f(x0)} ${f(y - tick)}V${f(y + tick)}M${f(x1)} ${f(y - tick)}V${f(y + tick)}" ${line} pointer-events="none"/>`;
        out += txt((x0 + x1) / 2, y, fsD, label(r.w), `font-weight="600" fill="${dimCol}" ${halo}`);
      }
      if (i.h > px(56)) {
        const x = i.x + off, y0 = i.y + px(3), y1 = i.y + i.h - px(3);
        out += `<path d="M${f(x)} ${f(y0)}V${f(y1)}M${f(x - tick)} ${f(y0)}H${f(x + tick)}M${f(x - tick)} ${f(y1)}H${f(x + tick)}" ${line} pointer-events="none"/>`;
        out += `<text transform="translate(${f(x)} ${f((y0 + y1) / 2)}) rotate(-90)" font-size="${f(fsD)}" font-family="${FONT}" font-weight="600" fill="${dimCol}" ${halo} text-anchor="middle" dominant-baseline="central" pointer-events="none">${label(r.h)}</text>`;
      }
    });

    // resize handles on the selected room
    const sr = plan && sel && roomById(sel);
    if (sr) {
      const hit = px(34), long = px(30), thick = px(11);
      [['top', sr.x + sr.w / 2, sr.y], ['bottom', sr.x + sr.w / 2, sr.y + sr.h], ['left', sr.x, sr.y + sr.h / 2], ['right', sr.x + sr.w, sr.y + sr.h / 2]].forEach(([edge, x, y]) => {
        const horiz = edge === 'top' || edge === 'bottom';
        const hw = horiz ? long : thick, hh = horiz ? thick : long;
        out += `<g data-handle="${edge}" style="cursor:${horiz ? 'ns-resize' : 'ew-resize'}">` +
          `<rect x="${f(x - hit / 2)}" y="${f(y - hit / 2)}" width="${f(hit)}" height="${f(hit)}" fill="rgba(0,0,0,0)"/>` +
          `<rect x="${f(x - hw / 2)}" y="${f(y - hh / 2)}" width="${f(hw)}" height="${f(hh)}" rx="${f(thick / 2)}" fill="#ffffff" stroke="${C.sel}" stroke-width="${f(px(2.5))}"/></g>`;
      });
    }

    // live preview while drawing a new room
    if (plan && drag && drag.kind === 'draw' && drag.active) {
      const r = rectOf({ x: drag.x0, y: drag.y0 }, { x: drag.x1, y: drag.y1 });
      const ok = r.w >= MIN_ROOM && r.h >= MIN_ROOM;
      const col = ok ? C.sel : C.bad;
      out += rectSvg(r, `fill="${ok ? 'rgba(18,153,90,.10)' : 'rgba(217,67,74,.08)'}" stroke="${col}" stroke-width="${f(px(2))}" stroke-dasharray="${f(px(8))} ${f(px(5))}" pointer-events="none"`);
      // size readout sits above the shape so a finger dragging the corner never covers it
      const ly = r.y - px(22) > vy + px(14) ? r.y - px(22) : r.y + r.h + px(22);
      out += txt(r.x + r.w / 2, ly, px(16), `${m2(r.w)} × ${m2(r.h)} ${unitM}`, `font-weight="700" fill="${col}" stroke="#ffffff" stroke-width="${f(px(4))}" paint-order="stroke"`);
    }

    // overall plan dimensions (only worth showing once there is more than one room)
    const pb = planBox();
    if (pb && S.rooms.length > 1) {
      out += txt(pb.x + pb.w / 2, pb.y - HW - px(16), px(13), `${m2(pb.w)} ${en ? 'm' : 'ม.'}`, `font-weight="600" fill="${C.dim}"`);
      out += `<text transform="translate(${f(pb.x - HW - px(16))} ${f(pb.y + pb.h / 2)}) rotate(-90)" font-size="${f(px(13))}" font-family="${FONT}" font-weight="600" fill="${C.dim}" text-anchor="middle" dominant-baseline="central" pointer-events="none">${m2(pb.h)} ${en ? 'm' : 'ม.'}</text>`;
    } else if (!pb && plan && !(drag && drag.active)) {
      out += txt(vx + vw / 2, vy + vh / 2 - px(14), px(20), en ? 'Drag on the grid to draw your first room' : 'ลากบนตารางเพื่อวาดห้องแรก', `font-weight="700" fill="${C.dim}"`);
      out += txt(vx + vw / 2, vy + vh / 2 + px(16), px(14), en ? 'or tap a quick room · or open a sample plan' : 'หรือกดเลือกห้องสำเร็จรูป · หรือเปิดแปลนตัวอย่าง', `fill="${C.dim}"`);
    }
    return out;
  }

  // ── render ───────────────────────────────────────────────────────────────
  svg.innerHTML = '<g id="rpScene"></g><rect id="rpHitLayer" fill="rgba(0,0,0,0)"/>';
  const scene = $('rpScene'), hitLayer = $('rpHitLayer');
  function render() {
    const vb = computeVB();
    svg.setAttribute('viewBox', vb.join(' '));
    ['x', 'y', 'width', 'height'].forEach((a, i) => hitLayer.setAttribute(a, vb[i]));
    const ctm = svg.getScreenCTM();
    if (ctm && ctm.a > 0) pxPerCm = ctm.a;
    scene.innerHTML = build(vb, 1 / pxPerCm, false);
    updatePanels();
  }
  const commit = () => { render(); save(); };

  const setVal = (el, v) => { if (document.activeElement !== el) el.value = v; };

  function updatePanels() {
    const en = isEn(), plan = S.step === 'plan';
    $('rpStepPlan').classList.toggle('on', plan);
    $('rpStepFurn').classList.toggle('on', !plan);
    $('rpStepFurn').disabled = !S.rooms.length;
    $('rpPalPlan').hidden = !plan; $('rpPalFurn').hidden = plan;
    $('rpPlanSide').hidden = !plan; $('rpFurnSide').hidden = plan;
    $('rpHintPlan').hidden = !plan; $('rpHintFurn').hidden = plan;
    $('rpUndo').disabled = !history.length;

    if (plan) {
      $('rpSel').hidden = true;
      const r = sel && roomById(sel), o = sel && openById(sel);
      $('rpPlanHelp').hidden = !!(r || o);
      $('rpRoomEdit').hidden = !r;
      $('rpOpenEdit').hidden = !o;
      if (r) { setVal($('rpRoomName'), r.name); setVal($('rpRoomW'), m2(r.w)); setVal($('rpRoomL'), m2(r.h)); }
      if (o) {
        $('rpOpenTitle').textContent = nm(o);
        setVal($('rpOpenW'), o.w);
        $('rpOpenFlip').hidden = $('rpOpenOut').hidden = o.t !== 'door';
      }
      const total = S.rooms.reduce((s, x) => s + x.w * x.h, 0) / 10000;
      $('rpRoomList').innerHTML = S.rooms.length
        ? S.rooms.map((x) => `<li><button type="button" data-pick="${x.id}" class="${x.id === sel ? 'on' : ''}"><span>${esc(x.name)}</span><b>${((x.w * x.h) / 10000).toFixed(1)}</b></button></li>`).join('') +
          `<li class="rp-total"><span>${en ? 'Total' : 'รวม'}</span><b>${total.toFixed(1)} ${en ? 'sq.m.' : 'ตร.ม.'}</b></li>`
        : `<li class="rp-empty">${en ? 'No rooms yet' : 'ยังไม่มีห้อง'}</li>`;
      $('rpPlanWarns').innerHTML = analysePlan().map((w) => `<li><button type="button" data-pick="${w.id}">${en ? w.en : w.th}</button></li>`).join('');
      $('rpToFurnish').disabled = !S.rooms.length;
      return;
    }

    const an = analyseFurnish();
    const status = $('rpStatus');
    if (!S.items.length) {
      status.className = 'rp-status ok';
      status.innerHTML = en ? 'Add furniture from the list to start planning.' : 'เพิ่มเฟอร์นิเจอร์จากรายการเพื่อเริ่มจัดห้อง';
    } else if (!an.warns.length) {
      status.className = 'rp-status ok';
      status.innerHTML = en ? '<b>✓ All clear</b> — this layout leaves enough room to live comfortably.' : '<b>✓ ผ่านทุกข้อ</b> — จัดวางแบบนี้มีพื้นที่ใช้งานสะดวก';
    } else {
      status.className = 'rp-status bad';
      status.innerHTML = en ? `<b>${an.warns.length} point${an.warns.length > 1 ? 's' : ''} to fix</b> — tap one to select the item.` : `<b>พบ ${an.warns.length} จุดที่ควรปรับ</b> — แตะรายการเพื่อเลือกชิ้นนั้น`;
    }
    $('rpWarns').innerHTML = an.warns.map((w) => `<li><button type="button" data-pick="${w.id}">${en ? w.en : w.th}</button></li>`).join('');

    const it = sel && itemById(sel);
    $('rpSel').hidden = !it;
    if (it) {
      $('rpSelName').textContent = nm(it);
      $('rpSelSize').textContent = `${CATALOG[it.t].w} × ${CATALOG[it.t].d} ${en ? 'cm' : 'ซม.'}`;
    }
  }

  // ── pointer interaction ──────────────────────────────────────────────────
  function svgPoint(e) {
    const p = svg.createSVGPoint();
    p.x = e.clientX; p.y = e.clientY;
    return p.matrixTransform(svg.getScreenCTM().inverse());
  }
  // first real movement of a drag: remember the state so it can be undone
  function beginChange() {
    if (!drag.moved) { if (drag.kind !== 'draw') pushHistory(); drag.moved = true; }
  }

  // What is under the pointer, worked out from the plan data rather than from DOM targets.
  // All touches land on one permanent transparent layer: iPad Safari stops following a
  // finger whose touched element gets replaced, and the drawing is redrawn on every move.
  function hitTest(p) {
    const k = 1 / pxPerCm;
    if (S.step === 'plan') {
      const r = sel && roomById(sel);
      if (r) {
        const reach = 30 * k;   // generous finger-sized reach around each handle
        const handles = [['top', r.x + r.w / 2, r.y], ['bottom', r.x + r.w / 2, r.y + r.h], ['left', r.x, r.y + r.h / 2], ['right', r.x + r.w, r.y + r.h / 2]];
        const hit = handles.find(([, x, y]) => Math.abs(p.x - x) <= reach && Math.abs(p.y - y) <= reach);
        if (hit) return { kind: 'handle', edge: hit[0] };
      }
      for (const o of S.open.slice().reverse()) {
        const rr = roomById(o.room);
        if (rr && containsPt(rectOf(w2w(rr, o.wall, o.pos - o.w / 2, -22 * k), w2w(rr, o.wall, o.pos + o.w / 2, 22 * k)), p.x, p.y)) return { kind: 'open', id: o.id };
      }
      const room = S.rooms.slice().reverse().find((x) => containsPt(interior(x), p.x, p.y));
      return room ? { kind: 'room', id: room.id } : null;
    }
    const pad = 4 * k;
    const grow = (b) => ({ x: b.x - pad, y: b.y - pad, w: b.w + pad * 2, h: b.h + pad * 2 });
    const cur = sel && itemById(sel);
    if (cur && containsPt(grow(bbox(cur)), p.x, p.y)) return { kind: 'item', id: cur.id };
    const it = S.items.slice().reverse().find((x) => containsPt(grow(bbox(x)), p.x, p.y));
    return it ? { kind: 'item', id: it.id } : null;
  }

  svg.addEventListener('pointerdown', (e) => {
    if (e.button) return;
    frozenVB = null;
    frozenVB = computeVB();
    const p = svgPoint(e);
    const plan = S.step === 'plan';
    const hit = hitTest(p);
    drag = null;

    if (hit && hit.kind === 'handle') {
      drag = { kind: 'resize', id: sel, edge: hit.edge };
    } else if (hit && (hit.kind === 'item' || hit.kind === 'open')) {
      const it = itemById(hit.id);
      sel = hit.id;
      drag = it ? { kind: 'item', id: hit.id, dx: it.cx - p.x, dy: it.cy - p.y } : { kind: 'open', id: hit.id };
    } else if (hit && hit.kind === 'room') {
      const r = roomById(hit.id), inr = interior(r);
      sel = r.id;
      drag = { kind: 'room', id: r.id, dx: r.x - p.x, dy: r.y - p.y, sx: r.x, sy: r.y,
        carry: S.items.filter((it) => containsPt(inr, it.cx, it.cy)).map((it) => ({ id: it.id, cx: it.cx, cy: it.cy })) };
    } else if (plan) {
      sel = null;
      const x0 = snapRoomValue(p.x, roomEdges('x')), y0 = snapRoomValue(p.y, roomEdges('y'));
      drag = { kind: 'draw', x0, y0, x1: x0, y1: y0 };
    } else {
      sel = null;
    }

    if (drag) { drag.moved = false; try { svg.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ } }
    else frozenVB = null;
    e.preventDefault();
    render();
  });

  const CURSORS = { handle: null, open: 'grab', room: 'move', item: 'move' };
  svg.addEventListener('pointermove', (e) => {
    if (!drag) {
      // mouse hover: show what a drag would do
      if (e.pointerType === 'mouse') {
        const h = hitTest(svgPoint(e));
        hitLayer.style.cursor = !h ? (S.step === 'plan' ? 'crosshair' : 'default')
          : h.kind === 'handle' ? (h.edge === 'top' || h.edge === 'bottom' ? 'ns-resize' : 'ew-resize') : CURSORS[h.kind];
      }
      return;
    }
    const p = svgPoint(e);

    if (drag.kind === 'draw') {
      const x1 = snapRoomValue(p.x, roomEdges('x')), y1 = snapRoomValue(p.y, roomEdges('y'));
      if (x1 !== drag.x1 || y1 !== drag.y1) { drag.x1 = x1; drag.y1 = y1; drag.active = true; render(); }
      return;
    }

    if (drag.kind === 'room') {
      const r = roomById(drag.id);
      const x = snapRoomStart(p.x + drag.dx, r.w, roomEdges('x', r.id));
      const y = snapRoomStart(p.y + drag.dy, r.h, roomEdges('y', r.id));
      if (x === r.x && y === r.y) return;
      beginChange();
      r.x = x; r.y = y;
      drag.carry.forEach((c) => { const it = itemById(c.id); if (it) { it.cx = c.cx + (x - drag.sx); it.cy = c.cy + (y - drag.sy); } });
      render();
      return;
    }

    if (drag.kind === 'resize') {
      const r = roomById(drag.id);
      const ex = roomEdges('x', r.id), ey = roomEdges('y', r.id);
      const before = [r.x, r.y, r.w, r.h].join();
      const next = { x: r.x, y: r.y, w: r.w, h: r.h };
      if (drag.edge === 'right') next.w = Math.max(snapRoomValue(p.x, ex), r.x + MIN_ROOM) - r.x;
      if (drag.edge === 'bottom') next.h = Math.max(snapRoomValue(p.y, ey), r.y + MIN_ROOM) - r.y;
      if (drag.edge === 'left') { const right = r.x + r.w; next.x = Math.min(snapRoomValue(p.x, ex), right - MIN_ROOM); next.w = right - next.x; }
      if (drag.edge === 'top') { const bottom = r.y + r.h; next.y = Math.min(snapRoomValue(p.y, ey), bottom - MIN_ROOM); next.h = bottom - next.y; }
      if ([next.x, next.y, next.w, next.h].join() === before) return;
      beginChange();
      // openings keep their place on screen when the far edge moves
      const dx = next.x - r.x, dy = next.y - r.y;
      S.open.filter((o) => o.room === r.id).forEach((o) => {
        if (dx && (o.wall === 'top' || o.wall === 'bottom')) o.pos -= dx;
        if (dy && (o.wall === 'left' || o.wall === 'right')) o.pos -= dy;
      });
      Object.assign(r, next);
      S.open.filter((o) => o.room === r.id).forEach(clampOpening);
      render();
      return;
    }

    if (drag.kind === 'open') {
      const o = openById(drag.id);
      // nearest wall of any room
      let best = null;
      S.rooms.forEach((r) => {
        [['top', p.x - r.x, Math.abs(p.y - r.y)], ['bottom', p.x - r.x, Math.abs(p.y - r.y - r.h)],
         ['left', p.y - r.y, Math.abs(p.x - r.x)], ['right', p.y - r.y, Math.abs(p.x - r.x - r.w)]].forEach(([wall, a, dist]) => {
          const len = wallLen(r, wall);
          const off = a < 0 ? -a : a > len ? a - len : 0;
          const score = dist + off * 2;
          if (!best || score < best.score) best = { room: r.id, wall, a, score };
        });
      });
      if (!best) return;
      const pos = Math.round(best.a / GRID) * GRID;
      if (best.room === o.room && best.wall === o.wall && pos === o.pos) return;
      beginChange();
      o.room = best.room; o.wall = best.wall; o.pos = pos;
      clampOpening(o);
      render();
      return;
    }

    // furniture
    const it = itemById(drag.id);
    const pb = planBox();
    if (!it || !pb) return;
    const inr = interior(pb), b = bbox(it);
    const others = S.items.filter((i) => i.id !== it.id).map(bbox);
    const faceX = S.rooms.flatMap((r) => [r.x + HW, r.x + r.w - HW]), faceY = S.rooms.flatMap((r) => [r.y + HW, r.y + r.h - HW]);
    const x = snapItemAxis(p.x + drag.dx - b.w / 2, b.w, inr.x, inr.x + inr.w, faceX.concat(others.flatMap((r) => [r.x, r.x + r.w])));
    const y = snapItemAxis(p.y + drag.dy - b.h / 2, b.h, inr.y, inr.y + inr.h, faceY.concat(others.flatMap((r) => [r.y, r.y + r.h])));
    const cx = x + b.w / 2, cy = y + b.h / 2;
    if (cx === it.cx && cy === it.cy) return;
    beginChange();
    it.cx = cx; it.cy = cy;
    render();
  });

  // double-click (mouse) or double-tap (iPad) a piece of furniture to rotate it
  let lastTap = { id: null, t: 0 };
  function endDrag() {
    if (!drag) return;
    const d = drag;
    drag = null;
    frozenVB = null;
    if (d.kind === 'draw') {
      const r = rectOf({ x: d.x0, y: d.y0 }, { x: d.x1, y: d.y1 });
      if (r.w >= MIN_ROOM && r.h >= MIN_ROOM) {
        pushHistory();
        const room = { id: uid(), name: `${isEn() ? 'Room' : 'ห้อง'} ${S.rooms.length + 1}`, ...r };
        S.rooms.push(room);
        sel = room.id;
      }
      commit();
      return;
    }
    if (d.moved) { commit(); return; }
    if (d.kind === 'item') {
      const now = Date.now();
      if (lastTap.id === d.id && now - lastTap.t < 350) { lastTap = { id: null, t: 0 }; rotateSel(); return; }
      lastTap = { id: d.id, t: now };
    }
    render();
  }
  svg.addEventListener('pointerup', endDrag);
  svg.addEventListener('pointercancel', endDrag);

  // ── actions ──────────────────────────────────────────────────────────────
  function rotateSel() {
    const it = sel && itemById(sel);
    if (!it) return;
    pushHistory();
    it.rot = (it.rot + 90) % 360; clampItem(it); commit();
  }
  function deleteSel() {
    if (!sel) return;
    pushHistory();
    S.items = S.items.filter((i) => i.id !== sel);
    S.open = S.open.filter((o) => o.id !== sel && o.room !== sel);
    S.rooms = S.rooms.filter((r) => r.id !== sel);
    sel = null; commit();
  }
  function setStep(step) {
    if (step === 'furnish' && !S.rooms.length) return;
    S.step = step; sel = null; commit();
    $('rp').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('rpStepPlan').addEventListener('click', () => setStep('plan'));
  $('rpStepFurn').addEventListener('click', () => setStep('furnish'));
  $('rpToFurnish').addEventListener('click', () => setStep('furnish'));
  $('rpToPlan').addEventListener('click', () => setStep('plan'));
  $('rpUndo').addEventListener('click', undo);

  document.querySelectorAll('[data-act]').forEach((b) => b.addEventListener('click', () => {
    const it = sel && itemById(sel);
    if (!it) return;
    if (b.dataset.act === 'rotate') rotateSel();
    else if (b.dataset.act === 'del') deleteSel();
    else if (b.dataset.act === 'dup') {
      pushHistory();
      const copy = { ...it, id: uid(), cx: it.cx + 25, cy: it.cy + 25 };
      clampItem(copy); S.items.push(copy); sel = copy.id; commit();
    }
  }));

  // step 1: quick rooms join onto the right-hand side of the plan
  document.querySelectorAll('[data-preset]').forEach((b) => b.addEventListener('click', () => {
    const p = ROOM_PRESETS[Number(b.dataset.preset)];
    const pb = planBox();
    pushHistory();
    const room = { id: uid(), name: isEn() ? p.en : p.th, x: pb ? pb.x + pb.w : 0, y: pb ? pb.y : 0, w: p.w, h: p.h };
    S.rooms.push(room); sel = room.id;
    if (S.step !== 'plan') S.step = 'plan';
    commit();
  }));

  // doors / windows (step 1) and furniture (step 2)
  document.querySelectorAll('[data-add]').forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.add;
    if (OPENINGS[t]) {
      const host = (sel && roomById(sel)) || S.rooms[S.rooms.length - 1];
      if (!host) { alert(isEn() ? 'Draw a room first, then add doors and windows.' : 'วาดห้องก่อน แล้วค่อยเพิ่มประตูหรือหน้าต่าง'); return; }
      pushHistory();
      const wall = t === 'window' ? 'top' : 'bottom';
      const o = { id: uid(), t, room: host.id, wall, pos: wallLen(host, wall) / 2, w: OPENINGS[t].w, flip: false, out: false };
      clampOpening(o); S.open.push(o); sel = o.id;
    } else {
      const pb = planBox();
      if (!pb) return;
      // drop it in the middle of the biggest room
      const r = S.rooms.slice().sort((a, c) => c.w * c.h - a.w * a.h)[0];
      pushHistory();
      const it = { id: uid(), t, cx: r.x + r.w / 2, cy: r.y + r.h / 2, rot: 0 };
      clampItem(it); S.items.push(it); sel = it.id;
    }
    commit();
  }));

  document.querySelectorAll('[data-tpl]').forEach((b) => b.addEventListener('click', () => {
    if (S.rooms.length && !confirm(isEn() ? 'Replace your current plan with this sample?' : 'แทนที่แปลนที่วาดไว้ด้วยแปลนตัวอย่างนี้?')) return;
    pushHistory();
    S = fromTemplate(b.dataset.tpl); sel = null; commit();
  }));

  $('rpClearAll').addEventListener('click', () => {
    if (!S.rooms.length) return;
    if (!confirm(isEn() ? 'Clear the whole plan and start again? (Undo can bring it back)' : 'ล้างแปลนทั้งหมดแล้วเริ่มใหม่? (กดย้อนกลับได้)')) return;
    pushHistory(); S = blank(); sel = null; commit();
  });
  $('rpClear').addEventListener('click', () => {
    if (!S.items.length) return;
    if (!confirm(isEn() ? 'Remove all furniture? (the plan stays)' : 'ลบเฟอร์นิเจอร์ทั้งหมด? (แปลนยังอยู่)')) return;
    pushHistory(); S.items = []; sel = null; commit();
  });

  document.querySelector('.rp').addEventListener('click', (e) => {
    const pick = e.target.closest('[data-pick]');
    if (!pick) return;
    sel = pick.dataset.pick; render();
  });

  // selected room / opening editors
  let armed = false;   // one undo step per editing session of a field
  const arm = () => { armed = true; };
  const once = () => { if (armed) { pushHistory(); armed = false; } };
  ['rpRoomName', 'rpRoomW', 'rpRoomL', 'rpOpenW'].forEach((id) => $(id).addEventListener('focus', arm));
  $('rpRoomName').addEventListener('input', (e) => {
    const r = roomById(sel); if (!r) return;
    once(); r.name = e.target.value.slice(0, 30) || (isEn() ? 'Room' : 'ห้อง'); commit();
  });
  const roomSize = () => {
    const r = roomById(sel); if (!r) return;
    const w = Math.round(parseFloat($('rpRoomW').value) * 100), h = Math.round(parseFloat($('rpRoomL').value) * 100);
    if (!(w >= MIN_ROOM && w <= 3000 && h >= MIN_ROOM && h <= 3000)) return;
    once(); r.w = w; r.h = h;
    S.open.filter((o) => o.room === r.id).forEach(clampOpening);
    commit();
  };
  $('rpRoomW').addEventListener('input', roomSize);
  $('rpRoomL').addEventListener('input', roomSize);
  $('rpRoomDel').addEventListener('click', deleteSel);
  $('rpOpenW').addEventListener('input', (e) => {
    const o = openById(sel); const w = parseInt(e.target.value, 10);
    if (!o || !(w >= 40 && w <= 400)) return;
    once(); o.w = w; clampOpening(o); commit();
  });
  $('rpOpenFlip').addEventListener('click', () => { const o = openById(sel); if (!o) return; pushHistory(); o.flip = !o.flip; commit(); });
  $('rpOpenOut').addEventListener('click', () => { const o = openById(sel); if (!o) return; pushHistory(); o.out = !o.out; commit(); });
  $('rpOpenDel').addEventListener('click', deleteSel);

  document.addEventListener('keydown', (e) => {
    const tag = (e.target.tagName || '').toLowerCase();
    const typing = tag === 'input' || tag === 'textarea' || tag === 'select';
    if ((e.ctrlKey || e.metaKey) && !e.shiftKey && (e.key === 'z' || e.key === 'Z') && !typing) { e.preventDefault(); undo(); return; }
    if (!sel || typing) return;
    const step = e.shiftKey ? 25 : S.step === 'plan' ? ROOM_GRID : GRID;
    const moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
    if (moves[e.key]) {
      const [dx, dy] = moves[e.key];
      const it = itemById(sel), r = roomById(sel), o = openById(sel);
      if (!it && !r && !o) return;
      e.preventDefault();
      pushHistory();
      if (it) { it.cx += dx; it.cy += dy; clampItem(it); }
      else if (r) { r.x += dx; r.y += dy; }
      else { o.pos += o.wall === 'top' || o.wall === 'bottom' ? dx : dy; clampOpening(o); }
      commit();
    } else if (e.key === 'r' || e.key === 'R') { rotateSel(); }
    else if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); deleteSel(); }
    else if (e.key === 'Escape') { sel = null; render(); }
  });

  // re-render labels in the other language when TH/EN is toggled; rescale captions on resize
  document.addEventListener('click', (e) => { if (e.target.closest('[data-lang-btn]')) setTimeout(render, 0); });
  let resizeTimer = 0;
  window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(render, 120); });

  // ── export PNG ───────────────────────────────────────────────────────────
  document.querySelectorAll('.rp-export').forEach((btn) => btn.addEventListener('click', async () => {
    const pb = planBox();
    if (!pb) return;
    const vb = [pb.x - PAD, pb.y - PAD, pb.w + PAD * 2, pb.h + PAD * 2];
    const scale = Math.min(3, 1600 / Math.max(vb[2], vb[3]));   // px per cm in the image
    const prevSel = sel; sel = null;
    // captions ~1.8× larger than on screen: the image is usually viewed shrunk on a phone or in chat
    const markup = build(vb, 1.8 / scale, true);
    sel = prevSel;
    const cw = Math.round(vb[2] * scale), chPlan = Math.round(vb[3] * scale), footer = 76;
    const img = new Image();
    img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vb.join(' ')}" width="${cw}" height="${chPlan}">${markup}</svg>`);
    try { await img.decode(); } catch (err) { alert(isEn() ? 'Could not create the image.' : 'สร้างรูปภาพไม่สำเร็จ'); return; }

    // keep the image at least 1000px wide so the footer never cramps; centre narrow plans
    const outW = Math.max(cw, 1000);
    const canvas = document.createElement('canvas');
    canvas.width = outW; canvas.height = chPlan + footer;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, Math.round((outW - cw) / 2), 0, cw, chPlan);
    ctx.fillStyle = '#16181a'; ctx.fillRect(0, chPlan, outW, footer);
    ctx.textBaseline = 'middle';
    ctx.fillStyle = '#ffffff'; ctx.font = `700 24px ${FONT}`;
    ctx.fillText('WHAT THE HOUSE', 24, chPlan + 28);
    ctx.fillStyle = '#9aa39c'; ctx.font = `400 17px ${FONT}`;
    const total = (S.rooms.reduce((s, r) => s + r.w * r.h, 0) / 10000).toFixed(1);
    ctx.fillText(isEn()
      ? `${S.rooms.length} room${S.rooms.length > 1 ? 's' : ''} · ${total} sq.m. · rough sketch, not a construction drawing`
      : `${S.rooms.length} ห้อง · ${total} ตร.ม. · แบบร่างคร่าว ๆ ไม่ใช่แบบก่อสร้าง`, 24, chPlan + 54);
    ctx.textAlign = 'right'; ctx.fillStyle = '#2fe07c'; ctx.font = `600 18px ${FONT}`;
    ctx.fillText('whatthehouse.net', outW - 24, chPlan + 28);

    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'wth-floor-plan.png';
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 4000);
    }, 'image/png');
  }));

  // ── boot ─────────────────────────────────────────────────────────────────
  S = load() || blank();
  S.open.forEach(clampOpening);
  render();
  requestAnimationFrame(render);   // second pass once the drawing has its real on-screen size
})();
</script>
