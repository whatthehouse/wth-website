  const CURSORS = { open: 'grab', room: 'pointer', item: 'move' };
  svg.addEventListener('pointermove', (e) => {
    if (pointers.has(e.pointerId)) pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pinch) { if (pointers.size >= 2) movePinch(); return; }
    if (!drag) {
      if (e.pointerType === 'mouse') {
        if (spaceDown) { hitLayer.style.cursor = 'grab'; return; }
        const p = toWorldPt(e.clientX, e.clientY);
        const h = hitTest(p);
        hitLayer.style.cursor = (!h || h.kind === 'room') && dimAt(p) ? 'text'
          : !h ? 'crosshair'
          : h.kind === 'handle' ? (h.edge === 'top' || h.edge === 'bottom' ? 'ns-resize' : 'ew-resize')
          : h.kind === 'room' && h.id === sel ? 'move' : CURSORS[h.kind];
