    const others = S.items.filter((i) => i.id !== it.id).map(bbox);
    const x = snapItemAxis(p.x + drag.dx - b.w / 2, b.w, pb.x + HW, pb.x + pb.w - HW, faces.xs.concat(others.flatMap((q) => [q.x, q.x + q.w])));
    const y = snapItemAxis(p.y + drag.dy - b.h / 2, b.h, pb.y + HW, pb.y + pb.h - HW, faces.ys.concat(others.flatMap((q) => [q.y, q.y + q.h])));
