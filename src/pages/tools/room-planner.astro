    if (e.key === ' ' && overStage) { e.preventDefault(); spaceDown = true; hitLayer.style.cursor = 'grab'; return; }
    if ((e.ctrlKey || e.metaKey) && !e.shiftKey && (e.key === 'z' || e.key === 'Z')) { e.preventDefault(); undo(); return; }
