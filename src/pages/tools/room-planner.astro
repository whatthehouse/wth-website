<script define:vars={{ CATALOG, OPENINGS, TEMPLATES, ROOM_PRESETS }}>
(function () {
  const $ = (id) => document.getElementById(id);
  const svg = $('rpSvg');
  if (!svg) return;

  const STORE_KEY = 'wth-room-planner-v3', OLD_KEY = 'wth-room-planner-v2';
  const WALL = 10, HW = WALL / 2;          // walls are drawn centred on the room outline
  const GRID = 5, MAGNET = 8;              // furniture snapping (cm)
  const ROOM_GRID = 10, ROOM_MAGNET = 20;  // room snapping (cm) — generous so walls join up
  const MIN_ROOM = 100, MIN_CUT = 30, MIN_LEFT = 60, PAD = 70;
  const VIEW_MIN = 120, VIEW_MAX = 6000;   // zoom limits: visible width in cm
  // same face as the site (Prompt); system fonts cover the exported image, where web fonts can't load
  const FONT = "Prompt, system-ui, 'Segoe UI', Tahoma, sans-serif";
  const C = {
    paper: '#ffffff', paperGrid: '#eff0ec', paperGrid2: '#dfe2dc',
    floor: '#fbfaf6', grid: '#ecebe4', grid2: '#d9d6cb', wall: '#2b302d', item: '#e4eee7', itemStroke: '#5b6a61',
    sel: '#12995a', bad: '#d9434a', badFill: '#fde6e6', zoneOk: 'rgba(18,153,90,.14)', zoneBad: 'rgba(217,67,74,.22)',
    roomSel: 'rgba(18,153,90,.08)', text: '#2b302d', dim: '#6b726d', glass: '#dcecf7', glassLine: '#6aa8d2',
  };

  const isEn = () => document.body.classList.contains('en');
  const uid = () => Math.random().toString(36).slice(2, 9);
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const f = (n) => Math.round(n * 10) / 10;
  const m2 = (cm) => (cm / 100).toFixed(2);
  const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);

  // ── state ────────────────────────────────────────────────────────────────
  // S = { rooms:[{id,name,x,y,w,h,cut:null|{type:'notch'|'chamfer',corner:'tl'|'tr'|'bl'|'br',w,h}}],
  //       open:[{id,t,room,edge,pos,w,flip,out}], items:[{id,t,cx,cy,rot}] }
  let S = null;
  let sel = null;          // selected room / opening / item id
  let drag = null;         // one-pointer gesture in progress
  let pinch = null;        // two-finger zoom/pan in progress
  let cam = null;          // visible area of the plan, cm: { x, y, w, h }
  let pxPerCm = 0.6;
  let dimHits = [];        // tappable dimension labels from the last render
  let dimEdit = null;      // { room, key } while the size box is open
  let spaceDown = false;
  const pointers = new Map();
  const history = [];

  const blank = () => ({ rooms: [], open: [], items: [] });
  function fromTemplate(key) {
    const t = TEMPLATES[key], en = isEn(), ids = {};
    const rooms = t.rooms.map((r) => { const id = uid(); ids[r.key] = id; return { id, name: en ? r.en : r.th, x: r.x, y: r.y, w: r.w, h: r.h, cut: null }; });
    return {
      rooms,
      open: t.open.map((o) => ({ id: uid(), t: o.t, room: ids[o.room], edge: o.edge, pos: o.pos, w: o.w, flip: !!o.flip, out: !!o.out })),
      items: t.items.map((i) => ({ id: uid(), ...i })),
    };
  }
  function validate(d) {
    if (!d || !Array.isArray(d.rooms) || !Array.isArray(d.open) || !Array.isArray(d.items)) return null;
    d.rooms = d.rooms.filter((r) => [r.x, r.y, r.w, r.h].every((n) => typeof n === 'number') && r.w >= MIN_ROOM && r.h >= MIN_ROOM);
    d.rooms.forEach((r) => { if (!r.cut || !['notch', 'chamfer'].includes(r.cut.type)) r.cut = null; });
    d.open = d.open.filter((o) => OPENINGS[o.t] && d.rooms.some((r) => r.id === o.room) && typeof o.edge === 'number');
    d.items = d.items.filter((i) => CATALOG[i.t] && [0, 90, 180, 270].includes(i.rot));
    return { rooms: d.rooms, open: d.open, items: d.items };
  }
  function load() {
    try {
      const d = JSON.parse(localStorage.getItem(STORE_KEY) || 'null');
      if (d) return validate(d);
      // earlier version stored openings by wall name — convert them to outline edges
      const old = JSON.parse(localStorage.getItem(OLD_KEY) || 'null');
      if (!old || !Array.isArray(old.rooms)) return null;
      const EDGE = { top: 0, right: 1, bottom: 2, left: 3 };
      old.open = (old.open || []).map((o) => {
        const r = old.rooms.find((x) => x.id === o.room);
        if (!r || !(o.wall in EDGE)) return null;
        const reversed = o.wall === 'bottom' || o.wall === 'left';
        const len = o.wall === 'bottom' ? r.w : r.h;
        return { id: o.id, t: o.t, room: o.room, edge: EDGE[o.wall], pos: reversed ? len - o.pos : o.pos, w: o.w, flip: reversed ? !o.flip : !!o.flip, out: !!o.out };
      }).filter(Boolean);
      return validate(old);
    } catch (e) { return null; }
  }
  function save() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(S)); } catch (e) { /* private mode etc. — still works, just not remembered */ }
  }
  function pushHistory() {
    history.push(JSON.stringify(S));
    if (history.length > 80) history.shift();
  }
  function undo() {
    if (!history.length) return;
    S = JSON.parse(history.pop());
    sel = null; commit();
  }

  // ── room shapes ──────────────────────────────────────────────────────────
  const roomById = (id) => S.rooms.find((r) => r.id === id);
  const itemById = (id) => S.items.find((i) => i.id === id);
  const openById = (id) => S.open.find((o) => o.id === id);
  const nm = (o) => { const c = CATALOG[o.t] || OPENINGS[o.t]; return isEn() ? c.en : c.th; };
  const rectOf = (p, q) => ({ x: Math.min(p.x, q.x), y: Math.min(p.y, q.y), w: Math.abs(p.x - q.x), h: Math.abs(p.y - q.y) });
  const boxOfPts = (pts) => { const xs = pts.map((p) => p.x), ys = pts.map((p) => p.y); const x = Math.min(...xs), y = Math.min(...ys); return { x, y, w: Math.max(...xs) - x, h: Math.max(...ys) - y }; };
  const inter = (a, b) => a.x < b.x + b.w - 1 && b.x < a.x + a.w - 1 && a.y < b.y + b.h - 1 && b.y < a.y + a.h - 1;
  const within = (a, b) => a.x >= b.x - 1 && a.y >= b.y - 1 && a.x + a.w <= b.x + b.w + 1 && a.y + a.h <= b.y + b.h + 1;
  const containsPt = (r, x, y) => x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h;

  function cutRect(r) {
    const c = r.cut;
    if (!c) return null;
    return { x: c.corner[1] === 'l' ? r.x : r.x + r.w - c.w, y: c.corner[0] === 't' ? r.y : r.y + r.h - c.h, w: c.w, h: c.h };
  }
  // outline points, clockwise from the top-left
  function poly(r) {
    const { x, y, w, h, cut: c } = r, X = x + w, Y = y + h;
    if (!c) return [[x, y], [X, y], [X, Y], [x, Y]];
    const cw = c.w, ch = c.h, notch = c.type === 'notch';
    switch (c.corner) {
      case 'tl': return notch ? [[x + cw, y], [X, y], [X, Y], [x, Y], [x, y + ch], [x + cw, y + ch]] : [[x + cw, y], [X, y], [X, Y], [x, Y], [x, y + ch]];
      case 'tr': return notch ? [[x, y], [X - cw, y], [X - cw, y + ch], [X, y + ch], [X, Y], [x, Y]] : [[x, y], [X - cw, y], [X, y + ch], [X, Y], [x, Y]];
      case 'br': return notch ? [[x, y], [X, y], [X, Y - ch], [X - cw, Y - ch], [X - cw, Y], [x, Y]] : [[x, y], [X, y], [X, Y - ch], [X - cw, Y], [x, Y]];
      default:   return notch ? [[x, y], [X, y], [X, Y], [x + cw, Y], [x + cw, Y - ch], [x, Y - ch]] : [[x, y], [X, y], [X, Y], [x + cw, Y], [x, Y - ch]];
    }
  }
  // each wall: start point, length, direction u and inward normal n
  function edges(r) {
    const P = poly(r);
    return P.map((a, i) => {
      const b = P[(i + 1) % P.length];
      const len = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
      const ux = (b[0] - a[0]) / len, uy = (b[1] - a[1]) / len;
      return { ax: a[0], ay: a[1], len, ux, uy, nx: -uy, ny: ux };
    });
  }
  const e2w = (e, a, n) => ({ x: e.ax + e.ux * a + e.nx * n, y: e.ay + e.uy * a + e.ny * n });
  const polyPath = (r) => 'M' + poly(r).map((p) => `${f(p[0])} ${f(p[1])}`).join('L') + 'Z';
  const roomArea = (r) => r.w * r.h - (r.cut ? (r.cut.type === 'notch' ? r.cut.w * r.cut.h : (r.cut.w * r.cut.h) / 2) : 0);

  // is a rectangle (or a point, w=h=0) on this room's usable floor?
  function insideRoom(q, r) {
    if (!within(q, { x: r.x + HW, y: r.y + HW, w: r.w - WALL, h: r.h - WALL })) return false;
    const c = r.cut;
    if (!c) return true;
    const cr = cutRect(r);
    if (c.type === 'notch') return !inter(q, { x: cr.x - HW, y: cr.y - HW, w: cr.w + WALL, h: cr.h + WALL });
    const e = edges(r).find((x) => Math.abs(x.ux) > 0.01 && Math.abs(x.uy) > 0.01);
    return [[q.x, q.y], [q.x + q.w, q.y], [q.x, q.y + q.h], [q.x + q.w, q.y + q.h]]
      .every(([px, py]) => (px - e.ax) * e.nx + (py - e.ay) * e.ny >= HW - 1);
  }
  const roomAt = (x, y) => S.rooms.slice().reverse().find((r) => insideRoom({ x, y, w: 0, h: 0 }, r));
  function roomsOverlap(a, b) {
    const ia = { x: a.x + HW, y: a.y + HW, w: a.w - WALL, h: a.h - WALL }, ib = { x: b.x + HW, y: b.y + HW, w: b.w - WALL, h: b.h - WALL };
    if (!inter(ia, ib)) return false;
    const x0 = Math.max(ia.x, ib.x), y0 = Math.max(ia.y, ib.y), x1 = Math.min(ia.x + ia.w, ib.x + ib.w), y1 = Math.min(ia.y + ia.h, ib.y + ib.h);
    for (let i = 0; i < 8; i++) for (let j = 0; j < 8; j++) {
      const pt = { x: x0 + ((i + 0.5) / 8) * (x1 - x0), y: y0 + ((j + 0.5) / 8) * (y1 - y0), w: 0, h: 0 };
      if (insideRoom(pt, a) && insideRoom(pt, b)) return true;
    }
    return false;
  }
  function planBox() {
    if (!S.rooms.length) return null;
    const x = Math.min(...S.rooms.map((r) => r.x)), y = Math.min(...S.rooms.map((r) => r.y));
    return { x, y, w: Math.max(...S.rooms.map((r) => r.x + r.w)) - x, h: Math.max(...S.rooms.map((r) => r.y + r.h)) - y };
  }
  function clampCut(r) {
    if (!r.cut) return;
    r.cut.w = clamp(Math.round(r.cut.w), MIN_CUT, r.w - MIN_LEFT);
    r.cut.h = clamp(Math.round(r.cut.h), MIN_CUT, r.h - MIN_LEFT);
  }

  // ── doors & windows on walls ─────────────────────────────────────────────
  function openEdge(o) {
    const r = roomById(o.room);
    if (!r) return null;
    const E = edges(r);
    return E[o.edge] ? E[o.edge] : null;
  }
  function doorZone(o) {
    const e = openEdge(o);
    const n0 = o.out ? -HW - o.w : HW, n1 = o.out ? -HW : HW + o.w;
    return boxOfPts([e2w(e, o.pos - o.w / 2, n0), e2w(e, o.pos + o.w / 2, n0), e2w(e, o.pos - o.w / 2, n1), e2w(e, o.pos + o.w / 2, n1)]);
  }
  function windowZone(o) {
    const e = openEdge(o);
    return boxOfPts([e2w(e, o.pos - o.w / 2, HW), e2w(e, o.pos + o.w / 2, HW), e2w(e, o.pos - o.w / 2, HW + 20), e2w(e, o.pos + o.w / 2, HW + 20)]);
  }
  function clampOpening(o) {
    const r = roomById(o.room);
    if (!r) return;
    const E = edges(r);
    if (!E[o.edge]) o.edge = 0;
    if (E[o.edge].len < 70) {   // wall too short for it: move to the longest wall
      o.edge = E.reduce((bi, e, i) => (e.len > E[bi].len ? i : bi), 0);
      o.pos = E[o.edge].len / 2;
    }
    const e = E[o.edge];
    o.w = clamp(o.w, 40, e.len - WALL * 2);
    o.pos = clamp(o.pos, o.w / 2 + HW, e.len - o.w / 2 - HW);
  }
  // closest wall of the given rooms to a point
  function nearestWall(rooms, pt) {
    let best = null;
    rooms.forEach((r) => edges(r).forEach((e, i) => {
      const a = (pt.x - e.ax) * e.ux + (pt.y - e.ay) * e.uy;
      const ac = clamp(a, 0, e.len);
      const dist = Math.hypot(pt.x - (e.ax + e.ux * ac), pt.y - (e.ay + e.uy * ac)) + Math.abs(a - ac) * 2;
      if (!best || dist < best.dist) best = { room: r.id, edge: i, a: ac, dist };
    }));
    return best;
  }
  // change a room's size/shape while its doors and windows stay where they are on screen
  const shapeKey = (r) => (r.cut ? r.cut.type + r.cut.corner : 'rect');
  function reshape(r, change) {
    const key = shapeKey(r);
    const before = S.open.filter((o) => o.room === r.id).map((o) => { const e = openEdge(o); return { o, pt: e2w(e, o.pos, 0) }; });
    change();
    clampCut(r);
    const E = edges(r);
    // same outline, only resized: each opening stays on its own wall; new outline: nearest wall
    const sameShape = shapeKey(r) === key;
    before.forEach(({ o, pt }) => {
      if (sameShape && E[o.edge]) {
        const e = E[o.edge];
        o.pos = (pt.x - e.ax) * e.ux + (pt.y - e.ay) * e.uy;
      } else {
        const n = nearestWall([r], pt);
        o.edge = n.edge; o.pos = n.a;
      }
      clampOpening(o);
    });
  }

  // ── furniture geometry ───────────────────────────────────────────────────
  function bbox(it) {
    const c = CATALOG[it.t];
    const sw = it.rot % 180 ? c.d : c.w, sh = it.rot % 180 ? c.w : c.d;
    return { x: it.cx - sw / 2, y: it.cy - sh / 2, w: sw, h: sh };
  }
  // item-local (u across the width, v back→front) → plan coordinates
  function toWorld(it, u, v) {
    let x, y;
    if (it.rot === 0) { x = u; y = v; }
    else if (it.rot === 90) { x = -v; y = u; }
    else if (it.rot === 180) { x = -u; y = -v; }
    else { x = v; y = -u; }
    return { x: it.cx + x, y: it.cy + y };
  }
  function zoneRect(it, side, D, from) {
    const { w, d } = CATALOG[it.t];
    const vf = -d / 2 + (from || 0) * d;
    let u0, u1, v0, v1;
    if (side === 'front') { u0 = -w / 2; u1 = w / 2; v0 = d / 2; v1 = d / 2 + D; }
    else if (side === 'back') { u0 = -w / 2; u1 = w / 2; v0 = -d / 2 - D; v1 = -d / 2; }
    else if (side === 'left') { u0 = -w / 2 - D; u1 = -w / 2; v0 = vf; v1 = d / 2; }
    else { u0 = w / 2; u1 = w / 2 + D; v0 = vf; v1 = d / 2; }
    return rectOf(toWorld(it, u0, v0), toWorld(it, u1, v1));
  }
  function clampItem(it) {
    const pb = planBox();
    if (!pb) return;
    const b = bbox(it);
    const x = clamp(b.x, pb.x + HW, Math.max(pb.x + pb.w - HW - b.w, pb.x + HW));
    const y = clamp(b.y, pb.y + HW, Math.max(pb.y + pb.h - HW - b.h, pb.y + HW));
    it.cx = x + b.w / 2; it.cy = y + b.h / 2;
  }

  // ── snapping ─────────────────────────────────────────────────────────────
  function nearestDelta(starts, lines, limit) {
    let best = null;
    lines.forEach((l) => starts.forEach((s) => {
      const d = l - s;
      if (Math.abs(d) <= limit && (best === null || Math.abs(d) < Math.abs(best))) best = d;
    }));
    return best;
  }
  function roomLines(axis, exceptId) {
    return S.rooms.filter((r) => r.id !== exceptId).flatMap((r) => {
      const cr = cutRect(r);
      const base = axis === 'x' ? [r.x, r.x + r.w] : [r.y, r.y + r.h];
      return cr ? base.concat(axis === 'x' ? [cr.x, cr.x + cr.w] : [cr.y, cr.y + cr.h]) : base;
    });
  }
  function snapRoomValue(v, lines) {
    const d = nearestDelta([v], lines, ROOM_MAGNET);
    return d !== null ? v + d : Math.round(v / ROOM_GRID) * ROOM_GRID;
  }
  function snapRoomStart(start, size, lines) {
    const d = nearestDelta([start, start + size], lines, ROOM_MAGNET);
    return d !== null ? start + d : Math.round(start / ROOM_GRID) * ROOM_GRID;
  }
  // inner faces of every straight wall, for furniture to snap against
  function wallFaces() {
    const xs = [], ys = [];
    S.rooms.forEach((r) => edges(r).forEach((e) => {
      if (Math.abs(e.uy) < 0.01) ys.push(e.ay + e.ny * HW);
      else if (Math.abs(e.ux) < 0.01) xs.push(e.ax + e.nx * HW);
    }));
    return { xs, ys };
  }
  function snapItemAxis(start, size, lo, hi, lines) {
    const d = nearestDelta([start, start + size], lines, MAGNET);
    const v = d !== null ? start + d : Math.round(start / GRID) * GRID;
    return clamp(v, lo, Math.max(hi - size, lo));
  }

  // ── checks ───────────────────────────────────────────────────────────────
  function analyse() {
    const warns = [], zones = {};
    const add = (id, th, en) => { if (!warns.some((w) => w.id === id && w.th === th)) warns.push({ id, th, en }); };

    S.rooms.forEach((a, i) => {
      for (let j = i + 1; j < S.rooms.length; j++) {
        const b = S.rooms[j];
        if (roomsOverlap(a, b)) add(a.id, `<b>${esc(a.name)}</b> ซ้อนทับกับ ${esc(b.name)}`, `<b>${esc(a.name)}</b> overlaps ${esc(b.name)}`);
      }
    });

    const boxes = S.items.map(bbox);
    const onFloor = S.items.map((it) => !CATALOG[it.t].high);
    const doors = S.open.filter((o) => o.t === 'door' && openEdge(o)).map(doorZone);
    const windows = S.open.filter((o) => o.t === 'window' && openEdge(o)).map(windowZone);

    S.items.forEach((it, i) => {
      const c = CATALOG[it.t], b = boxes[i];
      const room = roomAt(it.cx, it.cy);
      zones[it.id] = [];
      if (!room) add(it.id, `<b>${esc(c.th)}</b> อยู่นอกห้อง`, `<b>${esc(c.en)}</b> is outside the rooms`);
      else if (!insideRoom(b, room)) add(it.id, `<b>${esc(c.th)}</b> ชนผนังหรือล้นออกนอก${esc(room.name)}`, `<b>${esc(c.en)}</b> runs into a wall of the ${esc(room.name)}`);

      if (c.high) {
        // wall-mounted: its back must be against a wall; floor furniture below is fine
        if (room && insideRoom(zoneRect(it, 'back', 4, 0), room)) add(it.id, `<b>${esc(c.th)}</b> ควรติดตั้งชิดผนัง`, `<b>${esc(c.en)}</b> should be mounted on a wall`);
        return;
      }
      for (let j = i + 1; j < S.items.length; j++) {
        if (onFloor[j] && inter(b, boxes[j])) {
          const o = CATALOG[S.items[j].t];
          add(it.id, `<b>${esc(c.th)}</b> วางทับกับ${esc(o.th)}`, `<b>${esc(c.en)}</b> overlaps the ${esc(o.en.toLowerCase())}`);
        }
      }
      if (doors.some((z) => inter(b, z))) add(it.id, `บานประตูเปิดชน<b>${esc(c.th)}</b>`, `A door swings into the <b>${esc(c.en.toLowerCase())}</b>`);
      if (c.tall && windows.some((z) => inter(b, z))) add(it.id, `<b>${esc(c.th)}</b> เป็นของสูง วางบังหน้าต่าง`, `<b>${esc(c.en)}</b> is tall and blocks a window`);

      (c.clear || []).forEach((rule) => {
        const res = rule.s.map((side) => {
          const r = zoneRect(it, side, rule.d, rule.from);
          const bad = !room || !insideRoom(r, room) || boxes.some((ob, k) => k !== i && onFloor[k] && inter(r, ob));
          return { r, bad };
        });
        const fail = rule.any ? res.every((z) => z.bad) : res.some((z) => z.bad);
        res.forEach((z) => zones[it.id].push({ r: z.r, bad: z.bad, fail }));
        if (fail) add(it.id, `<b>${esc(c.th)}</b>: ${esc(rule.th)}`, `<b>${esc(c.en)}</b>: ${esc(rule.en)}`);
      });
    });
    return { warns, zones };
  }

  // ── drawing ──────────────────────────────────────────────────────────────
  const rectSvg = (r, attrs) => `<rect x="${f(r.x)}" y="${f(r.y)}" width="${f(r.w)}" height="${f(r.h)}" ${attrs}/>`;
  const txt = (x, y, size, body, attrs) => `<text x="${f(x)}" y="${f(y)}" font-size="${f(size)}" font-family="${FONT}" text-anchor="middle" dominant-baseline="central" pointer-events="none" ${attrs || ''}>${body}</text>`;
  const vtxt = (x, y, size, body, attrs) => `<text transform="translate(${f(x)} ${f(y)}) rotate(-90)" font-size="${f(size)}" font-family="${FONT}" text-anchor="middle" dominant-baseline="central" pointer-events="none" ${attrs || ''}>${body}</text>`;

  function furnitureDetail(it, sw) {
    const { w, d } = CATALOG[it.t];
    const st = `fill="none" stroke="${C.itemStroke}" stroke-width="${f(sw)}"`;
    const hw = w / 2, hd = d / 2;
    switch (it.t) {
      case 'bed6': case 'bed5':
        return `<rect x="${-hw + 12}" y="${-hd + 8}" width="${hw - 18}" height="26" rx="6" ${st}/><rect x="6" y="${-hd + 8}" width="${hw - 18}" height="26" rx="6" ${st}/><path d="M${-hw} ${-hd + 48}H${hw}" ${st}/>`;
      case 'bed35':
        return `<rect x="${-hw + 12}" y="${-hd + 8}" width="${w - 24}" height="26" rx="6" ${st}/><path d="M${-hw} ${-hd + 48}H${hw}" ${st}/>`;
      case 'sofa3': case 'sofa2':
        return `<path d="M${-hw} ${-hd + 20}H${hw}M${-hw + 16} ${-hd + 20}V${hd}M${hw - 16} ${-hd + 20}V${hd}" ${st}/>`;
      case 'wardrobe':
        return `<path d="M0 ${-hd}V${hd}M${-hw} ${hd - 5}H${hw}" ${st}/>`;
      case 'shoe':
        return `<path d="M0 ${-hd}V${hd}M${-hw} ${hd - 4}H${hw}" ${st}/>`;
      case 'fridge':
        return `<path d="M${-hw} ${hd - 6}H${hw}M${-hw + 10} ${-hd + 12}V${hd - 14}" ${st}/>`;
      case 'washer':
        return `<circle cx="0" cy="3" r="${Math.min(w, d) / 3}" ${st}/>`;
      case 'tv':
        return `<path d="M${-hw + 15} ${hd - 6}H${hw - 15}" fill="none" stroke="${C.itemStroke}" stroke-width="3"/>`;
      case 'desk': case 'dresser':
        return `<rect x="-22" y="${hd + 4}" width="44" height="34" rx="8" ${st} stroke-dasharray="3 3"/>`;
      case 'dining4':
        return [-w / 4, w / 4].map((x) =>
          `<rect x="${x - 20}" y="${hd + 4}" width="40" height="34" rx="8" ${st} stroke-dasharray="3 3"/>` +
          `<rect x="${x - 20}" y="${-hd - 38}" width="40" height="34" rx="8" ${st} stroke-dasharray="3 3"/>`).join('');
      case 'counter':
        return `<rect x="${-hw + 14}" y="${-hd + 10}" width="52" height="${d - 20}" rx="5" ${st}/><circle cx="${hw - 58}" cy="0" r="11" ${st}/><circle cx="${hw - 26}" cy="0" r="11" ${st}/>`;
      case 'toilet':
        return `<rect x="${-hw + 2}" y="${-hd + 2}" width="${w - 4}" height="16" rx="3" ${st}/><ellipse cx="0" cy="${-hd + 18 + (d - 18) / 2}" rx="${hw - 4}" ry="${(d - 18) / 2 - 3}" ${st}/>`;
      case 'basin':
        return `<ellipse cx="0" cy="3" rx="${w * 0.32}" ry="${d * 0.28}" ${st}/>`;
      case 'shower':
        return `<path d="M${-hw + 6} ${-hd + 6}L${hw - 6} ${hd - 6}M${hw - 6} ${-hd + 6}L${-hw + 6} ${hd - 6}" ${st}/><circle cx="0" cy="0" r="5" fill="#fbfaf6" ${st.replace('fill="none"', '')}/>`;
      case 'aircon':
        return `<path d="M${-hw + 6} -3H${hw - 6}M${-hw + 6} 4H${hw - 6}" ${st}/>`;
      default:
        return '';
    }
  }

  // k = centimetres per screen pixel, so strokes, handles and captions keep a steady on-screen size
  function build(vb, k, exporting) {
    const live = !exporting;
    const px = (n) => n * k;
    const en = isEn(), unitM = en ? 'm' : 'ม.';
    const an = analyse();
    const badIds = new Set(live ? an.warns.map((w) => w.id) : []);
    const [vx, vy, vw, vh] = vb;
    const halo = `stroke="${C.floor}" stroke-width="${f(px(3.5))}" paint-order="stroke"`;
    if (live) dimHits = [];
    let out = '';

    out += `<defs>
      <pattern id="rpPaper1" width="50" height="50" patternUnits="userSpaceOnUse"><path d="M50 0H0V50" fill="none" stroke="${C.paperGrid}" stroke-width="${f(px(1))}"/></pattern>
      <pattern id="rpPaper2" width="100" height="100" patternUnits="userSpaceOnUse"><rect width="100" height="100" fill="url(#rpPaper1)"/><path d="M100 0H0V100" fill="none" stroke="${C.paperGrid2}" stroke-width="${f(px(1))}"/></pattern>
      <pattern id="rpFloor1" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" fill="none" stroke="${C.grid}" stroke-width="${f(px(1))}"/></pattern>
      <pattern id="rpFloor2" width="100" height="100" patternUnits="userSpaceOnUse"><rect width="100" height="100" fill="url(#rpFloor1)"/><path d="M100 0H0V100" fill="none" stroke="${C.grid2}" stroke-width="${f(px(1.2))}"/></pattern>
    </defs>`;
    out += `<rect x="${f(vx)}" y="${f(vy)}" width="${f(vw)}" height="${f(vh)}" fill="${C.paper}"/>`;
    if (live) out += `<rect x="${f(vx)}" y="${f(vy)}" width="${f(vw)}" height="${f(vh)}" fill="url(#rpPaper2)"/>`;

    // floors, then every wall on top — shared walls come out a single 10 cm thick
    const overlapIds = new Set(an.warns.filter((w) => roomById(w.id)).map((w) => w.id));
    S.rooms.forEach((r) => {
      const d = polyPath(r);
      out += `<path d="${d}" fill="${C.floor}"/><path d="${d}" fill="url(#rpFloor2)"/>`;
      if (live && r.id === sel) out += `<path d="${d}" fill="${C.roomSel}"/>`;
    });
    S.rooms.forEach((r) => { out += `<path d="${polyPath(r)}" fill="none" stroke="${C.wall}" stroke-width="${WALL}" stroke-linejoin="miter"/>`; });
    S.rooms.forEach((r) => {
      if (live && r.id === sel) out += `<path d="${polyPath(r)}" fill="none" stroke="${C.sel}" stroke-width="${f(px(3))}" stroke-linejoin="round"/>`;
      if (live && overlapIds.has(r.id)) out += `<path d="${polyPath(r)}" fill="none" stroke="${C.bad}" stroke-width="${f(px(2.5))}" stroke-dasharray="${f(px(7))} ${f(px(5))}"/>`;
    });

    // doors & windows
    S.open.forEach((o) => {
      const e = openEdge(o);
      if (!e) return;
      const a0 = o.pos - o.w / 2, a1 = o.pos + o.w / 2;
      const isSel = live && o.id === sel;
      const quad = (n0, n1) => `M${[e2w(e, a0, n0), e2w(e, a1, n0), e2w(e, a1, n1), e2w(e, a0, n1)].map((p) => `${f(p.x)} ${f(p.y)}`).join('L')}Z`;
      out += `<path d="${quad(-HW - 0.6, HW + 0.6)}" fill="${C.floor}"/>`;
      if (o.t === 'window') {
        out += `<path d="${quad(-HW, HW)}" fill="${C.glass}" stroke="${isSel ? C.sel : C.glassLine}" stroke-width="${f(px(isSel ? 2.5 : 1.3))}"/>`;
        const m0 = e2w(e, a0, 0), m1 = e2w(e, a1, 0);
        out += `<path d="M${f(m0.x)} ${f(m0.y)}L${f(m1.x)} ${f(m1.y)}" stroke="${C.glassLine}" stroke-width="${f(px(1))}"/>`;
      } else {
        const face = o.out ? -HW : HW, dir = o.out ? -1 : 1;
        const ah = o.flip ? a1 : a0, s = o.flip ? -1 : 1;
        const h = e2w(e, ah, face), leaf = e2w(e, ah, face + dir * o.w);
        const pts = [];
        for (let q = 0; q <= 12; q++) {
          const th = (Math.PI / 2) * (q / 12);
          const p = e2w(e, ah + s * o.w * Math.cos(th), face + dir * o.w * Math.sin(th));
          pts.push(`${f(p.x)},${f(p.y)}`);
        }
        out += `<polyline points="${pts.join(' ')}" fill="none" stroke="${isSel ? C.sel : C.dim}" stroke-width="${f(px(1.2))}" stroke-dasharray="${f(px(5))} ${f(px(4))}"/>`;
        out += `<path d="M${f(h.x)} ${f(h.y)}L${f(leaf.x)} ${f(leaf.y)}" stroke="${isSel ? C.sel : C.wall}" stroke-width="${f(px(isSel ? 4 : 3))}" stroke-linecap="round"/>`;
      }
    });

    // clearance zones: every zone of the selected item, failing zones of the rest
    if (live) {
      S.items.forEach((it) => {
        (an.zones[it.id] || []).forEach((z) => {
          if (!(it.id === sel || (z.bad && z.fail))) return;
          const bad = z.bad && (z.fail || it.id === sel);
          out += rectSvg(z.r, `fill="${bad ? C.zoneBad : C.zoneOk}" stroke="${bad ? C.bad : C.sel}" stroke-width="${f(px(1))}" stroke-dasharray="${f(px(4))} ${f(px(3))}"`);
        });
      });
    }

    // room captions and dimension lines (drawn under the furniture)
    S.rooms.forEach((r) => {
      const c = r.cut, cr = cutRect(r);
      const area = `${(roomArea(r) / 10000).toFixed(1)} ${en ? 'sq.m.' : 'ตร.ม.'}`;
      // the biggest clear rectangle of the room, for the caption
      let band = { x: r.x, y: r.y, w: r.w, h: r.h };
      if (c) {
        const across = { x: r.x, y: c.corner[0] === 't' ? r.y + c.h : r.y, w: r.w, h: r.h - c.h };
        const down = { x: c.corner[1] === 'l' ? r.x + c.w : r.x, y: r.y, w: r.w - c.w, h: r.h };
        band = across.w * across.h >= down.w * down.h ? across : down;
      }
      const hasFurniture = S.items.some((it) => roomAt(it.cx, it.cy) === r);
      if (!hasFurniture) {
        const fs = Math.max(px(9), Math.min(px(16), (band.w - WALL - px(12)) / (Math.max(r.name.length, 3) * 0.6)));
        out += txt(band.x + band.w / 2, band.y + band.h / 2 - fs * 0.55, fs, esc(r.name), `font-weight="700" fill="${C.text}" ${halo}`);
        out += txt(band.x + band.w / 2, band.y + band.h / 2 + fs * 0.75, Math.min(px(12), fs * 0.8), area, `fill="${C.dim}" ${halo}`);
      }

      const col = live && r.id === sel ? C.sel : C.dim;
      const off = px(15), tick = px(5), fsD = px(11.5);
      const line = `stroke="${col}" stroke-width="${f(px(1))}"`;
      const topCut = c && c.corner[0] === 't', leftCut = c && c.corner[1] === 'l';
      const hDim = (x0, x1, y, cm, key) => {
        if (x1 - x0 < px(56)) return;
        out += `<path d="M${f(x0)} ${f(y)}H${f(x1)}M${f(x0)} ${f(y - tick)}V${f(y + tick)}M${f(x1)} ${f(y - tick)}V${f(y + tick)}" ${line}/>`;
        out += txt((x0 + x1) / 2, y, fsD, `${m2(cm)} ${unitM}`, `font-weight="600" fill="${col}" ${halo}`);
        if (live && key) dimHits.push({ room: r.id, key, x: (x0 + x1) / 2, y, w: px(64), h: px(26) });
      };
      const vDim = (y0, y1, x, cm, key) => {
        if (y1 - y0 < px(56)) return;
        out += `<path d="M${f(x)} ${f(y0)}V${f(y1)}M${f(x - tick)} ${f(y0)}H${f(x + tick)}M${f(x - tick)} ${f(y1)}H${f(x + tick)}" ${line}/>`;
        out += vtxt(x, (y0 + y1) / 2, fsD, `${m2(cm)} ${unitM}`, `font-weight="600" fill="${col}" ${halo}`);
        if (live && key) dimHits.push({ room: r.id, key, x, y: (y0 + y1) / 2, w: px(26), h: px(64) });
      };
      // overall width and length along walls the corner cut doesn't touch
      hDim(r.x + HW + px(3), r.x + r.w - HW - px(3), topCut ? r.y + r.h - HW - off : r.y + HW + off, r.w, 'w');
      vDim(r.y + HW + px(3), r.y + r.h - HW - px(3), leftCut ? r.x + r.w - HW - off : r.x + HW + off, r.h, 'h');
      if (c && c.type === 'notch') {
        // the two inside walls of the L
        const yIn = topCut ? cr.y + cr.h + HW + off : cr.y - HW - off;
        const xIn = leftCut ? cr.x + cr.w + HW + off : cr.x - HW - off;
        hDim(cr.x + (leftCut ? HW : 0) + px(3), cr.x + cr.w - (leftCut ? 0 : HW) - px(3), yIn, c.w, 'cw');
        vDim(cr.y + (topCut ? HW : 0) + px(3), cr.y + cr.h - (topCut ? 0 : HW) - px(3), xIn, c.h, 'ch');
      } else if (c) {
        const e = edges(r).find((x) => Math.abs(x.ux) > 0.01 && Math.abs(x.uy) > 0.01);
        const p = e2w(e, e.len / 2, HW + px(18));
        out += txt(p.x, p.y, px(11), `${m2(c.w)} × ${m2(c.h)} ${unitM}`, `font-weight="600" fill="${col}" ${halo}`);
      }
    });

    // furniture
    S.items.forEach((it) => {
      const c = CATALOG[it.t];
      const isSel = live && it.id === sel;
      const isBad = badIds.has(it.id);
      const stroke = isSel ? C.sel : isBad ? C.bad : C.itemStroke;
      // wall-mounted units and the shower area are outlines, not solid furniture
      const fill = isBad ? C.badFill : c.high ? 'rgba(228,238,231,.75)' : it.t === 'shower' ? C.floor : C.item;
      const dash = c.high || it.t === 'shower' ? ` stroke-dasharray="${f(px(5))} ${f(px(3))}"` : '';
      out += `<g transform="translate(${f(it.cx)} ${f(it.cy)}) rotate(${it.rot})">` +
        `<rect x="${-c.w / 2}" y="${-c.d / 2}" width="${c.w}" height="${c.d}" rx="3" fill="${fill}" stroke="${stroke}" stroke-width="${f(px(isSel ? 3 : 1.4))}"${dash}/>` +
        furnitureDetail(it, px(1.1)) + '</g>';
    });
    // labels stay readable whatever the rotation — narrow, tall items get a label along their long side
    S.items.forEach((it) => {
      const b = bbox(it), label = nm(it), chars = label.length * 0.56;
      const fsH = Math.min(px(14), Math.min(b.w, b.h) / 3.2, (b.w - 6) / chars);
      const fsV = b.h > b.w ? Math.min(px(14), (b.w - 6) * 0.7, (b.h - 6) / chars) : 0;
      const vertical = fsV > fsH * 1.15;
      const fs = Math.max(px(7), vertical ? fsV : fsH);
      const showSize = live && it.id === sel && !vertical;
      if (vertical) {
        out += vtxt(it.cx, it.cy, fs, esc(label), `font-weight="600" fill="${C.text}"`);
      } else {
        out += txt(it.cx, it.cy - (showSize ? fs * 0.45 : 0), fs, esc(label), `font-weight="600" fill="${C.text}"`);
        if (showSize) out += txt(it.cx, it.cy + fs * 0.75, fs * 0.78, `${CATALOG[it.t].w}×${CATALOG[it.t].d}`, `fill="${C.dim}"`);
      }
    });

    // small caption for furnished rooms, in a corner of the clear band
    S.rooms.forEach((r) => {
      if (!S.items.some((it) => roomAt(it.cx, it.cy) === r)) return;
      const c = r.cut;
      const bottomCut = c && c.corner[0] === 'b', leftCut = c && c.corner[1] === 'l';
      const x = leftCut && bottomCut ? r.x + c.w + HW + px(24) : r.x + HW + px(24);
      out += `<text x="${f(x)}" y="${f(r.y + r.h - HW - px(9))}" font-size="${f(px(11))}" font-family="${FONT}" font-weight="600" fill="${C.dim}" ${halo} pointer-events="none">${esc(r.name)} · ${(roomArea(r) / 10000).toFixed(1)} ${en ? 'sq.m.' : 'ตร.ม.'}</text>`;
    });

    // resize handles on the selected room
    // (they sit just outside the wall, so the dimension labels inside stay tappable)
    const sr = live && sel && roomById(sel);
    if (sr) {
      const long = px(30), thick = px(11), out_ = HW + px(9);
      handlesOf(sr).forEach(([edge, x, y, ox, oy]) => {
        const horiz = edge === 'top' || edge === 'bottom';
        const hw = horiz ? long : thick, hh = horiz ? thick : long;
        const cx = x + ox * out_, cy = y + oy * out_;
        out += `<rect x="${f(cx - hw / 2)}" y="${f(cy - hh / 2)}" width="${f(hw)}" height="${f(hh)}" rx="${f(thick / 2)}" fill="#ffffff" stroke="${C.sel}" stroke-width="${f(px(2.5))}"/>`;
      });
    }

    // live preview while drawing a new room
    if (live && drag && drag.kind === 'draw' && drag.moved) {
      const r = rectOf({ x: drag.x0, y: drag.y0 }, { x: drag.x1, y: drag.y1 });
      const ok = r.w >= MIN_ROOM && r.h >= MIN_ROOM;
      const col = ok ? C.sel : C.bad;
      out += rectSvg(r, `fill="${ok ? 'rgba(18,153,90,.10)' : 'rgba(217,67,74,.08)'}" stroke="${col}" stroke-width="${f(px(2))}" stroke-dasharray="${f(px(8))} ${f(px(5))}"`);
      // size readout sits above the shape so a finger dragging the corner never covers it
      const ly = r.y - px(22) > vy + px(14) ? r.y - px(22) : r.y + r.h + px(22);
      out += txt(r.x + r.w / 2, ly, px(16), `${m2(r.w)} × ${m2(r.h)} ${unitM}`, `font-weight="700" fill="${col}" stroke="#ffffff" stroke-width="${f(px(4))}" paint-order="stroke"`);
    }

    // overall plan dimensions (only worth showing once there is more than one room)
    const pb = planBox();
    if (pb && S.rooms.length > 1) {
      out += txt(pb.x + pb.w / 2, pb.y - HW - px(16), px(13), `${m2(pb.w)} ${unitM}`, `font-weight="600" fill="${C.dim}"`);
      out += vtxt(pb.x - HW - px(16), pb.y + pb.h / 2, px(13), `${m2(pb.h)} ${unitM}`, `font-weight="600" fill="${C.dim}"`);
    } else if (!pb && live && !(drag && drag.moved)) {
      out += txt(vx + vw / 2, vy + vh / 2 - px(14), px(20), en ? 'Drag on the grid to draw your first room' : 'ลากบนตารางเพื่อวาดห้องแรก', `font-weight="700" fill="${C.dim}"`);
      out += txt(vx + vw / 2, vy + vh / 2 + px(16), px(14), en ? 'or tap a quick room · or open a sample plan' : 'หรือกดเลือกห้องสำเร็จรูป · หรือเปิดแปลนตัวอย่าง', `fill="${C.dim}"`);
    }
    return out;
  }
  // [edge, point on the wall line, outward direction]
  const handlesOf = (r) => [['top', r.x + r.w / 2, r.y, 0, -1], ['bottom', r.x + r.w / 2, r.y + r.h, 0, 1], ['left', r.x, r.y + r.h / 2, -1, 0], ['right', r.x + r.w, r.y + r.h / 2, 1, 0]];

  // ── camera (zoom & pan) ──────────────────────────────────────────────────
  const stageRect = () => svg.getBoundingClientRect();
  function fitView() {
    const rect = stageRect();
    const ratio = rect.width ? rect.height / rect.width : 0.65;
    const pb = planBox();
    let b = pb ? { x: pb.x - HW, y: pb.y - HW, w: pb.w + WALL, h: pb.h + WALL } : { x: 0, y: 0, w: 600, h: 420 };
    const m = Math.max(70, Math.max(b.w, b.h) * 0.1);
    b = { x: b.x - m, y: b.y - m, w: b.w + m * 2, h: b.h + m * 2 };
    let w = Math.max(b.w, b.h / ratio, 600);
    cam = { x: b.x + b.w / 2 - w / 2, y: b.y + b.h / 2 - (w * ratio) / 2, w, h: w * ratio };
  }
  function syncCam() {
    const rect = stageRect();
    if (!cam) fitView();
    if (!rect.width || !rect.height) return;
    const cy = cam.y + cam.h / 2;
    cam.h = cam.w * (rect.height / rect.width);
    cam.y = cy - cam.h / 2;
    pxPerCm = rect.width / cam.w;
  }
  function zoomAt(factor, clientX, clientY) {
    const rect = stageRect();
    const fx = clientX === undefined ? 0.5 : (clientX - rect.left) / rect.width;
    const fy = clientY === undefined ? 0.5 : (clientY - rect.top) / rect.height;
    const wx = cam.x + fx * cam.w, wy = cam.y + fy * cam.h;
    const w = clamp(cam.w * factor, VIEW_MIN, VIEW_MAX), h = w * (cam.h / cam.w);
    cam = { x: wx - fx * w, y: wy - fy * h, w, h };
    render();
  }
  const toWorldPt = (clientX, clientY) => { const rect = stageRect(); return { x: cam.x + ((clientX - rect.left) / rect.width) * cam.w, y: cam.y + ((clientY - rect.top) / rect.height) * cam.h }; };

  // ── render ───────────────────────────────────────────────────────────────
  svg.innerHTML = '<g id="rpScene"></g><rect id="rpHitLayer" fill="rgba(0,0,0,0)"/>';
  const scene = $('rpScene'), hitLayer = $('rpHitLayer');
  function render() {
    syncCam();
    const vb = [cam.x, cam.y, cam.w, cam.h];
    svg.setAttribute('viewBox', vb.map(f).join(' '));
    ['x', 'y', 'width', 'height'].forEach((a, i) => hitLayer.setAttribute(a, f(vb[i])));
    scene.innerHTML = build(vb, 1 / pxPerCm, false);
    updatePanels();
    placeDimInput();
  }
  const commit = () => { render(); save(); };
  const setVal = (el, v) => { if (document.activeElement !== el) el.value = v; };

  function updatePanels() {
    const en = isEn();
    $('rpUndo').disabled = !history.length;
    const r = sel && roomById(sel), o = sel && openById(sel), it = sel && itemById(sel);
    $('rpHelp').hidden = !!(r || o);
    $('rpRoomEdit').hidden = !r;
    $('rpOpenEdit').hidden = !o;
    if (r) {
      setVal($('rpRoomName'), r.name); setVal($('rpRoomW'), m2(r.w)); setVal($('rpRoomL'), m2(r.h));
      const shape = r.cut ? r.cut.type : 'rect';
      document.querySelectorAll('#rpShape button').forEach((b) => b.classList.toggle('on', b.dataset.shape === shape));
      $('rpCutFields').hidden = !r.cut;
      if (r.cut) {
        document.querySelectorAll('#rpCorner button').forEach((b) => b.classList.toggle('on', b.dataset.corner === r.cut.corner));
        setVal($('rpCutW'), m2(r.cut.w)); setVal($('rpCutH'), m2(r.cut.h));
      }
    }
    if (o) {
      $('rpOpenTitle').textContent = nm(o);
      setVal($('rpOpenW'), o.w);
      $('rpOpenFlip').hidden = $('rpOpenOut').hidden = o.t !== 'door';
    }

    const total = S.rooms.reduce((s, x) => s + roomArea(x), 0) / 10000;
    $('rpRoomList').innerHTML = S.rooms.length
      ? S.rooms.map((x) => `<li><button type="button" data-pick="${x.id}" class="${x.id === sel ? 'on' : ''}"><span>${esc(x.name)}</span><b>${(roomArea(x) / 10000).toFixed(1)}</b></button></li>`).join('') +
        `<li class="rp-total"><span>${en ? 'Total' : 'รวม'}</span><b>${total.toFixed(1)} ${en ? 'sq.m.' : 'ตร.ม.'}</b></li>`
      : `<li class="rp-empty">${en ? 'No rooms yet' : 'ยังไม่มีห้อง'}</li>`;

    const an = analyse();
    const status = $('rpStatus');
    if (an.warns.length) {
      status.className = 'rp-status bad';
      status.innerHTML = en ? `<b>${an.warns.length} point${an.warns.length > 1 ? 's' : ''} to fix</b> — tap one to select it.` : `<b>พบ ${an.warns.length} จุดที่ควรปรับ</b> — แตะรายการเพื่อเลือก`;
    } else if (!S.rooms.length) {
      status.className = 'rp-status';
      status.innerHTML = en ? 'Draw a room to get started.' : 'เริ่มจากวาดห้องก่อน';
    } else if (!S.items.length) {
      status.className = 'rp-status';
      status.innerHTML = en ? 'Plan ready — add furniture to check the clearances.' : 'แปลนพร้อมแล้ว — เพิ่มเฟอร์นิเจอร์เพื่อเช็กระยะใช้งาน';
    } else {
      status.className = 'rp-status ok';
      status.innerHTML = en ? '<b>✓ All clear</b> — this layout leaves enough room to live comfortably.' : '<b>✓ ผ่านทุกข้อ</b> — จัดวางแบบนี้มีพื้นที่ใช้งานสะดวก';
    }
    $('rpWarns').innerHTML = an.warns.map((w) => `<li><button type="button" data-pick="${w.id}">${en ? w.en : w.th}</button></li>`).join('');

    $('rpSel').hidden = !it;
    if (it) {
      $('rpSelName').textContent = nm(it);
      $('rpSelSize').textContent = `${CATALOG[it.t].w} × ${CATALOG[it.t].d} ${en ? 'cm' : 'ซม.'}`;
    }
  }

  // ── hit testing ──────────────────────────────────────────────────────────
  // What is under the pointer, worked out from the plan data rather than DOM targets.
  // All touches land on one permanent transparent layer: iPad Safari stops following a
  // finger whose touched element gets replaced, and the drawing is redrawn on every move.
  function hitTest(p) {
    const k = 1 / pxPerCm;
    const r = sel && roomById(sel);
    if (r) {
      // finger-sized reach: 30px along the wall, from just inside it to 40px outside
      const h = handlesOf(r).find(([, x, y, ox, oy]) => {
        const out = (p.x - x) * ox + (p.y - y) * oy, along = Math.abs((p.x - x) * oy - (p.y - y) * ox);
        return along <= 30 * k && out >= -(HW + 3 * k) && out <= 40 * k;
      });
      if (h) return { kind: 'handle', edge: h[0] };
    }
    const pad = 4 * k;
    const grow = (b) => ({ x: b.x - pad, y: b.y - pad, w: b.w + pad * 2, h: b.h + pad * 2 });
    const cur = sel && itemById(sel);
    if (cur && containsPt(grow(bbox(cur)), p.x, p.y)) return { kind: 'item', id: cur.id };
    for (const o of S.open.slice().reverse()) {
      const e = openEdge(o);
      if (!e) continue;
      const a = (p.x - e.ax) * e.ux + (p.y - e.ay) * e.uy, n = (p.x - e.ax) * e.nx + (p.y - e.ay) * e.ny;
      if (Math.abs(a - o.pos) <= o.w / 2 && Math.abs(n) <= 22 * k) return { kind: 'open', id: o.id };
    }
    // wall-mounted items sit above the floor ones
    const items = S.items.slice().reverse().sort((a, b) => (CATALOG[b.t].high ? 1 : 0) - (CATALOG[a.t].high ? 1 : 0));
    const it = items.find((x) => containsPt(grow(bbox(x)), p.x, p.y));
    if (it) return { kind: 'item', id: it.id };
    const room = roomAt(p.x, p.y);
    return room ? { kind: 'room', id: room.id } : null;
  }
  const dimAt = (p) => dimHits.find((d) => Math.abs(p.x - d.x) <= d.w / 2 && Math.abs(p.y - d.y) <= d.h / 2) || null;

  // ── pointer interaction ──────────────────────────────────────────────────
  function beginChange() {
    if (!drag.moved) { if (drag.kind !== 'draw' && drag.kind !== 'pan') pushHistory(); drag.moved = true; }
  }
  function startPinch() {
    if (drag) {
      // a second finger landed: undo whatever the first finger had just started moving
      if (drag.moved && drag.kind !== 'draw' && drag.kind !== 'pan' && history.length) S = JSON.parse(history.pop());
      drag = null;
    }
    closeDimInput(false);
    const [a, b] = [...pointers.values()];
    pinch = { d0: Math.hypot(a.x - b.x, a.y - b.y) || 1, m0: { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }, cam0: { ...cam } };
    render();
  }
  function movePinch() {
    const [a, b] = [...pointers.values()];
    const rect = stageRect();
    const d = Math.hypot(a.x - b.x, a.y - b.y) || 1, m = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    const c0 = pinch.cam0;
    const w = clamp(c0.w * (pinch.d0 / d), VIEW_MIN, VIEW_MAX), h = w * (c0.h / c0.w);
    const wx = c0.x + ((pinch.m0.x - rect.left) / rect.width) * c0.w, wy = c0.y + ((pinch.m0.y - rect.top) / rect.height) * c0.h;
    cam = { x: wx - ((m.x - rect.left) / rect.width) * w, y: wy - ((m.y - rect.top) / rect.height) * h, w, h };
    render();
  }

  svg.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'mouse' && e.button !== 0 && e.button !== 1) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    try { svg.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
