    drag.start = start;
    drag.touch = e.pointerType !== 'mouse';
    // numbers can be tapped to edit — furniture or a door on top wins, unless that room is already selected
    const dim = hit && hit.kind === 'handle' ? null : dimAt(p);
    drag.dim = dim && (!hit || hit.kind === 'room' || dim.room === prevSel) ? dim : null;
    drag.hit = hit;
    render();
