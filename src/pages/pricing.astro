              <div class="result-inner">
                <div class="result-label"><span class="lang-th">ราคาประมาณการ</span><span class="lang-en">Estimated price</span></div>
                <div class="result-price" id="resultPrice">—</div>
                <div class="result-note" id="resultNote"></div>
              </div>
            </div>
            <ul class="bd-list" id="breakdown"></ul>
            <p class="upsell" id="upsell" hidden></p>

            <!-- quotation details -->
            <div class="quote-form" id="quoteForm">
              <p class="qf-title"><span class="lang-th">ออกใบเสนอราคา (ไม่บังคับกรอก)</span><span class="lang-en">Issue a quotation (optional fields)</span></p>
              <div class="form-row">
                <div class="field">
                  <label for="qName"><span class="lang-th">ชื่อลูกค้า</span><span class="lang-en">Customer name</span></label>
                  <input type="text" id="qName" placeholder="ชื่อ-นามสกุล / บริษัท" />
                </div>
                <div class="field">
                  <label for="qPhone"><span class="lang-th">เบอร์ติดต่อ</span><span class="lang-en">Phone</span></label>
