    <!-- ============ EXTRAS + CUSTOM QUOTE ============ -->
    <section class="section">
      <div class="container">
        <div class="two-col">
          <div class="info-card">
            <h3><span class="lang-th">ค่าบริการเพิ่มเติม</span><span class="lang-en">Additional charges</span></h3>
