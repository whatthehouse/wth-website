          </div>
        </div>
      </div>
    </section>

    <!-- ============ TERMS ============ -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">เงื่อนไขการใช้บริการ</span><span class="lang-en">Service terms</span></span>
          <h2 class="section-title"><span class="lang-th">เงื่อนไขที่ควรทราบก่อนใช้บริการ</span><span class="lang-en">Before you book</span></h2>
        </div>
        <div class="terms-card">
          <ol class="terms-list">
            {terms.th.map((t, i) => (
              <li><span class="lang-th">{t}</span><span class="lang-en block">{terms.en[i]}</span></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section">
      <div class="container">
        <div class="cta-band">
          <h2><span class="lang-th">พร้อมจองคิวตรวจบ้านแล้วหรือยัง?</span><span class="lang-en">Ready to book your inspection?</span></h2>
          <p><span class="lang-th">ติดต่อเราเพื่อยืนยันราคาและจองวันตรวจ รับใบเสนอราคาภายใน 24 ชั่วโมง</span><span class="lang-en block">Contact us to confirm pricing and book your date — quote within 24 hours.</span></p>
          <div class="btns">
            <a class="btn btn-primary btn-lg" href="/contact"><span class="lang-th">ขอราคา / จองคิว</span><span class="lang-en">Get a Quote</span></a>
            <a class="btn btn-ghost btn-lg" href="/sample-report"><span class="lang-th">ดูตัวอย่างรายงาน</span><span class="lang-en">See a sample report</span></a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <!-- ============ PRINTABLE QUOTATION (screen-hidden) ============ -->
  <div id="quoteDoc" class="quote-doc" data-lang="th" aria-hidden="true">
    <div class="qd-top">
      <div class="qd-brand">
        <img src="/assets/img/logo-print.png" alt="" width="44" height="47" />
        <div><b>WHAT THE HOUSE</b><span>HOME INSPECTIONS</span><span class="qd-slogan">BETTER HOMES • BETTER LIVING</span></div>
      </div>
      <div class="qd-meta">
        <div class="qd-title">ใบเสนอราคา / QUOTATION</div>
