---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="ค่าบริการตรวจบ้าน ตรวจคอนโด | WHAT THE HOUSE – Home Inspection Chiang Mai"
  description="ราคาตรวจบ้านและคอนโดเชียงใหม่ เริ่มต้น 3,000 บาท คำนวณราคาตามขนาดพื้นที่ได้เลย | Home Inspection Pricing Chiang Mai"
>
  <Header />
  <main>

    <!-- ============ PAGE HERO ============ -->
    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/">หน้าแรก</a> / <span class="lang-th">ค่าบริการ</span><span class="lang-en">Pricing</span></p>
        <span class="eyebrow"><span class="lang-th">ค่าบริการ</span><span class="lang-en">Pricing</span></span>
        <h1><span class="lang-th">ราคาค่าตรวจบ้าน</span><span class="lang-en">Inspection Pricing</span></h1>
        <p><span class="lang-th">ราคาชัดเจน ไม่มีค่าใช้จ่ายซ่อน คำนวณราคาได้เลยจากขนาดและประเภทอสังหาริมทรัพย์</span><span class="lang-en block">Transparent pricing, no hidden fees. Calculate your inspection cost by property type and size.</span></p>
      </div>
    </section>

    <!-- ============ PRICE CALCULATOR ============ -->
    <section class="section">
      <div class="container">
        <div class="calc-wrap">
          <div class="calc-box">
            <h2 class="calc-title">
              <span class="lang-th">คำนวณราคาตรวจบ้าน</span>
              <span class="lang-en">Calculate Your Price</span>
            </h2>
            <p class="calc-sub">
              <span class="lang-th">เลือกประเภทและกรอกขนาดพื้นที่เพื่อดูราคาทันที</span>
              <span class="lang-en block">Select property type and enter size to get an instant estimate.</span>
            </p>

            <!-- Step 1: Type -->
            <div class="calc-step">
              <label class="calc-label">
                <span class="lang-th">1. ประเภทอสังหาริมทรัพย์</span>
                <span class="lang-en">1. Property Type</span>
              </label>
              <div class="type-btns">
                <button class="type-btn active" data-type="house">
                  <svg viewBox="0 0 24 24" width="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 21v-6h6v6"/></svg>
                  <span class="lang-th">บ้านเดี่ยว</span>
                  <span class="lang-en">Detached House</span>
                </button>
                <button class="type-btn" data-type="townhouse">
                  <svg viewBox="0 0 24 24" width="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 21V10l5-4 5 4v11"/><path d="M12 21V10l5-4 5 4v11"/><path d="M2 21h20"/></svg>
                  <span class="lang-th">ทาวน์เฮ้าส์</span>
                  <span class="lang-en">Townhouse</span>
                </button>
                <button class="type-btn" data-type="condo">
                  <svg viewBox="0 0 24 24" width="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M8 3v18M16 3v18M2 9h20M2 15h20"/></svg>
                  <span class="lang-th">คอนโด</span>
                  <span class="lang-en">Condo</span>
                </button>
              </div>
            </div>

            <!-- Step 2: Area -->
            <div class="calc-step">
              <label class="calc-label" for="calcArea">
                <span class="lang-th">2. พื้นที่ใช้สอย (ตร.ม.)</span>
                <span class="lang-en">2. Floor Area (sq.m.)</span>
              </label>
              <div class="area-input-wrap">
                <input type="number" id="calcArea" class="area-input" placeholder="เช่น 120" min="1" max="2000" />
                <span class="area-unit">ตร.ม. / sq.m.</span>
              </div>
            </div>

            <!-- Step 3: Area outside CM -->
            <div class="calc-step">
              <label class="calc-label">
                <span class="lang-th">3. พื้นที่ให้บริการ</span>
                <span class="lang-en">3. Service Area</span>
              </label>
              <div class="area-btns">
                <label class="area-radio">
                  <input type="radio" name="location" value="cm" checked />
                  <span>
                    <span class="lang-th">เชียงใหม่</span>
                    <span class="lang-en">Chiang Mai</span>
                  </span>
                </label>
                <label class="area-radio">
                  <input type="radio" name="location" value="out" />
                  <span>
                    <span class="lang-th">ลำพูน / ลำปาง</span>
                    <span class="lang-en">Lamphun / Lampang</span>
                    <small class="lang-th"> (มีค่าเดินทาง)</small>
                    <small class="lang-en"> (travel fee applies)</small>
                  </span>
                </label>
              </div>
            </div>

            <!-- Result -->
            <div class="calc-result" id="calcResult">
              <div class="result-inner">
                <div class="result-label">
                  <span class="lang-th">ราคาประมาณการ</span>
                  <span class="lang-en">Estimated Price</span>
                </div>
                <div class="result-price" id="resultPrice">—</div>
                <div class="result-note" id="resultNote"></div>
              </div>
              <a href="/contact" class="btn btn-primary btn-lg result-cta">
                <span class="lang-th">จองคิวตรวจบ้าน</span>
                <span class="lang-en">Book an Inspection</span>
              </a>
            </div>
          </div>

          <!-- Side notes -->
          <div class="calc-notes">
            <h3><span class="lang-th">หมายเหตุ</span><span class="lang-en">Notes</span></h3>
            <ul class="note-list">
              <li>
                <span class="nc">✓</span>
                <span><span class="lang-th">ราคานี้รวมการตรวจ <b>2 รอบ</b> (รอบแรกและรอบแก้ไข)</span><span class="lang-en block">Price includes <b>2 rounds</b> of inspection (initial + re-inspection)</span></span>
              </li>
              <li>
                <span class="nc">✓</span>
                <span><span class="lang-th">รวมรายงาน PDF <b>ภาษาไทยและอังกฤษ</b></span><span class="lang-en block">Includes <b>Thai–English</b> PDF report</span></span>
              </li>
              <li>
                <span class="nc">✓</span>
                <span>
                  <span class="lang-th">ส่งรายงานภายใน <b>24 ชั่วโมง</b> หลังการตรวจ</span>
                  <span class="lang-en block">Report delivered within <b>24 hours</b> of inspection</span>
                  <small class="note-tiny"><span class="lang-th">*ระยะเวลาอาจเปลี่ยนแปลงได้ตามขนาดโครงการ</span><span class="lang-en">*Timeline may vary depending on project size</span></small>
                </span>
              </li>
              <li>
                <span class="nc">ℹ</span>
                <span><span class="lang-th">พื้นที่นอกเชียงใหม่ มีค่าเดินทางเพิ่มเติม ขึ้นอยู่กับระยะทาง</span><span class="lang-en block">Travel fee applies for areas outside Chiang Mai, based on distance</span></span>
              </li>
              <li>
                <span class="nc">ℹ</span>
                <span><span class="lang-th">บ้านพื้นที่เกิน 500 ตร.ม. กรุณาสอบถามราคาพิเศษ</span><span class="lang-en block">Houses over 500 sq.m. — please contact us for a custom quote</span></span>
              </li>
              <li>
                <span class="nc">ℹ</span>
                <span><span class="lang-th">คอนโดพื้นที่เกิน 120 ตร.ม. กรุณาสอบถามราคาพิเศษ</span><span class="lang-en block">Condos over 120 sq.m. — please contact us for a custom quote</span></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PRICE TABLE ============ -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">ตารางราคา</span><span class="lang-en">Price Table</span></span>
          <h2 class="section-title"><span class="lang-th">ราคาตรวจบ้านและคอนโด</span><span class="lang-en">Full Price Reference</span></h2>
        </div>

        <div class="price-tables">
          <!-- House table -->
          <div class="price-table-wrap">
            <div class="pt-header">
              <svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 21v-6h6v6"/></svg>
              <h3><span class="lang-th">บ้านเดี่ยว / ทาวน์เฮ้าส์</span><span class="lang-en">House / Townhouse</span></h3>
            </div>
            <table class="price-tbl">
              <thead>
                <tr>
                  <th><span class="lang-th">พื้นที่ (ตร.ม.)</span><span class="lang-en">Area (sq.m.)</span></th>
                  <th><span class="lang-th">ราคา</span><span class="lang-en">Price</span></th>
                </tr>
              </thead>
              <tbody>
                <tr><td>≤ 150</td><td class="price-cell">5,000 ฿</td></tr>
                <tr><td>151 – 220</td><td class="price-cell">6,000 ฿</td></tr>
                <tr><td>221 – 300</td><td class="price-cell">7,000 ฿</td></tr>
                <tr><td>301 – 400</td><td class="price-cell">8,000 ฿</td></tr>
                <tr><td>401 – 500</td><td class="price-cell">9,000 ฿</td></tr>
                <tr><td>&gt; 500</td><td class="price-cell"><span class="lang-th">สอบถาม</span><span class="lang-en">Quote</span></td></tr>
              </tbody>
            </table>
          </div>

          <!-- Condo table -->
          <div class="price-table-wrap">
            <div class="pt-header">
              <svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M8 3v18M16 3v18M2 9h20M2 15h20"/></svg>
              <h3><span class="lang-th">คอนโดมิเนียม</span><span class="lang-en">Condominium</span></h3>
            </div>
            <table class="price-tbl">
              <thead>
                <tr>
                  <th><span class="lang-th">พื้นที่ (ตร.ม.)</span><span class="lang-en">Area (sq.m.)</span></th>
                  <th><span class="lang-th">ราคา</span><span class="lang-en">Price</span></th>
                </tr>
              </thead>
              <tbody>
                <tr><td>≤ 40</td><td class="price-cell">3,000 ฿</td></tr>
                <tr><td>41 – 60</td><td class="price-cell">4,000 ฿</td></tr>
                <tr><td>61 – 90</td><td class="price-cell">5,000 ฿</td></tr>
                <tr><td>91 – 120</td><td class="price-cell">6,000 ฿</td></tr>
                <tr><td>&gt; 120</td><td class="price-cell"><span class="lang-th">สอบถาม</span><span class="lang-en">Quote</span></td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <p class="pt-foot">
          <span class="lang-th">* ราคาข้างต้นรวมการตรวจ 2 รอบและรายงาน PDF ไทย-อังกฤษแล้ว · พื้นที่นอกเชียงใหม่มีค่าเดินทางเพิ่มเติม</span>
          <span class="lang-en block">* All prices include 2-round inspection and Thai–English PDF report · Travel fee applies outside Chiang Mai</span>
        </p>
      </div>
    </section>

    <!-- ============ WHAT'S INCLUDED ============ -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">รวมอยู่ในราคา</span><span class="lang-en">What's included</span></span>
          <h2 class="section-title"><span class="lang-th">ค่าบริการรวมทุกอย่างแล้ว</span><span class="lang-en">Everything is included</span></h2>
        </div>
        <div class="grid grid-3">
          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.2-8.6"/><path d="M21 4l-9 9-3-3"/></svg></div>
            <div>
              <h4><span class="lang-th">ตรวจ 2 รอบ</span><span class="lang-en">2 inspection rounds</span></h4>
              <p><span class="lang-th">รอบแรกก่อนรับมอบ และรอบแก้ไขหลังผู้รับเหมาซ่อม</span><span class="lang-en block">Initial inspection + re-inspection after contractor fixes.</span></p>
            </div>
          </div>
          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/></svg></div>
            <div>
              <h4><span class="lang-th">รายงาน PDF ไทย-อังกฤษ</span><span class="lang-en">Thai–English PDF report</span></h4>
              <p>
                <span class="lang-th">พร้อมรูปภาพและคำแนะนำการแก้ไข ส่งภายใน <b>24 ชั่วโมง</b> หลังการตรวจ</span>
                <span class="lang-en block">With photos and repair recommendations, delivered within <b>24 hours</b> of inspection.</span>
                <small class="note-tiny"><span class="lang-th">*ระยะเวลาอาจเปลี่ยนแปลงได้ตามขนาดโครงการ</span><span class="lang-en">*Timeline may vary depending on project size</span></small>
              </p>
            </div>
          </div>
          <div class="feat">
            <div class="fic"><svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
            <div>
              <h4><span class="lang-th">ให้คำปรึกษาหลังรับรายงาน</span><span class="lang-en">Post-report consultation</span></h4>
              <p><span class="lang-th">อธิบายปัญหาและแนวทางแก้ไขแบบตัวต่อตัว ไม่มีค่าใช้จ่ายเพิ่ม</span><span class="lang-en block">Walk you through findings and next steps — no extra charge.</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section soft">
      <div class="container">
        <div class="cta-band">
          <h2><span class="lang-th">พร้อมจองคิวตรวจบ้านแล้วหรือยัง?</span><span class="lang-en">Ready to book your inspection?</span></h2>
          <p><span class="lang-th">ติดต่อเราเพื่อยืนยันราคาและจองวันตรวจ รับใบเสนอราคาภายใน 24 ชั่วโมง</span><span class="lang-en block">Contact us to confirm pricing and book your date — get a quote within 24 hours.</span></p>
          <div class="btns">
            <a class="btn btn-primary btn-lg" href="/contact"><span class="lang-th">ขอราคา / จองคิว</span><span class="lang-en">Get a Quote</span></a>
            <a class="btn btn-ghost btn-lg" href="/services"><span class="lang-th">ดูบริการทั้งหมด</span><span class="lang-en">View Services</span></a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ── Calculator ── */
/* type buttons */
.type-btns { display: flex; gap: 12px; }
.type-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 18px 12px;
  border: 2px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  cursor: pointer;
  font-size: .9rem;
  font-family: inherit;
  font-weight: 500;
  color: var(--grey);
  transition: .2s;
}
.type-btn svg { color: var(--grey); transition: .2s; }
.type-btn:hover { border-color: var(--green); color: var(--green-bright); }
.type-btn:hover svg { color: var(--green-bright); }
.type-btn.active {
  border-color: var(--green);
  background: var(--green-soft);
  color: var(--green-bright);
  font-weight: 600;
}
.type-btn.active svg { color: var(--green-bright); }

/* location radios */
.area-btns { display: flex; flex-direction: column; gap: 10px; }
.area-radio {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  cursor: pointer;
  padding: 12px 14px;
  border: 2px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--panel-2);
  transition: .15s;
  font-size: .93rem;
}
.area-radio:has(input:checked) { border-color: var(--green); background: var(--green-soft); }
.area-radio input { margin-top: 3px; accent-color: var(--green); }
.area-radio small { color: var(--grey); font-size: .82rem; }

/* result box */
/* notes side */
/* price tables */
.price-tables { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.price-table-wrap {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}
.pt-header {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--panel-3);
  border-bottom: 1px solid var(--line);
  color: #fff;
  padding: 16px 22px;
}
.pt-header svg { color: var(--green-bright); }
.pt-header h3 { margin: 0; font-size: 1rem; color: #fff; }
.price-tbl { width: 100%; border-collapse: collapse; }
.price-tbl th {
  text-align: left;
  padding: 10px 22px;
  font-size: .82rem;
  font-weight: 600;
  color: var(--grey);
  background: var(--bg-soft);
  border-bottom: 1px solid var(--line);
  text-transform: uppercase;
  letter-spacing: .04em;
}
.price-tbl td {
  padding: 13px 22px;
  border-bottom: 1px solid var(--line);
  font-size: .95rem;
  color: var(--body);
}
.price-tbl tr:last-child td { border-bottom: 0; }
.price-tbl tr:hover td { background: var(--panel-2); }
.price-cell { font-family: var(--mono); font-weight: 600; color: var(--green-bright); font-size: 1.05rem; }
.pt-foot {
  text-align: center;
  margin-top: 18px;
  font-size: .85rem;
  color: var(--grey-light);
}

@media (max-width: 980px) {
  .calc-wrap { grid-template-columns: 1fr; }
  .calc-notes { order: -1; }
}
@media (max-width: 720px) {
  .type-btns { flex-direction: column; }
  .price-tables { grid-template-columns: 1fr; }
  .calc-result { flex-direction: column; align-items: flex-start; }
  .calc-box { padding: 24px 18px; }
}
</style>

<script>
  // ── Price Calculator Logic ──
  (function () {
    // house table is shared by detached houses and townhouses (same pricing)
    const HOUSE = [
      { max: 150, price: 5000 },
      { max: 220, price: 6000 },
      { max: 300, price: 7000 },
      { max: 400, price: 8000 },
      { max: 500, price: 9000 },
      { max: Infinity, price: null }, // quote
    ];
    const PRICES: Record<string, { max: number; price: number | null }[]> = {
      house: HOUSE,
      townhouse: HOUSE,
      condo: [
        { max: 40,  price: 3000 },
        { max: 60,  price: 4000 },
        { max: 90,  price: 5000 },
        { max: 120, price: 6000 },
        { max: Infinity, price: null }, // quote
      ],
    };

    let propType = 'house';
    let location = 'cm';

    const areaInput  = document.getElementById('calcArea') as HTMLInputElement;
    const resultPrice = document.getElementById('resultPrice') as HTMLElement;
    const resultNote  = document.getElementById('resultNote') as HTMLElement;
    const typeBtns    = document.querySelectorAll('.type-btn');
    const locRadios   = document.querySelectorAll('input[name="location"]');

    function isEn() { return document.body.classList.contains('en'); }

    function calcPrice() {
      const sqm = parseFloat(areaInput.value);
      if (!sqm || sqm <= 0) {
        resultPrice.textContent = '—';
        resultNote.textContent = '';
        return;
      }

      const table = PRICES[propType] || PRICES.house;
      const row = table.find(r => sqm <= r.max);
      const travelNote = location === 'out'
        ? (isEn() ? ' + travel fee' : ' + ค่าเดินทาง')
        : '';

      if (!row || row.price === null) {
        resultPrice.textContent = isEn() ? 'Contact us' : 'สอบถามราคา';
        resultNote.textContent = isEn() ? 'Custom quote for this size' : 'ขนาดนี้กรุณาติดต่อเพื่อรับราคาพิเศษ';
      } else {
        resultPrice.textContent = row.price.toLocaleString() + ' ฿' + travelNote;
        resultNote.textContent = isEn()
          ? 'Includes 2 rounds + Thai–English PDF report within 24 hrs'
          : 'รวม 2 รอบตรวจ + รายงาน PDF ไทย-อังกฤษ ภายใน 24 ชั่วโมง';
      }
    }

    // type toggle
    typeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        typeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        propType = (btn as HTMLElement).dataset.type || 'house';
        calcPrice();
      });
    });

    // area input
    areaInput.addEventListener('input', calcPrice);

    // location
    locRadios.forEach(r => {
      r.addEventListener('change', () => {
        location = (r as HTMLInputElement).value;
        calcPrice();
      });
    });

    // re-calc when language changes (prices stay same, labels change)
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-lang-btn]')) {
        setTimeout(calcPrice, 50);
      }
    });
  })();
</script>
