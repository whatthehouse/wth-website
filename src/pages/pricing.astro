          </div>
          <div class="info-card">
            <h3><span class="lang-th">กรณีที่ต้องประเมินราคาเป็นรายกรณี</span><span class="lang-en">Cases we quote individually</span></h3>
            <ul class="tick-list">
              {customQuote.th.map((t, i) => (
                <li><span class="nc">•</span><span><span class="lang-th">{t}</span><span class="lang-en block">{customQuote.en[i]}</span></span></li>
              ))}
