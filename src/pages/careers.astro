---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import settings from '../data/settings.json';

// ---------- team levels ----------
const levels = [
  {
    tag: "LV.1",
    title: { th: "Inspector", en: "Inspector" },
    desc: { th: "ผู้ตรวจบ้านร่วมทีม ไม่จำเป็นต้องมีใบ กว. แต่ต้องผ่านการอบรมและทดสอบมาตรฐานของบริษัท", en: "Team inspector — no engineering licence required, but must pass our training and standards test." },
  },
  {
    tag: "LV.2",
    title: { th: "Senior Inspector", en: "Senior Inspector" },
    desc: { th: "ผู้ตรวจที่มีประสบการณ์สูง หรือมีใบประกอบวิชาชีพ/ใบรับรองที่เกี่ยวข้อง", en: "Experienced inspector, or one holding a relevant professional licence or certification." },
  },
  {
    tag: "LV.3",
    title: { th: "Professional Engineer", en: "Professional Engineer" },
    desc: { th: "วิศวกรมีใบ กว. รับผิดชอบงานวิเคราะห์ทางวิศวกรรมและการรับรองเฉพาะทาง", en: "Licensed engineer responsible for engineering analysis and formal certification work." },
  },
];

// ---------- 3 recruitment groups ----------
const groups = [
  {
    no: "01",
    title: { th: "ผู้ตรวจบ้านร่วมทีม", en: "Team Home Inspector" },
    role: { th: "ตรวจสอบหน้างาน เก็บภาพ บันทึกข้อบกพร่อง และจัดทำข้อมูลตามมาตรฐานของบริษัท", en: "Inspect on-site, photograph and record defects, and produce data to company standards." },
    reqs: {
      th: [
        "มีประสบการณ์งานก่อสร้าง ควบคุมงาน ตรวจบ้าน หรือระบบอาคารอย่างน้อย 2 ปี",
        "อ่านแบบก่อสร้างและเข้าใจระบบพื้นฐานของบ้านได้",
        "มีความละเอียด รอบคอบ และสื่อสารกับลูกค้าได้ดี",
        "สามารถใช้เครื่องมือตรวจพื้นฐานได้",
        "ใช้โทรศัพท์ แท็บเล็ต หรือระบบรายงานออนไลน์ได้",
        "มีรถยนต์หรือสามารถเดินทางไปตรวจหน้างานได้",
        "ยินดีผ่านการอบรมและทดสอบมาตรฐานของ WHAT THE HOUSE",
        "ไม่มีผลประโยชน์ทับซ้อนกับโครงการหรือผู้รับเหมา",
      ],
      en: [
        "At least 2 years in construction, site supervision, home inspection or building systems",
        "Able to read construction drawings and understand basic home systems",
        "Detail-oriented, thorough, and a good communicator with clients",
        "Able to use basic inspection tools",
        "Comfortable with phone, tablet or online reporting systems",
        "Own car, or able to travel to sites",
        "Willing to pass WHAT THE HOUSE training and standards testing",
        "No conflict of interest with projects or contractors",
      ],
    },
    note: { th: "ใบ กว. ไม่ใช่ข้อบังคับสำหรับกลุ่มนี้ — แต่ผู้ที่มีใบอนุญาตหรือใบรับรองที่เกี่ยวข้องจะได้รับการพิจารณาเป็นพิเศษ", en: "An engineering licence is not required for this group — holders of a relevant licence or certification receive special consideration." },
  },
  {
    no: "02",
    title: { th: "วิศวกรร่วมตรวจหรือรับรองงาน", en: "Co-inspecting / Certifying Engineer" },
    role: { th: "งานที่ต้องใช้การวิเคราะห์ทางวิศวกรรม การให้ความเห็นเฉพาะทาง หรือการลงนามรับรองในขอบเขตที่กฎหมายกำหนด", en: "Work requiring engineering analysis, specialist opinions, or formal sign-off within the scope defined by law." },
    reqs: {
      th: [
        "มีใบอนุญาตประกอบวิชาชีพวิศวกรรมควบคุม (กว.) ที่ยังไม่หมดอายุ",
        "ใบอนุญาตตรงกับสาขาและประเภทงานที่รับผิดชอบ",
        "แสดงเลขที่ใบอนุญาต ระดับ สาขา และวันหมดอายุได้",
        "ยินยอมให้บริษัทตรวจสอบสถานะใบอนุญาต",
        "มีประสบการณ์เกี่ยวกับอาคาร บ้านพักอาศัย หรืองานระบบที่เกี่ยวข้อง",
      ],
      en: [
        "Hold a valid (unexpired) professional engineering licence",
        "Licence matches the field and type of work you will be responsible for",
        "Able to provide licence number, level, field and expiry date",
        "Consent to the company verifying your licence status",
        "Experience with buildings, residential homes or related systems",
      ],
    },
    note: { th: "กลุ่มนี้ต้องมีใบ กว. เพราะเป็นบทบาทที่เกี่ยวข้องกับความรับผิดชอบทางวิชาชีพโดยตรง", en: "This group must hold an engineering licence — the role carries direct professional responsibility." },
  },
];
---
<BaseLayout
  title="ร่วมงานกับเรา | ผู้ตรวจบ้าน และวิศวกร | WHAT THE HOUSE"
  description="ร่วมทีม WHAT THE HOUSE — เปิดรับผู้ตรวจบ้าน และวิศวกรมีใบ กว. ดูคุณสมบัติแต่ละกลุ่มและสมัครออนไลน์ | Careers at WHAT THE HOUSE Chiang Mai"
>
  <Header />
  <main>

    <!-- ============ PAGE HERO ============ -->
    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/">หน้าแรก</a> / <span class="lang-th">ร่วมงานกับเรา</span><span class="lang-en">Careers</span></p>
        <span class="eyebrow"><span class="lang-th">ร่วมงานกับเรา</span><span class="lang-en">Careers</span></span>
        <h1><span class="lang-th">มาสร้างมาตรฐาน<br>การตรวจบ้านไปด้วยกัน</span><span class="lang-en">Build the standard of home inspection with us</span></h1>
        <p><span class="lang-th">เราเปิดรับทั้งผู้ตรวจบ้านและวิศวกร — ดูคุณสมบัติของแต่ละกลุ่มด้านล่าง แล้วสมัครออนไลน์ได้เลย</span><span class="lang-en block">We welcome home inspectors and engineers — check each group's qualifications below, then apply online.</span></p>
        <div class="btns" style="justify-content:center;margin-top:26px">
          <a class="btn btn-primary btn-lg" href="/careers/apply"><span class="lang-th">สมัครร่วมงาน</span><span class="lang-en">Apply now</span></a>
        </div>
      </div>
    </section>

    <!-- ============ WHY JOIN ============ -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">ทำไมต้องร่วมงานกับเรา</span><span class="lang-en">Why join us</span></span>
          <h2 class="section-title"><span class="lang-th">ทีมที่ให้คุณเติบโตจริง</span><span class="lang-en">A team you can grow with</span></h2>
        </div>
        <div class="grid grid-3">
          <div class="card"><div class="svc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4-9 4z"/><path d="M3 7v6l9 4 9-4V7"/></svg></div><h3><span class="lang-th">เทรนนิ่งเต็มระบบ</span><span class="lang-en">Full training</span></h3><p><span class="lang-th">เรียนรู้การใช้เครื่องมือเฉพาะทางและมาตรฐานการตรวจของบริษัท</span><span class="lang-en block">Learn our tools and inspection standards from the ground up.</span></p></div>
          <div class="card"><div class="svc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></div><h3><span class="lang-th">มาตรฐานเดียวกันทั้งทีม</span><span class="lang-en">One standard, whole team</span></h3><p><span class="lang-th">ทุกงานตรวจตามมาตรฐานเดียวกัน มีระบบรายงานและการตรวจสอบคุณภาพ</span><span class="lang-en block">Every job follows the same standard, with reporting and quality control.</span></p></div>
          <div class="card"><div class="svc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div><h3><span class="lang-th">เติบโตตามผลงาน</span><span class="lang-en">Grow by merit</span></h3><p><span class="lang-th">เส้นทางชัดเจนจาก Inspector สู่ Senior Inspector ตามความสามารถจริง</span><span class="lang-en block">A clear path from Inspector to Senior Inspector, based on real ability.</span></p></div>
        </div>
      </div>
    </section>

    <!-- ============ TEAM LEVELS ============ -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">โครงสร้างทีม</span><span class="lang-en">Team structure</span></span>
          <h2 class="section-title"><span class="lang-th">ทีมของเราแบ่งเป็น 3 ระดับ</span><span class="lang-en">Our team has 3 levels</span></h2>
        </div>
        <div class="lv-grid">
          {levels.map((l) => (
            <div class="lv-card">
              <span class="lv-tag">{l.tag}</span>
              <h3>{l.title.th}</h3>
              <p><span class="lang-th">{l.desc.th}</span><span class="lang-en block">{l.desc.en}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ RECRUITMENT GROUPS ============ -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">กลุ่มที่เปิดรับ</span><span class="lang-en">Who we're looking for</span></span>
          <h2 class="section-title"><span class="lang-th">เปิดรับร่วมงาน 2 กลุ่มหลัก</span><span class="lang-en">2 main groups we recruit</span></h2>
        </div>
        <div class="job-list">
          {groups.map((g) => (
            <div class="job">
              <div class="job-head">
                <h3><span class="gp-no">{g.no}</span><span class="lang-th">{g.title.th}</span><span class="lang-en">{g.title.en}</span></h3>
              </div>
              <p class="job-desc"><span class="lang-th">{g.role.th}</span><span class="lang-en block">{g.role.en}</span></p>
              <ul class="job-reqs">
                {g.reqs.th.map((r, i) => (
                  <li><span class="jr-ic">✓</span><span><span class="lang-th">{r}</span><span class="lang-en block">{g.reqs.en[i]}</span></span></li>
                ))}
              </ul>
              <p class="gp-note"><span class="lang-th">{g.note.th}</span><span class="lang-en block">{g.note.en}</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ APPLY CTA ============ -->
    <section class="section soft">
      <div class="container">
        <div class="cta-band">
          <h2><span class="lang-th">พร้อมร่วมทีมแล้ว?</span><span class="lang-en">Ready to join?</span></h2>
          <p><span class="lang-th">สมัครใน 2 ขั้นตอน — ประเมินคุณสมบัติเบื้องต้น (ไม่ถึง 2 นาที) แล้วกรอกใบสมัครฉบับเต็ม หรือทักมาสอบถามก่อนได้</span><span class="lang-en block">Apply in 2 steps — a quick pre-qualification (under 2 minutes), then the full application. Or message us with questions first.</span></p>
          <div class="btns">
            <a class="btn btn-primary btn-lg" href="/careers/apply"><span class="lang-th">เริ่มสมัครเลย</span><span class="lang-en">Start applying</span></a>
            <a class="btn btn-ghost btn-lg" href={settings.lineUrl} target="_blank" rel="noopener"><span class="lang-th">สอบถามทาง LINE</span><span class="lang-en">Ask on LINE</span></a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* ---------- team levels ---------- */
.lv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.lv-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; position: relative; }
.lv-tag { font-family: var(--mono); font-size: .66rem; letter-spacing: .16em; color: var(--green-bright); border: 1px solid rgba(47,224,124,.3); border-radius: 50px; padding: 4px 12px; display: inline-block; margin-bottom: 14px; }
.lv-card h3 { font-size: 1.15rem; margin: 0 0 8px; }
.lv-card p { margin: 0; color: var(--grey); font-size: .9rem; line-height: 1.7; }

/* ---------- recruitment groups ---------- */
.job-list { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
.job { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
.job-head h3 { font-size: 1.2rem; margin: 0 0 4px; letter-spacing: -.02em; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.gp-no { font-family: var(--mono); font-size: .78rem; color: var(--green-bright); border: 1px solid rgba(47,224,124,.3); border-radius: 8px; padding: 3px 9px; }
.job-desc { color: var(--grey); font-size: .95rem; margin: 6px 0 18px; }
.job-reqs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 24px; }
.job-reqs li { display: flex; gap: 10px; align-items: flex-start; font-size: .9rem; color: var(--body); }
.jr-ic { width: 20px; height: 20px; flex: none; border-radius: 6px; background: var(--green-soft); color: var(--green-bright); display: grid; place-items: center; font-size: .68rem; font-weight: 700; margin-top: 2px; }
.gp-note { margin: 18px 0 0; padding: 12px 16px; border-radius: var(--radius-sm); background: var(--green-soft); border: 1px solid rgba(47,224,124,.2); color: var(--body); font-size: .88rem; }

@media (max-width: 900px) { .lv-grid { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .job-reqs { grid-template-columns: 1fr; } }
</style>
