---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import settings from '../data/settings.json';

const positions = [
  {
    title: { th: "ช่างตรวจบ้าน (Home Inspector)", en: "Home Inspector" },
    type: { th: "เต็มเวลา", en: "Full-time" },
    loc: { th: "เชียงใหม่", en: "Chiang Mai" },
    desc: { th: "ลงตรวจบ้านและคอนโดหน้างาน ใช้เครื่องมือเฉพาะทาง จัดทำรายงานพร้อมภาพถ่าย", en: "Inspect homes and condos on-site using specialized tools and produce photo reports." },
    reqs: {
      th: ["มีพื้นฐานงานก่อสร้าง ไฟฟ้า ประปา หรือวิศวกรรม", "ละเอียด รอบคอบ ช่างสังเกต", "สื่อสารกับลูกค้าได้ดี อธิบายเข้าใจง่าย", "มีรถยนต์ส่วนตัว (พิจารณาพิเศษ)"],
      en: ["Background in construction, electrical, plumbing or engineering", "Detail-oriented and observant", "Good communication with clients", "Own vehicle (a plus)"],
    },
  },
  {
    title: { th: "วิศวกรควบคุมงาน (Site Engineer)", en: "Site / Supervision Engineer" },
    type: { th: "เต็มเวลา", en: "Full-time" },
    loc: { th: "เชียงใหม่และภาคเหนือ", en: "Chiang Mai & North" },
    desc: { th: "ควบคุมและตรวจสอบคุณภาพงานก่อสร้างตามงวด จัดทำรายงานความคืบหน้า", en: "Supervise and quality-check construction by milestone and report progress." },
    reqs: {
      th: ["วุฒิ ปวส.–ปริญญาตรี สาขาวิศวกรรมโยธา/ก่อสร้าง", "อ่านแบบก่อสร้างและ BOQ ได้", "มีประสบการณ์คุมงานจะพิจารณาพิเศษ"],
      en: ["Diploma–Bachelor in civil/construction engineering", "Able to read drawings and BOQ", "Supervision experience is a plus"],
    },
  },
  {
    title: { th: "ผู้ประสานงานลูกค้า (Client Coordinator)", en: "Client Coordinator" },
    type: { th: "เต็มเวลา", en: "Full-time" },
    loc: { th: "เชียงใหม่", en: "Chiang Mai" },
    desc: { th: "ดูแลการจองคิว ตอบลูกค้าทาง LINE/โทรศัพท์ ประสานงานทีมช่างและจัดตารางงาน", en: "Manage bookings, reply to clients on LINE/phone, and coordinate the inspection team." },
    reqs: {
      th: ["รักงานบริการ ตอบลูกค้าไว สุภาพ", "ใช้คอมพิวเตอร์และแอปพื้นฐานได้ดี", "จัดการงานหลายอย่างพร้อมกันได้"],
      en: ["Service-minded, prompt and polite", "Comfortable with computers and basic apps", "Able to multitask"],
    },
  },
];
---
<BaseLayout
  title="ร่วมงานกับเรา | สมัครงาน WHAT THE HOUSE – Home Inspection Chiang Mai"
  description="ร่วมเป็นส่วนหนึ่งของทีมตรวจบ้านมืออาชีพ WHAT THE HOUSE เชียงใหม่ เปิดรับช่างตรวจบ้าน วิศวกรควบคุมงาน และผู้ประสานงานลูกค้า | Careers at WHAT THE HOUSE"
>
  <Header />
  <main>

    <!-- PAGE HERO -->
    <section class="page-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/">หน้าแรก</a> / <span class="lang-th">ร่วมงานกับเรา</span><span class="lang-en">Careers</span></p>
        <span class="eyebrow"><span class="lang-th">ร่วมงานกับเรา</span><span class="lang-en">Careers</span></span>
        <h1><span class="lang-th">มาสร้างมาตรฐาน<br>การตรวจบ้านไปด้วยกัน</span><span class="lang-en">Build the standard of home inspection with us</span></h1>
        <p><span class="lang-th">เราตรวจบ้านเป็น "อาชีพหลัก ไม่ใช่งานเสริม" ถ้าคุณละเอียด ใส่ใจ และอยากเติบโตไปกับทีมมืออาชีพ เรายินดีต้อนรับ</span><span class="lang-en block">Inspection is our full-time profession. If you're detail-driven and want to grow with a professional team, we'd love to hear from you.</span></p>
      </div>
    </section>

    <!-- WHY JOIN -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">ทำไมต้องร่วมงานกับเรา</span><span class="lang-en">Why join us</span></span>
          <h2 class="section-title"><span class="lang-th">ทีมที่ให้คุณเติบโตจริง</span><span class="lang-en">A team you can grow with</span></h2>
        </div>
        <div class="grid grid-3">
          <div class="card"><div class="svc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4-9 4z"/><path d="M3 7v6l9 4 9-4V7"/></svg></div><h3><span class="lang-th">เทรนนิ่งเต็มระบบ</span><span class="lang-en">Full training</span></h3><p><span class="lang-th">เรียนรู้การใช้เครื่องมือเฉพาะทางและมาตรฐานการตรวจของบริษัท</span><span class="lang-en block">Learn our tools and inspection standards from the ground up.</span></p></div>
          <div class="card"><div class="svc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></div><h3><span class="lang-th">งานมั่นคง เป็นทีม</span><span class="lang-en">Stable, team-based</span></h3><p><span class="lang-th">ทุกคนเป็นพนักงานของบริษัท ไม่ใช่ระบบซับงาน ทำงานเป็นทีมจริง</span><span class="lang-en block">Everyone is a real employee — no subcontracting, real teamwork.</span></p></div>
          <div class="card"><div class="svc-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div><h3><span class="lang-th">เติบโตตามผลงาน</span><span class="lang-en">Grow by merit</span></h3><p><span class="lang-th">พัฒนาทักษะและก้าวหน้าตามความสามารถ ไม่ใช่ตามอายุงานอย่างเดียว</span><span class="lang-en block">Advance on skill and results, not just seniority.</span></p></div>
        </div>
      </div>
    </section>

    <!-- OPEN POSITIONS -->
    <section class="section soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="lang-th">ตำแหน่งที่เปิดรับ</span><span class="lang-en">Open positions</span></span>
          <h2 class="section-title"><span class="lang-th">ตำแหน่งงานว่าง</span><span class="lang-en">We're hiring</span></h2>
        </div>
        <div class="job-list">
          {positions.map((p) => (
            <div class="job">
              <div class="job-head">
                <h3><span class="lang-th">{p.title.th}</span><span class="lang-en">{p.title.en}</span></h3>
                <div class="job-tags">
                  <span class="job-tag"><span class="lang-th">{p.type.th}</span><span class="lang-en">{p.type.en}</span></span>
                  <span class="job-tag"><span class="lang-th">{p.loc.th}</span><span class="lang-en">{p.loc.en}</span></span>
                </div>
              </div>
              <p class="job-desc"><span class="lang-th">{p.desc.th}</span><span class="lang-en block">{p.desc.en}</span></p>
              <ul class="job-reqs">
                {p.reqs.th.map((r, i) => (
                  <li><span class="jr-ic">✓</span><span><span class="lang-th">{r}</span><span class="lang-en block">{p.reqs.en[i]}</span></span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="job-open"><span class="lang-th">ไม่เห็นตำแหน่งที่ใช่? ส่งประวัติมาได้เลย เราพิจารณาคนเก่งเสมอ</span><span class="lang-en block">Don't see your role? Send your CV anyway — we always welcome great people.</span></p>
      </div>
    </section>

    <!-- HOW TO APPLY -->
    <section class="section">
      <div class="container">
        <div class="cta-band">
          <h2><span class="lang-th">สนใจร่วมงาน?</span><span class="lang-en">Interested in joining?</span></h2>
          <p><span class="lang-th">ส่งประวัติย่อ (Resume) พร้อมตำแหน่งที่สนใจมาที่อีเมล หรือทักหาเราทาง LINE ได้เลย</span><span class="lang-en block">Send your resume and the role you want by email, or reach us on LINE.</span></p>
          <div class="btns">
            <a class="btn btn-primary btn-lg" href={`mailto:${settings.email}?subject=สมัครงาน WHAT THE HOUSE`}><span class="lang-th">ส่งใบสมัครทางอีเมล</span><span class="lang-en">Apply by Email</span></a>
            <a class="btn btn-outline btn-lg" href={settings.lineUrl} target="_blank" rel="noopener"><span class="lang-th">ทักทาง LINE</span><span class="lang-en">Chat on LINE</span></a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
.job-list { max-width: 860px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
.job { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; transition: .2s; }
.job:hover { border-color: var(--line-2); }
.job-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
.job-head h3 { font-size: 1.2rem; margin: 0; letter-spacing: -.02em; }
.job-tags { display: flex; gap: 8px; flex-wrap: wrap; }
.job-tag { font-family: var(--mono); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; color: var(--body); border: 1px solid var(--line-2); border-radius: 50px; padding: 5px 12px; white-space: nowrap; }
.job-desc { color: var(--grey); font-size: .96rem; margin: 0 0 18px; }
.job-reqs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; }
.job-reqs li { display: flex; gap: 10px; align-items: flex-start; font-size: .9rem; color: var(--body); }
.jr-ic { width: 20px; height: 20px; flex: none; border-radius: 6px; background: var(--green-soft); color: var(--green-bright); display: grid; place-items: center; font-size: .68rem; font-weight: 700; margin-top: 2px; }
.job-open { text-align: center; margin: 32px 0 0; color: var(--grey); font-size: .95rem; }
@media (max-width: 640px) { .job-reqs { grid-template-columns: 1fr; } }
</style>
