---
import settings from '../data/settings.json';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/">
          <img src="/assets/img/logo.jpg" class="logo" alt="What The House" />
          <span class="brand-text">
            <b>WHAT THE HOUSE</b>
            <span>HOME INSPECTIONS</span>
          </span>
        </a>
        <p><span class="lang-th">บริการตรวจบ้านและคอนโดมืออาชีพ ตรวจละเอียด เป็นกลาง ช่วยให้คุณรับมอบบ้านได้อย่างมั่นใจ</span><span class="lang-en block">Professional, independent home &amp; condo inspection — so you can accept your home with confidence.</span></p>
        <div class="foot-social">
          <a href={settings.lineUrl} target="_blank" rel="noopener" aria-label="LINE" title="LINE">
            <svg viewBox="0 0 24 24" width="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.01 2 11c0 3.53 2.1 6.6 5.24 8.29-.07.63-.48 2.4-.55 2.76-.09.48.18.47.37.34.15-.1 2.4-1.59 3.37-2.24.51.07 1.03.11 1.57.11 5.52 0 10-4.01 10-9S17.52 2 12 2z"/></svg>
          </a>
          <a href={settings.facebookUrl} target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
            <svg viewBox="0 0 24 24" width="20" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>

      <div class="foot-col">
        <h5><span class="lang-th">เมนู</span><span class="lang-en">Menu</span></h5>
        <ul>
          <li><a href="/about"><span class="lang-th">เกี่ยวกับเรา</span><span class="lang-en">About</span></a></li>
          <li><a href="/services"><span class="lang-th">บริการ</span><span class="lang-en">Services</span></a></li>
          <li><a href="/pricing"><span class="lang-th">ค่าบริการ</span><span class="lang-en">Pricing</span></a></li>
          <li><a href="/portfolio"><span class="lang-th">ผลงาน</span><span class="lang-en">Portfolio</span></a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h5><span class="lang-th">ข้อมูล</span><span class="lang-en">Info</span></h5>
        <ul>
          <li><a href="/blog"><span class="lang-th">บทความ</span><span class="lang-en">Blog</span></a></li>
          <li><a href="/faq"><span class="lang-th">คำถามที่พบบ่อย</span><span class="lang-en">FAQ</span></a></li>
          <li><a href="/btu-calculator"><span class="lang-th">คำนวณแอร์ (BTU)</span><span class="lang-en">BTU Calculator</span></a></li>
          <li><a href="/careers"><span class="lang-th">ร่วมงานกับเรา</span><span class="lang-en">Careers</span></a></li>
          <li><a href="/contact"><span class="lang-th">ติดต่อเรา</span><span class="lang-en">Contact</span></a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h5><span class="lang-th">ติดต่อ</span><span class="lang-en">Contact</span></h5>
        <ul>
          <li><a href={`tel:${settings.phone}`}><span class="lang-th">โทร: {settings.phoneDisplay}</span><span class="lang-en">Tel: {settings.phoneDisplay}</span></a></li>
          <li><a href={settings.lineUrl} target="_blank" rel="noopener">LINE: {settings.lineId}</a></li>
          <li><a href={settings.facebookUrl} target="_blank" rel="noopener">Facebook: {settings.facebookDisplay}</a></li>
          <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} WHAT THE HOUSE – Home Inspections. <span class="lang-th">สงวนลิขสิทธิ์</span><span class="lang-en">All rights reserved.</span></span>
      <span>Trusted • Professional • Detailed</span>
    </div>
  </div>
</footer>

<!-- Floating contact -->
<div class="float-contact">
  <a href={settings.lineUrl} target="_blank" rel="noopener" class="fc-line" aria-label="LINE" title="LINE">
    <svg viewBox="0 0 24 24" width="22" fill="currentColor"><path d="M12 2C6.48 2 2 6.01 2 11c0 3.53 2.1 6.6 5.24 8.29-.07.63-.48 2.4-.55 2.76-.09.48.18.47.37.34.15-.1 2.4-1.59 3.37-2.24.51.07 1.03.11 1.57.11 5.52 0 10-4.01 10-9S17.52 2 12 2z"/></svg>
  </a>
  <a href="https://m.me/WhatTheHouse.Official" target="_blank" rel="noopener" class="fc-msg" aria-label="Facebook Messenger" title="Facebook Messenger">
    <svg viewBox="0 0 24 24" width="22" fill="currentColor"><path d="M12 2C6.48 2 2 6.13 2 11.7c0 2.96 1.34 5.62 3.5 7.46V22l3.2-1.76c.86.24 1.78.37 2.74.37 5.52 0 10-4.13 10-9.91S17.52 2 12 2zm1.05 13.34-2.55-2.72-4.98 2.72 5.48-5.81 2.61 2.72 4.92-2.72-5.48 5.81z"/></svg>
  </a>
  <a href={`tel:${settings.phone}`} class="fc-call" aria-label="โทร" title="โทรศัพท์">
    <svg viewBox="0 0 24 24" width="22" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2H7a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9z"/></svg>
  </a>
</div>
